<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MassiveSlicer.Core\MassiveSlicer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meshoptimizer.NET" Version="1.0.7" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <!-- STEP import uses open-source cascadio (Python) on all platforms. Occt.NET was
       removed: its license MessageBox garbles on non-CJK locales and was crashing the host. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Loading\StepLoader.NonWindows.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Loading\StepLoader.cs" />
  </ItemGroup>
  <!-- Legacy Occt.NET helpers — kept on disk for reference, not compiled. -->
  <ItemGroup>
    <Compile Remove="Loading\OcctBootstrap.cs" />
    <Compile Remove="Loading\OcctUiSuppressor.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

</Project>
