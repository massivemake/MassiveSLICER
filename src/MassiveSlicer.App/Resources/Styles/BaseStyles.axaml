    <Style Selector="Button.PrimaryButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>
    <Style Selector="Button.PrimaryButton:pressed">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Shader sphere button — circular button whose Background IS the sphere preview.
         No content text; a 2px border ring shows hover/active state. -->
    <Style Selector="Button.ShaderSphereBtn">
        <Setter Property="Width"           Value="44"/>
        <Setter Property="Height"          Value="44"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="CornerRadius"    Value="22"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ShaderSphereBtn:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Border2}"/>
    </Style>
    <Style Selector="Button.ShaderSphereBtn.active">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Nav preset button (Preferences window) -->
    <Style Selector="Button.NavPresetBtn">
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Padding"      Value="10,7"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="Button.NavPresetBtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg4}"/>
    </Style>
    <Style Selector="Button.NavPresetBtn:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentMuted}"/>
    </Style>

    <!-- ── TextBox ────────────────────────────────────────────────────────── -->
    <!-- FULL template. SimpleTheme ControlTheme paints ThemeBorderHigh (Cosmic
         purple / OS accent) onto Border#border on hover+focus. Style setters
         cannot beat that, and a custom template still loses if the part is
         still named "border". Chrome is fieldChrome so those selectors miss. -->
    <Style Selector="TextBox">
        <Setter Property="Background"      Value="#E62a2a2a"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="#3a3a3a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="5"/>
        <Setter Property="Padding"         Value="8,4"/>
        <Setter Property="CaretBrush"      Value="#71a72a"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource AccentMuted}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="fieldChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel Margin="{TemplateBinding Padding}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <DataValidationErrors>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding InnerLeftContent}"/>
                                <ScrollViewer Name="PART_ScrollViewer"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                              AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}">
                                    <Panel>
                                        <TextBlock Name="placeholder"
                                                   Foreground="{TemplateBinding PlaceholderForeground}"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                   Text="{TemplateBinding PlaceholderText}"
                                                   IsHitTestVisible="False"
                                                   IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        <TextPresenter Name="PART_TextPresenter"
                                                       CaretBrush="{TemplateBinding CaretBrush}"
                                                       CaretIndex="{TemplateBinding CaretIndex}"
                                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                                       SelectionStart="{TemplateBinding SelectionStart}"
                                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                                       TextAlignment="{TemplateBinding TextAlignment}"
                                                       TextWrapping="{TemplateBinding TextWrapping}"/>
                                    </Panel>
                                </ScrollViewer>
                                <ContentPresenter Grid.Column="2"
                                                  Content="{TemplateBinding InnerRightContent}"/>
                            </Grid>
                        </DataValidationErrors>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="TextBox:focus-within /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="TextBox.PanelTextBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize"  Value="12"/>
        <Setter Property="Padding"   Value="8,4"/>
    </Style>

    <!-- NumericUpDown chrome lives on ButtonSpinner#border (SimpleTheme).
         Same rename so hover is lime, not ThemeBorderHigh purple. -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background"      Value="#E62a2a2a"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="#3a3a3a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="5"/>
        <Setter Property="MinHeight"       Value="26"/>
    </Style>
    <Style Selector="NumericUpDown:pointerover">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="NumericUpDown:focus">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="ButtonSpinner">
        <Setter Property="Background"      Value="#E62a2a2a"/>
        <Setter Property="BorderBrush"     Value="#3a3a3a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="5"/>
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Border Name="fieldChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <DockPanel>
                            <UniformGrid Name="PART_SpinnerPanel"
                                         DockPanel.Dock="Right"
                                         Rows="2"
                                         IsVisible="{TemplateBinding ShowButtonSpinner}">
                                <RepeatButton Name="PART_IncreaseButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <Path Width="8" Height="4"
                                          Data="M0,5 L4.5,.5 9,5 6,5 4.5,3.5 3,5 z"
                                          Fill="#acacac"
                                          Stretch="Uniform"/>
                                </RepeatButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <Path Width="8" Height="4"
                                          Data="M0,0 L3,0 4.5,1.5 6,0 9,0 4.5,4.5 z"
                                          Fill="#acacac"
                                          Stretch="Uniform"/>
                                </RepeatButton>
                            </UniformGrid>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </DockPanel>
                    </Border>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ButtonSpinner:pointerover /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="ButtonSpinner:focus /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="ButtonSpinner:focus-within /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>

    <!-- Panel sliders: compact lime track + round thumb -->
    <Style Selector="Slider:not(.ScrubSlider):not(.Lfam3SeqScrub)">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Margin"    Value="0,2"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid MinHeight="22">
                    <Border Name="TrackBg"
                            Height="6"
                            VerticalAlignment="Center"
                            Margin="8,0"
                            Background="#E61a1a1a"
                            CornerRadius="3"
                            BorderBrush="#2e2e2e"
                            BorderThickness="1"/>
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                           Orientation="Horizontal"
                           Margin="8,0">
                        <Track.DecreaseButton>
                            <RepeatButton Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Height="6"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Accent}"
                                                CornerRadius="3"
                                                Opacity="0.95"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent" Height="6"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb Width="14" Height="14" Focusable="False" Cursor="Hand">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Ellipse Width="14" Height="14"
                                                 Fill="{DynamicResource Accent}"
                                                 Stroke="#1b1b1b"
                                                 StrokeThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider:not(.ScrubSlider):not(.Lfam3SeqScrub):pointerover /template/ Ellipse">
        <Setter Property="Fill" Value="{DynamicResource AccentHover}"/>
    </Style>

    <!-- ── ComboBox ───────────────────────────────────────────────────────── -->
    <!-- Theme= assigns our ControlTheme. A Style Template cannot beat SimpleTheme. -->
    <Style Selector="ComboBox">
        <Setter Property="Theme" Value="{StaticResource MassiveComboBoxTheme}"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Theme" Value="{StaticResource MassiveComboBoxItemTheme}"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- ── CheckBox ───────────────────────────────────────────────────────── -->
    <!-- Set on CheckBox itself so {TemplateBinding} picks up the values -->
    <Style Selector="CheckBox">
        <Setter Property="Background"      Value="#2a2a2a"/>
        <Setter Property="BorderBrush"     Value="#4a4a4a"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius"    Value="6"/>
    </Style>
    <!-- StyleTrigger priority overrides the ControlTheme's pointerover setter -->
    <Style Selector="CheckBox:pointerover /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#border">
        <Setter Property="Background"  Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ── ToggleSwitch (glass kit on/off — theme colors, keep default parts) ─ -->
    <Style Selector="ToggleSwitch">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor"    Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <!-- Track off -->
    <Style Selector="ToggleSwitch /template/ Border#SwitchBackground">
        <Setter Property="Background"  Value="#2a2a2a"/>
        <Setter Property="BorderBrush" Value="#3a3a3a"/>
        <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#OuterBorder">
        <Setter Property="Background"  Value="#2a2a2a"/>
        <Setter Property="BorderBrush" Value="#3a3a3a"/>
        <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <!-- Track on -->
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchBackground">
        <Setter Property="Background"  Value="#3a5716"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#OuterBorder">
        <Setter Property="Background"  Value="#3a5716"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <!-- Knob -->
    <Style Selector="ToggleSwitch /template/ Border#SwitchKnob">
        <Setter Property="Background" Value="#6a6a6a"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnob">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ToggleSwitch /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="#6a6a6a"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
        <Setter Property="BorderBrush" Value="#71a72a88"/>
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchBackground">
        <Setter Property="BorderBrush" Value="#71a72a88"/>
    </Style>

    <!-- ── ToolTip ────────────────────────────────────────────────────────── -->
    <Style Selector="ToolTip">
        <Setter Property="Background"      Value="{DynamicResource Bg3}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Border2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="6,4"/>
        <Setter Property="FontSize"        Value="11"/>
    </Style>

    <!-- ── ColorPicker ──────────────────────────────────────────────────────── -->
    <!-- ColorPicker is a DropDownButton wrapping a color swatch + flyout ColorView. -->
    <Style Selector="ColorPicker">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Height"       Value="28"/>
    </Style>
    <!-- Theme the outer DropDownButton to match Obsidian palette -->
    <Style Selector="ColorPicker /template/ DropDownButton">
        <Setter Property="Background"      Value="{DynamicResource Bg3}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Border2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
    </Style>
    <!-- Target the inner Border that actually renders the button chrome -->
    <Style Selector="ColorPicker /template/ DropDownButton /template/ Border#border">
        <Setter Property="Background"  Value="{DynamicResource Bg3}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border2}"/>
    </Style>
    <Style Selector="ColorPicker /template/ DropDownButton:pointerover /template/ Border#border">
        <Setter Property="Background"  Value="{DynamicResource Bg4}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="ColorPicker /template/ DropDownButton:pressed /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource AccentMuted}"/>
    </Style>

    <!-- ── Scrubber label input ─────────────────────────────────────────────── -->
    <!-- Inline move-number input in the floating scrubber label.
         Invisible until hovered/focused so it reads as a normal label at a glance. -->
    <Style Selector="TextBox.ScrubInput">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderBrush"                Value="Transparent"/>
        <Setter Property="BorderThickness"            Value="0,0,0,1"/>
        <Setter Property="Padding"                    Value="2,0"/>
        <Setter Property="FontSize"                   Value="10"/>
        <Setter Property="FontFamily"                 Value="Consolas, Courier New, monospace"/>
        <Setter Property="Foreground"                 Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush"                 Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush"             Value="{DynamicResource AccentMuted}"/>
        <Setter Property="Width"                      Value="36"/>
        <Setter Property="MinWidth"                   Value="0"/>
        <Setter Property="MinHeight"                  Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
    </Style>
    <!-- Template-level override: keep the inner border transparent by default -->
    <Style Selector="TextBox.ScrubInput /template/ Border#fieldChrome">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBox.ScrubInput:pointerover /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>
    <Style Selector="TextBox.ScrubInput:focus-within /template/ Border#fieldChrome">
        <Setter Property="BorderBrush" Value="#71a72a"/>
    </Style>

    <!-- ── Collapsible section expander (nested under StepCard) ─────────────── -->
    <!-- No stroke on expanded body — fill color only (no lime border). -->
    <Style Selector="Expander.SectionExpander">
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="Margin"                     Value="6,4,6,4"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#E62a2a2a"
                        BorderThickness="0"
                        CornerRadius="5"
                        ClipToBounds="True"
                        b:CornerClip.Enable="True">
                    <StackPanel>
                        <ToggleButton Name="HeaderToggle"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="10,8"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid ColumnDefinitions="*,14">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Header}"
                                                  Foreground="{DynamicResource TextSecondary}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Name="Chevron"
                                           Grid.Column="1"
                                           Text="›"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           RenderTransformOrigin="50%,50%"/>
                            </Grid>
                        </ToggleButton>
                        <Border Name="ExpandedBody"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0,0,5,5"
                                Margin="4,0,4,4"
                                IsVisible="{Binding #HeaderToggle.IsChecked}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="6,4,6,6"/>
                        </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- PRESETS (and any TightPad section): 2px left/right only — no extra
         ExpandedBody / ContentPresenter inset on top of the content stack. -->
    <Style Selector="Expander.SectionExpander.TightPad /template/ Border#ExpandedBody">
        <Setter Property="Margin" Value="2,0,2,2"/>
    </Style>
    <Style Selector="Expander.SectionExpander.TightPad /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- Floating: macOS-style overlay scrolling — the scrollbar floats over the
         content's right edge instead of reserving layout space, so floating cards
         keep their width when it appears. Fully retemplated: rounded translucent
         thumb, no track, no arrows. -->
    <Style Selector="ScrollViewer.Floating">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Background="{TemplateBinding Background}"
                                            Margin="{TemplateBinding Padding}"
                                            Content="{TemplateBinding Content}"
                                            Offset="{TemplateBinding Offset, Mode=TwoWay}"
                                            CanHorizontallyScroll="False"
                                            CanVerticallyScroll="True">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="False"
                                                     CanVerticallyScroll="True"/>
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar Name="PART_VerticalScrollBar"
                               Orientation="Vertical"
                               HorizontalAlignment="Right"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollViewer.Floating /template/ ScrollBar#PART_VerticalScrollBar">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="1,2,0,2">
                    <Track Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="Vertical"
                           IsDirectionReversed="True">
                        <Track.DecreaseButton>
                            <RepeatButton Opacity="0" Focusable="False" MinWidth="0" MinHeight="0"
                                          Padding="0" BorderThickness="0" Background="Transparent"/>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Opacity="0" Focusable="False" MinWidth="0" MinHeight="0"
                                          Padding="0" BorderThickness="0" Background="Transparent"/>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb MinHeight="44">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="#4D000000" CornerRadius="4"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollViewer.Floating /template/ ScrollBar#PART_VerticalScrollBar:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- ViewPill: viewport view-mode selector (Body / Toolpath / Speed / RPM / Preview) -->
    <Style Selector="Button.ViewPill">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.ViewPill:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.ViewPill.active">
        <Setter Property="Background" Value="#33409640"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
    </Style>

    <!-- ExportCta: green call-to-action in the top bar -->
    <Style Selector="Button.ExportCta">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style Selector="Button.ExportCta:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    </Style>
    <Style Selector="Button.ExportCta:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- RealtimePause: top-bar toggle that holds off realtime re-slicing.
         Light green while live; amber while paused so the held state is obvious. -->
    <Style Selector="ToggleButton.RealtimePause">
        <Setter Property="Background" Value="#7ed87e"/>
        <Setter Property="Foreground" Value="#242424"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="ToggleButton.RealtimePause /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="#242424"/>
    </Style>
    <Style Selector="ToggleButton.RealtimePause:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#93e493"/>
        <Setter Property="TextElement.Foreground" Value="#242424"/>
    </Style>
    <Style Selector="ToggleButton.RealtimePause:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="#d99a2b"/>
        <Setter Property="TextElement.Foreground" Value="#242424"/>
    </Style>
    <Style Selector="ToggleButton.RealtimePause:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#e8ab3c"/>
        <Setter Property="TextElement.Foreground" Value="#242424"/>
    </Style>

    <!-- FlashTarget: attention guide — green border fades in on .flash, out on removal -->
    <Style Selector="Border.FlashTarget">
        <Setter Property="BorderBrush" Value="#0071a72a"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.9"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.FlashTarget.flash">
        <Setter Property="BorderBrush" Value="#FF71a72a"/>
    </Style>

    <!-- PieButton: Ctrl+Space view pie menu entries -->
    <Style Selector="Button.PieButton">
        <Setter Property="Background" Value="#E63a5716"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.PieButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="#111111"/>
    </Style>

    <!-- PatternTile: effector pattern-grid tile -->
    <Style Selector="Button.PatternTile">
        <Setter Property="Background" Value="#2e2e2e"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    </Style>
    <Style Selector="Button.PatternTile:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border2}"/>
    </Style>
    <Style Selector="Button.PatternTile.active">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="#243810"/>
    </Style>


    <!-- Nested wells inside glass cards — same 90% alpha family as StepCard -->
    <Style Selector="Border.GlassInset">
        <Setter Property="Background"      Value="#E62b2b2b"/>
        <Setter Property="BorderBrush"     Value="#454545"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="5"/>
    </Style>

    <!-- StepCard on Button (e.g. EXIT EDIT MODE): same chrome as Expander.StepCard. -->
    <Style Selector="Button.StepCard">
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background"                 Value="#E61e1e1e"/>
        <Setter Property="BorderBrush"                Value="#323232"/>
        <Setter Property="BorderThickness"            Value="1"/>
        <Setter Property="CornerRadius"               Value="5"/>
        <Setter Property="Padding"                    Value="8,8"/>
        <Setter Property="Margin"                     Value="0,0,0,6"/>
        <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.StepCard:pointerover">
        <Setter Property="Background"  Value="#E6262626"/>
        <Setter Property="BorderBrush" Value="#71a72a66"/>
    </Style>
    <!-- BACK TO STEPS (Scan/Mill): same StepCard shape, slightly darker so it reads as chrome
         / navigation rather than another workflow step card. -->
    <Style Selector="Button.StepCard.BackToSteps">
        <Setter Property="Background"  Value="#E6161616"/>
        <Setter Property="BorderBrush" Value="#2a2a2a"/>
        <Setter Property="Opacity"     Value="0.95"/>
    </Style>
    <Style Selector="Button.StepCard.BackToSteps:pointerover">
        <Setter Property="Background"  Value="#E6202020"/>
        <Setter Property="BorderBrush" Value="#3a3a3a"/>
        <Setter Property="Opacity"     Value="1"/>
    </Style>

    <!-- StepCard: one translucent shell only (90% alpha). Expanded body is
         transparent so OUTLINER / IMPORT / ROBOT CELL all ghost the same —
         a second dark body layer was stacking and looking solid. -->
    <Style Selector="Expander.StepCard">
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#E61e1e1e"
                        BorderBrush="#323232"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,6"
                        ClipToBounds="True"
                        b:CornerClip.Enable="True">
                    <StackPanel>
                        <ToggleButton Name="HeaderToggle"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="8,8"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid ColumnDefinitions="*,14">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Header}"
                                                  Foreground="{DynamicResource TextSecondary}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Name="Chevron"
                                           Grid.Column="1"
                                           Text="›"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           RenderTransformOrigin="50%,50%"/>
                            </Grid>
                        </ToggleButton>
                        <Border Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding #HeaderToggle.IsChecked}"
                                Padding="2,4,2,6">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Expander.StepCard /template/ TextBlock#Chevron">
        <Setter Property="RenderTransform"><RotateTransform Angle="90"/></Setter>
    </Style>
    <Style Selector="Expander.StepCard[IsExpanded=False] /template/ TextBlock#Chevron">
        <Setter Property="RenderTransform"><RotateTransform Angle="0"/></Setter>
    </Style>
    <Style Selector="Expander.StepCard /template/ ToggleButton#HeaderToggle /template/ Border">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="5"/>
    </Style>
    <Style Selector="Expander.StepCard[IsExpanded=True] /template/ ToggleButton#HeaderToggle /template/ Border">
        <Setter Property="CornerRadius" Value="5,5,0,0"/>
    </Style>
    <Style Selector="Expander.StepCard /template/ ToggleButton#HeaderToggle:pointerover /template/ Border">
        <Setter Property="Background" Value="#E6262626"/>
    </Style>
    <Style Selector="Expander.StepCard /template/ ToggleButton#HeaderToggle:pressed /template/ Border">
        <Setter Property="Background" Value="#E63a5716"/>
    </Style>
    <Style Selector="Expander.StepCard /template/ ToggleButton#HeaderToggle:pointerover TextBlock#Chevron">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- StepCard.PresetsCard: same single-shell glass, green border -->
    <Style Selector="Expander.StepCard.PresetsCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#E61e1e1e"
                        BorderBrush="{DynamicResource ColorSuccess}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="0,0,0,6"
                        ClipToBounds="True"
                        b:CornerClip.Enable="True">
                    <StackPanel>
                        <ToggleButton Name="HeaderToggle"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="8,8"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid ColumnDefinitions="*,14">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Header}"
                                                  Foreground="{DynamicResource TextSecondary}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Name="Chevron"
                                           Grid.Column="1"
                                           Text="›"
                                           Foreground="{DynamicResource ColorSuccess}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           RenderTransformOrigin="50%,50%"/>
                            </Grid>
                        </ToggleButton>
                        <Border Background="Transparent"
                                BorderThickness="0"
                                IsVisible="{Binding #HeaderToggle.IsChecked}"
                                Padding="2,4,2,6">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Chevron: right (0°) when collapsed, down (90°) when expanded -->
    <Style Selector="Expander.SectionExpander /template/ TextBlock#Chevron">
        <Setter Property="RenderTransform"><RotateTransform Angle="90"/></Setter>
    </Style>
    <Style Selector="Expander.SectionExpander[IsExpanded=False] /template/ TextBlock#Chevron">
        <Setter Property="RenderTransform"><RotateTransform Angle="0"/></Setter>
    </Style>
    <!-- Header hover/expand: neutral fill only (no lime border / lime header) -->
    <Style Selector="Expander.SectionExpander /template/ ToggleButton#HeaderToggle /template/ Border">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="5"/>
    </Style>
    <Style Selector="Expander.SectionExpander /template/ ToggleButton#HeaderToggle:checked /template/ Border">
        <Setter Property="Background"   Value="#E6333333"/>
        <Setter Property="CornerRadius" Value="5,5,0,0"/>
    </Style>
    <Style Selector="Expander.SectionExpander /template/ ToggleButton#HeaderToggle:pointerover /template/ Border">
        <Setter Property="Background" Value="#E6333333"/>
    </Style>
    <Style Selector="Expander.SectionExpander /template/ ToggleButton#HeaderToggle:pressed /template/ Border">
        <Setter Property="Background" Value="#E63a3a3a"/>
    </Style>
    <Style Selector="Expander.SectionExpander /template/ ToggleButton#HeaderToggle:pointerover ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Expander.SectionExpander /template/ ToggleButton#HeaderToggle:pointerover TextBlock#Chevron">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- ── Scrubber slider ───────────────────────────────────────────────────── -->
    <Style Selector="Slider.ScrubSlider">
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Track Name="PART_Track"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                       Orientation="Horizontal">
                    <Track.DecreaseButton>
                        <RepeatButton Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate>
                                    <Border Height="6" VerticalAlignment="Center"
                                            Background="{DynamicResource Accent}"
                                            CornerRadius="2,0,0,2"/>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseButton>
                    <Track.Thumb>
                        <Thumb Width="12" Height="12" Focusable="False">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Ellipse Width="12" Height="12"
                                             Fill="{DynamicResource Accent}"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseButton>
                        <RepeatButton Focusable="False">
                            <RepeatButton.Template>
                                <ControlTemplate>
                                    <Border Height="6" VerticalAlignment="Center"
                                            Background="{DynamicResource Border2}"
                                            CornerRadius="0,2,2,0"/>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    </Track.IncreaseButton>
                </Track>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Outliner row selection (global — local Border.Styles miss class bindings in nested templates) -->
    <Style Selector="Border.outlinerRowSelected">
        <Setter Property="Background" Value="{DynamicResource AccentMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.outlinerRowSelected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</Styles>
