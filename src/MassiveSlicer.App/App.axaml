<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="using:Avalonia.Styling"
             x:Class="MassiveSlicer.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MassiveSlicer.App/Resources/Themes/MassiveMake.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Override SimpleTheme's Dark variant keys with the MassiveMAKE palette. -->
            <!-- Must be in ThemeDictionaries to beat SimpleTheme's own Dark entries.   -->
            <!-- Runtime theme switches re-sync these via App.SyncThemeAccentKeys.      -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="{x:Static av:ThemeVariant.Dark}">

                    <!-- Background / window surface -->
                    <Color x:Key="ThemeBackgroundColor">#222222</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#222222"/>

                    <!-- Primary text -->
                    <Color x:Key="ThemeForegroundColor">#e8e8e8</Color>
                    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#e8e8e8"/>
                    <Color x:Key="ThemeForegroundLowColor">#acacac</Color>
                    <SolidColorBrush x:Key="ThemeForegroundLowBrush" Color="#acacac"/>

                    <!-- Accent — MassiveMAKE green -->
                    <Color x:Key="ThemeAccentColor">#40b840</Color>
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#40b840"/>

                    <!-- Borders -->
                    <Color x:Key="ThemeBorderHighColor">#575757</Color>
                    <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="#575757"/>
                    <Color x:Key="ThemeBorderMidColor">#454545</Color>
                    <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="#454545"/>
                    <Color x:Key="ThemeBorderLowColor">#171717</Color>
                    <SolidColorBrush x:Key="ThemeBorderLowBrush" Color="#171717"/>

                    <!-- Control surfaces (darkest → lightest) -->
                    <Color x:Key="ThemeControlLowColor">#2b2b2b</Color>
                    <SolidColorBrush x:Key="ThemeControlLowBrush" Color="#2b2b2b"/>
                    <Color x:Key="ThemeControlMidColor">#333333</Color>
                    <SolidColorBrush x:Key="ThemeControlMidBrush" Color="#333333"/>
                    <Color x:Key="ThemeControlMidHighColor">#333333</Color>
                    <SolidColorBrush x:Key="ThemeControlMidHighBrush" Color="#333333"/>
                    <Color x:Key="ThemeControlHighColor">#3f3f3f</Color>
                    <SolidColorBrush x:Key="ThemeControlHighBrush" Color="#3f3f3f"/>
                    <Color x:Key="ThemeControlVeryHighColor">#3f3f3f</Color>
                    <SolidColorBrush x:Key="ThemeControlVeryHighBrush" Color="#3f3f3f"/>
                    <SolidColorBrush x:Key="ThemeControlTransparentBrush" Color="Transparent"/>

                    <!-- Highlights (selection, focus, active states) -->
                    <Color x:Key="ThemeControlHighlightHighColor">#58cc58</Color>
                    <SolidColorBrush x:Key="ThemeControlHighlightHighBrush" Color="#58cc58"/>
                    <Color x:Key="ThemeControlHighlightMidColor">#40b840</Color>
                    <SolidColorBrush x:Key="ThemeControlHighlightMidBrush" Color="#40b840"/>
                    <Color x:Key="ThemeControlHighlightLowColor">#1f5c1f</Color>
                    <SolidColorBrush x:Key="ThemeControlHighlightLowBrush" Color="#1f5c1f"/>

                    <!-- Disabled state -->
                    <x:Double x:Key="ThemeDisabledOpacity">0.38</x:Double>

                    <!-- System selection/highlight — overrides platform blue used by CheckBox/ComboBox -->
                    <Color x:Key="HighlightColor">#40b840</Color>
                    <SolidColorBrush x:Key="HighlightBrush" Color="#40b840"/>
                    <Color x:Key="HighlightForegroundColor">#e8e8e8</Color>
                    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="#e8e8e8"/>

                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml"/>
        <StyleInclude Source="avares://MassiveSlicer.App/Resources/Styles/BaseStyles.axaml"/>
    </Application.Styles>

</Application>
