<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="using:Avalonia.Styling"
             x:Class="MassiveSlicer.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MassiveSlicer.App/Resources/Themes/MassiveMake.axaml"/>
                <ResourceInclude Source="avares://MassiveSlicer.App/Resources/Themes/ControlThemes.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Always-on lime field ring. ThemeDictionaries can miss if SimpleTheme
                 resolves ThemeBorderHighBrush from Default instead of Dark. -->
            <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="#71a72a"/>
            <Color x:Key="ThemeBorderHighColor">#71a72a</Color>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="#71a72a"/>
            <Color x:Key="ThemeAccentColor">#71a72a</Color>

            <!-- Override SimpleTheme's Dark variant keys with the MassiveMAKE palette. -->
            <!-- Must be in ThemeDictionaries to beat SimpleTheme's own Dark entries.   -->
            <!-- Runtime theme switches re-sync these via App.SyncThemeAccentKeys.      -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="{x:Static av:ThemeVariant.Dark}">

                    <!-- Background / window surface -->
                    <Color x:Key="ThemeBackgroundColor">#222222</Color>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#222222"/>

                    <!-- Primary text -->
                    <Color x:Key="ThemeForegroundColor">#e8e8e8</Color>
                    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#e8e8e8"/>
                    <Color x:Key="ThemeForegroundLowColor">#acacac</Color>
                    <SolidColorBrush x:Key="ThemeForegroundLowBrush" Color="#acacac"/>

                    <!-- Accent — MassiveMAKE lime (2/3/4 = translucent variants used by
                         SimpleTheme for menu/list hover + selection highlights) -->
                    <Color x:Key="ThemeAccentColor">#71a72a</Color>
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#71a72a"/>
                    <Color x:Key="ThemeAccentColor2">#CC71a72a</Color>
                    <SolidColorBrush x:Key="ThemeAccentBrush2" Color="#CC71a72a"/>
                    <Color x:Key="ThemeAccentColor3">#9971a72a</Color>
                    <SolidColorBrush x:Key="ThemeAccentBrush3" Color="#9971a72a"/>
                    <Color x:Key="ThemeAccentColor4">#6671a72a</Color>
                    <SolidColorBrush x:Key="ThemeAccentBrush4" Color="#6671a72a"/>

                    <!-- Borders. High = hover/focus field ring (SimpleTheme
                         ControlTheme binds this). Must be lime, never Cosmic/OS purple. -->
                    <Color x:Key="ThemeBorderHighColor">#71a72a</Color>
                    <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="#71a72a"/>
                    <Color x:Key="ThemeBorderMidColor">#454545</Color>
                    <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="#454545"/>
                    <Color x:Key="ThemeBorderLowColor">#171717</Color>
                    <SolidColorBrush x:Key="ThemeBorderLowBrush" Color="#171717"/>

                    <!-- Control surfaces (darkest → lightest) -->
                    <Color x:Key="ThemeControlLowColor">#2b2b2b</Color>
                    <SolidColorBrush x:Key="ThemeControlLowBrush" Color="#2b2b2b"/>
                    <Color x:Key="ThemeControlMidColor">#333333</Color>
                    <SolidColorBrush x:Key="ThemeControlMidBrush" Color="#333333"/>
                    <Color x:Key="ThemeControlMidHighColor">#333333</Color>
                    <SolidColorBrush x:Key="ThemeControlMidHighBrush" Color="#333333"/>
                    <Color x:Key="ThemeControlHighColor">#3f3f3f</Color>
                    <SolidColorBrush x:Key="ThemeControlHighBrush" Color="#3f3f3f"/>
                    <Color x:Key="ThemeControlVeryHighColor">#3f3f3f</Color>
                    <SolidColorBrush x:Key="ThemeControlVeryHighBrush" Color="#3f3f3f"/>
                    <SolidColorBrush x:Key="ThemeControlTransparentBrush" Color="Transparent"/>

                    <!-- Highlights (selection, focus, active states) -->
                    <Color x:Key="ThemeControlHighlightHighColor">#8bc43a</Color>
                    <SolidColorBrush x:Key="ThemeControlHighlightHighBrush" Color="#8bc43a"/>
                    <Color x:Key="ThemeControlHighlightMidColor">#71a72a</Color>
                    <SolidColorBrush x:Key="ThemeControlHighlightMidBrush" Color="#71a72a"/>
                    <Color x:Key="ThemeControlHighlightLowColor">#3a5716</Color>
                    <SolidColorBrush x:Key="ThemeControlHighlightLowBrush" Color="#3a5716"/>

                    <!-- Disabled state -->
                    <x:Double x:Key="ThemeDisabledOpacity">0.38</x:Double>

                    <!-- System selection/highlight — overrides platform purple used by CheckBox/ComboBox -->
                    <Color x:Key="HighlightColor">#71a72a</Color>
                    <SolidColorBrush x:Key="HighlightBrush" Color="#71a72a"/>
                    <Color x:Key="HighlightForegroundColor">#e8e8e8</Color>
                    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="#e8e8e8"/>

                    <!-- Windows / Avalonia system accent (Fluent + Simple focus rings) -->
                    <Color x:Key="SystemAccentColor">#71a72a</Color>
                    <Color x:Key="SystemAccentColorDark1">#71a72a</Color>
                    <Color x:Key="SystemAccentColorDark2">#3a5716</Color>
                    <Color x:Key="SystemAccentColorDark3">#2a4010</Color>
                    <Color x:Key="SystemAccentColorLight1">#8bc43a</Color>
                    <Color x:Key="SystemAccentColorLight2">#a3d45c</Color>
                    <Color x:Key="SystemAccentColorLight3">#c0e88a</Color>
                    <SolidColorBrush x:Key="SystemAccentBrush" Color="#71a72a"/>
                    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#71a72a"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#6671a72a"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#9971a72a"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#CC71a72a"/>

                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml"/>
        <StyleInclude Source="avares://MassiveSlicer.App/Resources/Styles/BaseStyles.axaml"/>
    </Application.Styles>

</Application>
