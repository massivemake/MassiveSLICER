<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:ia="https://github.com/projektanker/icons.avalonia"
             x:Class="MassiveSlicer.App.Views.Lfam3LiveIoPanelView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <DataTemplate x:Key="LiveIoSignalRowTemplate">
            <StackPanel Spacing="2" Margin="0,0,0,1">
                <Border Classes="Lfam3LiveIoRow">
                    <Grid ColumnDefinitions="42,12,*,48,18"
                          ColumnSpacing="4">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding KindLabel}"
                                   Classes="Lfam3LiveIoPin"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1"
                              Width="8"
                              Height="8"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center">
                            <shapes:Ellipse Classes="Lfam3LiveIoDot"
                                            Classes.inactive="{Binding ShowInactive}"
                                            Classes.active="{Binding IsActive}"
                                            Classes.warning="{Binding IsWarning}"
                                            Classes.fault="{Binding IsFault}"
                                            IsVisible="{Binding IsDigital}"/>
                        </Grid>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Label}"
                                   Classes="Lfam3LiveIoLabel"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Label}"/>
                        <!-- Read-only digital / non-writable analog value -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding DisplayValue}"
                                   Classes="Lfam3LiveIoValue"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsWritableAnalog}"/>
                        <!-- Writable analog: edit engineering value + Set -->
                        <StackPanel Grid.Column="3"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    HorizontalAlignment="Right"
                                    IsVisible="{Binding IsWritableAnalog}">
                            <TextBox Text="{Binding EditText, Mode=TwoWay}"
                                     Width="36"
                                     FontSize="8"
                                     FontFamily="Consolas,Courier New,monospace"
                                     MinHeight="16"
                                     Padding="3,1"
                                     VerticalContentAlignment="Center"
                                     IsEnabled="{Binding !IsWriteBusy}"
                                     ToolTip.Tip="Engineering value: O1-O3 = C, O4 = % RPM"/>
                            <TextBlock Text="{Binding UnitLabel}"
                                       FontSize="8"
                                       Classes="LabelMuted"
                                       VerticalAlignment="Center"
                                       MinWidth="12"/>
                            <Button Content="Set"
                                    FontSize="8"
                                    Padding="4,1"
                                    Classes="Lfam3LiveIoToggle"
                                    Command="{Binding SetAnalogCommand}"
                                    IsEnabled="{Binding CanSetAnalog}"
                                    ToolTip.Tip="Write $ANOUT on the connected robot"/>
                        </StackPanel>
                        <Button Grid.Column="4"
                                Content="⇅"
                                FontSize="9"
                                Padding="0"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Right"
                                Classes="Lfam3LiveIoToggle"
                                IsVisible="{Binding IsWritableDigital}"
                                Command="{Binding RequestToggleCommand}"
                                ToolTip.Tip="Force output (requires confirmation)"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            Margin="58,0,0,1"
                            IsVisible="{Binding IsConfirmPending}">
                    <TextBlock Text="{Binding ConfirmMessage}"
                               FontSize="8"
                               Foreground="#f0c040"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="Confirm"
                            FontSize="8"
                            Padding="5,1"
                            Classes="Lfam3LiveIoToggle"
                            Command="{Binding ConfirmToggleCommand}"/>
                    <Button Content="Cancel"
                            FontSize="8"
                            Padding="5,1"
                            Classes="Lfam3LiveIoToggle"
                            Command="{Binding CancelToggleCommand}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Classes="Lfam3LiveIoPanel nested">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding Phase1Hint}"
                       FontSize="8"
                       Foreground="#71a72a"
                       Margin="1,0,1,0"
                       TextWrapping="Wrap"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleSections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="Lfam3LiveIoSection"
                                Classes.split-io="{Binding UsesSplitIoLayout}"
                                Classes.robot-triple="{Binding UsesRobotTripleLayout}"
                                Classes.pending="{Binding !IsPhaseLive}"
                                VerticalAlignment="Top">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="1,0,1,0">
                                    <Button Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="1,0"
                                            Margin="0,0,4,0"
                                            Cursor="Hand"
                                            Command="{Binding ToggleCollapsedCommand}"
                                            ToolTip.Tip="Collapse / expand section">
                                        <ia:Icon Value="{Binding CollapseIcon}" FontSize="11" Foreground="#71a72a"/>
                                    </Button>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Classes="Lfam3LiveIoSectionTitle"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusLine}"
                                               Classes="LabelMuted"
                                               FontSize="8"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="80"/>
                                </Grid>

                                <StackPanel Spacing="4" IsVisible="{Binding IsBodyVisible}">

                                <!-- Robot: Position | Inputs | Outputs -->
                                <Grid ColumnDefinitions="Auto,6,*,8,*"
                                      IsVisible="{Binding UsesRobotTripleLayout}">
                                    <!-- Position column -->
                                    <Border Grid.Column="0" Classes="Lfam3LiveIoPoseColumn">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="POSITION"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="#71a72a"
                                                           LetterSpacing="0.5"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        Classes="Lfam3LiveIoPoseLivePill"
                                                        IsVisible="{Binding IsRobotPoseLive}">
                                                    <TextBlock Text="LIVE"
                                                               FontSize="7"
                                                               FontWeight="Bold"
                                                               Foreground="#71a72a"
                                                               LetterSpacing="0.5"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="Sync robot for live position"
                                                       FontSize="8"
                                                       Classes="LabelMuted"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding !IsRobotPoseLive}"/>

                                            <StackPanel Spacing="3" IsVisible="{Binding IsRobotPoseLive}">
                                                <!-- Joint angles ($AXIS_ACT) -->
                                                <Border Classes="Lfam3LiveIoPoseGroup">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="JOINTS" Classes="Lfam3LiveIoPoseGroupTitle"/>
                                                        <Grid ColumnDefinitions="16,*,4,16,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="A1" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding A1, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="A4" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding A4, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="A2" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding A2, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="A5" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding A5, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="A3" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding A3, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="A6" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding A6, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="E1" Classes="Lfam3LiveIoPoseLabel" Margin="0,2,0,0"/>
                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding E1, StringFormat={}{0:F1}°}" Classes="Lfam3LiveIoPoseValue" Margin="0,2,0,0"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- TCP Cartesian ($POS_ACT) -->
                                                <Border Classes="Lfam3LiveIoPoseGroup">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="TCP · mm" Classes="Lfam3LiveIoPoseGroupTitle"/>
                                                        <Grid ColumnDefinitions="14,*" RowDefinitions="Auto,Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TcpX, StringFormat={}{0:F1}}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TcpY, StringFormat={}{0:F1}}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TcpZ, StringFormat={}{0:F1}}" Classes="Lfam3LiveIoPoseValue"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- TCP orientation -->
                                                <Border Classes="Lfam3LiveIoPoseGroup">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="ABC · °" Classes="Lfam3LiveIoPoseGroupTitle"/>
                                                        <Grid ColumnDefinitions="14,*" RowDefinitions="Auto,Auto,Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="A" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TcpA, StringFormat={}{0:F2}}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="B" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TcpB, StringFormat={}{0:F2}}" Classes="Lfam3LiveIoPoseValue"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="C" Classes="Lfam3LiveIoPoseLabel"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TcpC, StringFormat={}{0:F2}}" Classes="Lfam3LiveIoPoseValue"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Classes="Lfam3LiveIoColumnDivider"/>
                                    <Border Grid.Column="2" Classes="Lfam3LiveIoColumn">
                                        <StackPanel Spacing="2">
                                        <TextBlock Text="INPUTS"
                                                   Classes="Lfam3LiveIoColTitle"/>
                                        <ItemsControl ItemsSource="{Binding InputSignals}"
                                                      ItemTemplate="{StaticResource LiveIoSignalRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Classes="Lfam3LiveIoColumnDivider"/>
                                    <Border Grid.Column="4" Classes="Lfam3LiveIoColumn">
                                        <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                                            <TextBlock Grid.Column="0"
                                                       Text="OUTPUTS"
                                                       Classes="Lfam3LiveIoColTitle"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Content="Zero O1-O4"
                                                    FontSize="8"
                                                    Padding="4,1"
                                                    Classes="Lfam3LiveIoToggle"
                                                    IsVisible="{Binding ShowZeroAnouts}"
                                                    Command="{Binding ZeroAllAnoutsCommand}"
                                                    IsEnabled="{Binding CanZeroAnouts}"
                                                    ToolTip.Tip="Write $ANOUT[1]..[4] = 0 on the connected robot"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ZeroAnoutStatus}"
                                                   FontSize="8"
                                                   Foreground="#f0c040"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding ZeroAnoutStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <ItemsControl ItemsSource="{Binding OutputSignals}"
                                                      ItemTemplate="{StaticResource LiveIoSignalRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Extruder / Spindle: Inputs | Outputs (+ RPM on Spindle) -->
                                <Grid ColumnDefinitions="*,8,*"
                                      IsVisible="{Binding UsesDualIoLayout}">
                                    <Border Grid.Column="0" Classes="Lfam3LiveIoColumn">
                                        <StackPanel Spacing="2">
                                        <TextBlock Text="INPUTS"
                                                   Classes="Lfam3LiveIoColTitle"/>
                                        <ItemsControl ItemsSource="{Binding InputSignals}"
                                                      ItemTemplate="{StaticResource LiveIoSignalRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="Lfam3LiveIoColumnDivider"/>
                                    <Border Grid.Column="2" Classes="Lfam3LiveIoColumn">
                                        <StackPanel Spacing="2">
                                        <!-- Spindle ATV RPM (separate from KUKA DO51 enable) -->
                                        <Border IsVisible="{Binding ShowSpindleRpm}"
                                                Classes="Lfam3LiveIoPoseGroup"
                                                Margin="0,0,0,4">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="SPINDLE RPM"
                                                           Classes="Lfam3LiveIoPoseGroupTitle"/>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding SpindleRpmText, Mode=TwoWay}"
                                                             PlaceholderText="0-24000"
                                                             FontSize="8"
                                                             FontFamily="Consolas,Courier New,monospace"
                                                             MinHeight="18"
                                                             Padding="4,1"
                                                             IsEnabled="{Binding !SpindleRpmBusy}"/>
                                                    <Button Grid.Column="1"
                                                            Content="Set"
                                                            FontSize="8"
                                                            Padding="6,2"
                                                            MinWidth="28"
                                                            Classes="Lfam3LiveIoToggle"
                                                            Command="{Binding SetSpindleRpmCommand}"
                                                            IsEnabled="{Binding CanSetSpindleRpm}"
                                                            ToolTip.Tip="Send RPM setpoint to ATV340 (does not toggle DO51)"/>
                                                </Grid>
                                                <TextBlock Text="{Binding SpindleRpmActualLine}"
                                                           FontSize="8"
                                                           Classes="LabelMuted"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SpindleRpmStatus}"
                                                           FontSize="8"
                                                           Foreground="#f0c040"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="OUTPUTS"
                                                   Classes="Lfam3LiveIoColTitle"/>
                                        <ItemsControl ItemsSource="{Binding OutputSignals}"
                                                      ItemTemplate="{StaticResource LiveIoSignalRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Single-column phase equipment -->
                                <ItemsControl ItemsSource="{Binding Signals}"
                                              ItemTemplate="{StaticResource LiveIoSignalRowTemplate}"
                                              IsVisible="{Binding !UsesSplitIoLayout}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding PhaseRoadmapSummary}"
                       Classes="LabelMuted"
                       FontSize="8"
                       Margin="1,2,1,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>