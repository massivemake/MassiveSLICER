<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MassiveSlicer.ViewModels"
        xmlns:ia="https://github.com/projektanker/icons.avalonia"
        x:Class="MassiveSlicer.App.Views.MaterialPresetDialog"
        x:CompileBindings="False"
        Title="Material Preset"
        Width="420" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg0}">

    <Border BorderBrush="{DynamicResource Border2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" x:Name="TitleBar"
                    Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll">
                <Grid Margin="14,0">
                    <TextBlock Text="Material Preset"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Classes="ToolbarButton"
                            Padding="6,2"
                            Click="OnCancel">
                        <ia:Icon Value="mdi-close" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form body -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Bg2}">
                <StackPanel Margin="20,16,20,16">

                    <!-- Identification -->
                    <TextBlock Text="IDENTIFICATION" Classes="SectionHeader" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding Name, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Material type" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                   ItemsSource="{x:Static vm:MaterialPresetEditorViewModel.MaterialTypes}"
                                   SelectedItem="{Binding MaterialType, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Color" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                   ItemsSource="{x:Static vm:MaterialPresetEditorViewModel.Colors}"
                                   SelectedItem="{Binding Color, Mode=TwoWay}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border1}" Margin="0,10,0,10"/>

                    <!-- Temperatures -->
                    <TextBlock Text="TEMPERATURES (°C)" Classes="SectionHeader" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="T1" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding Temperature1, Mode=TwoWay, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="T2" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding Temperature2, Mode=TwoWay, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="T3" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding Temperature3, Mode=TwoWay, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border1}" Margin="0,10,0,10"/>

                    <!-- Extrusion properties -->
                    <TextBlock Text="PROPERTIES" Classes="SectionHeader" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Flow rate HV (rev/cm³)" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding FlowRate, Mode=TwoWay, StringFormat={}{0:F4}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Flow rate HF (rev/cm³)" Classes="LabelMuted" VerticalAlignment="Center"
                                   ToolTip.Tip="HF-extruder flow. 0 = use the HV value. Chosen automatically per active cell/extruder."/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding FlowRateHf, Mode=TwoWay, StringFormat={}{0:F4}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Density (g/cm³)" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding MaterialDensity, Mode=TwoWay, StringFormat={}{0:F3}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cost ($/lb)" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding CostPerLb, Mode=TwoWay, StringFormat={}{0:F2}}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border1}" Margin="0,10,0,10"/>

                    <!-- Thermomechanical simulation thresholds -->
                    <TextBlock Text="THERMOMECHANICAL" Classes="SectionHeader" Margin="0,0,0,6"/>

                    <TextBlock Classes="LabelMuted" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85"
                               Text="Thresholds for the Thermal view and Adaptive Speed recommendations. Bond / sag limits frame the safe interlayer temperature window used by the analytical cooling model."/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Glass transition Tg (°C)" Classes="LabelMuted" VerticalAlignment="Center"
                                   ToolTip.Tip="Bonding-relevant Tg. Leave 0 to auto-fill from material type (ABS≈105, PC≈145, PEI≈217…)."/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding GlassTransitionC, Mode=TwoWay, StringFormat={}{0:F0}}"
                                   ToolTip.Tip="0 = auto from material type"/>
                    </Grid>
                    <TextBlock Text="{Binding GlassTransitionHint}"
                               Classes="LabelMuted" FontSize="10" TextWrapping="Wrap"
                               Opacity="0.75" Margin="0,-2,0,6"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bond margin (°C)" Classes="LabelMuted" VerticalAlignment="Center"
                                   ToolTip.Tip="Bond threshold = Tg + this. Interface cooler than bond limit → weak fusion. Default 10."/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding ThermalBondMarginC, Mode=TwoWay, StringFormat={}{0:F0}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sag margin (°C)" Classes="LabelMuted" VerticalAlignment="Center"
                                   ToolTip.Tip="Sag threshold = Tg + this. Previous layer hotter than sag limit → too soft for a new bead. Default 45."/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding ThermalSagMarginC, Mode=TwoWay, StringFormat={}{0:F0}}"/>
                    </Grid>

                    <TextBlock Text="{Binding ThermalThresholdsHint}"
                               Classes="LabelMuted" FontSize="10" TextWrapping="Wrap"
                               Opacity="0.85" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ambient (°C)" Classes="LabelMuted" VerticalAlignment="Center"
                                   ToolTip.Tip="Build-environment / chamber ambient temperature for the Newton cooling model."/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding ThermalAmbientC, Mode=TwoWay, StringFormat={}{0:F0}}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border1}" Margin="0,10,0,10"/>

                    <!-- Purge-and-weigh calibration -->
                    <TextBlock Text="CALIBRATION — PURGE &amp; WEIGH" Classes="SectionHeader" Margin="0,0,0,6"/>

                    <TextBlock Classes="LabelMuted" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8"
                               Text="Heat the extruder to the temperatures above. Run it into the air at a fixed motor % for a fixed time. Weigh the cooled purge and enter the numbers — the flow rate is computed from them (uses Density above)."/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Motor speed (%)" Classes="LabelMuted" VerticalAlignment="Center"
                                   ToolTip.Tip="The extruder % set on the KUKA during the purge test ($ANOUT[4] × 100)"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding CalibMotorPercent, Mode=TwoWay, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Run time (s)" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding CalibTimeSec, Mode=TwoWay, StringFormat={}{0:F0}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="LabelMuted" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.85"
                                   Text="Open a new MassiveSLICER window with a calibration .mass (home XY, 1 ft Z, motor % × time). This scene stays open — adjust then Export / Send to robot."/>
                        <Button    Grid.Column="1" Content="Create Material Calibration"
                                   Classes="ToolbarButton" Padding="12,6" Margin="8,0,0,0"
                                   Click="OnCreateMaterialCalibration"
                                   ToolTip.Tip="Writes a .mass workspace and launches a second MassiveSLICER instance. Does not close or change this workspace."/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Purge weight (g)" Classes="LabelMuted" VerticalAlignment="Center"/>
                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                   Text="{Binding CalibWeightG, Mode=TwoWay, StringFormat={}{0:F1}}"/>
                    </Grid>

                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CalibComputedText}"
                                   Classes="LabelMuted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button    Grid.Column="1" Content="Apply"
                                   Classes="PrimaryButton" Padding="12,4"
                                   Click="OnApplyCalibration"
                                   ToolTip.Tip="Write the computed value into Flow rate and stamp the calibration date"/>
                    </Grid>

                    <TextBlock Text="{Binding CalibrationStatus}"
                               Classes="LabelMuted" TextWrapping="Wrap"
                               Opacity="0.7" Margin="0,2,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Margin="0,0,16,0">
                    <Button Content="Cancel"
                            Classes="ToolbarButton"
                            Padding="14,6"
                            Click="OnCancel"/>
                    <Button Content="Save"
                            Classes="PrimaryButton"
                            Padding="14,6"
                            Click="OnSave"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

</Window>
