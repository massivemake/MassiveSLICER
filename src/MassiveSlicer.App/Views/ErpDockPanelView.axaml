<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ia="https://github.com/projektanker/icons.avalonia"
             x:Class="MassiveSlicer.App.Views.ErpDockPanelView"
             x:CompileBindings="False">

    <!-- DataContext = ErpViewModel -->
    <StackPanel Spacing="8" Width="300">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="PROJECT ATTACHMENT"
                       Classes="LabelMuted" FontSize="10" LetterSpacing="1"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Background="Transparent" BorderThickness="0" Padding="4,2"
                    Command="{Binding OpenPreferencesCommand}"
                    ToolTip.Tip="Connection settings (Preferences → Connections)">
                <ia:Icon Value="mdi-cog-outline" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
            </Button>
        </Grid>

        <!-- Not connected: credentials live in Preferences → Connections -->
        <StackPanel Spacing="6" IsVisible="{Binding ShowSettings}">
            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7"
                       Text="The ERP URL and API token are set in Preferences → Connections and connect automatically at launch. Generate a token in ERP Settings → Slicer Access."/>
            <Button Content="Open Preferences…" HorizontalAlignment="Stretch"
                    Command="{Binding OpenPreferencesCommand}"/>
            <Button Content="Retry Connect" HorizontalAlignment="Stretch"
                    Command="{Binding ConnectCommand}"/>
        </StackPanel>

        <!-- Search + attach -->
        <StackPanel Spacing="6" IsVisible="{Binding ShowSearch}">
            <TextBox Classes="PanelTextBox"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="Search project # or title…"/>
            <ListBox ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     MaxHeight="180"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                            <TextBlock Grid.Column="0" Text="{Binding Number}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Type}" FontSize="9"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Spacing="2" IsVisible="{Binding HasElements}">
                <TextBlock Text="ELEMENT (optional)" Classes="LabelMuted" FontSize="9" LetterSpacing="1"/>
                <ListBox ItemsSource="{Binding Elements}"
                         SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                         MaxHeight="120"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,1">
                                <TextBlock Grid.Column="0" Text="{Binding ElementNumber}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RevisionCount, StringFormat=Rev {0}}"
                                           FontSize="9" Foreground="{DynamicResource TextMuted}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- New element on the selected project/lead -->
            <StackPanel Spacing="4"
                        IsVisible="{Binding SelectedResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="NEW ELEMENT" Classes="LabelMuted" FontSize="9" LetterSpacing="1"/>
                <Grid ColumnDefinitions="*,6,Auto">
                    <TextBox Grid.Column="0" Classes="PanelTextBox"
                             Text="{Binding NewElementName, Mode=TwoWay}"
                             Watermark="Element name…"/>
                    <Button Grid.Column="2" Content="Create"
                            Command="{Binding CreateElementCommand}"
                            ToolTip.Tip="Create this element on the ERP and select it"/>
                </Grid>
            </StackPanel>

            <Button Content="Attach Workspace" HorizontalAlignment="Stretch"
                    Classes="ExportCta"
                    Command="{Binding AttachCommand}"/>
        </StackPanel>

        <!-- Attached -->
        <StackPanel Spacing="6" IsVisible="{Binding ShowAttachment}">
            <Border Background="#3f3f3f" CornerRadius="5" Padding="8,6">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ia:Icon Value="mdi-link-variant" FontSize="12" Foreground="#40b840"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Attached" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#40b840" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AttachmentSummary}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- The attached project/lead has no element yet — create + link one -->
            <StackPanel Spacing="4" IsVisible="{Binding ShowAttachmentElementCreate}">
                <TextBlock Text="NO ELEMENT LINKED — CREATE ONE" Classes="LabelMuted"
                           FontSize="9" LetterSpacing="1"/>
                <Grid ColumnDefinitions="*,6,Auto">
                    <TextBox Grid.Column="0" Classes="PanelTextBox"
                             Text="{Binding AttachmentElementName, Mode=TwoWay}"
                             Watermark="Element name…"/>
                    <Button Grid.Column="2" Content="Create"
                            Command="{Binding CreateAttachmentElementCommand}"
                            ToolTip.Tip="Create this element on the ERP and link the workspace to it"/>
                </Grid>
            </StackPanel>

            <!-- Lead was converted to a project — offer one-click re-attach -->
            <Button Content="Attach to Converted Project" HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowReattachOffer}"
                    Command="{Binding ReattachToProjectCommand}"
                    ToolTip.Tip="This lead was converted to a project on the ERP — re-attach the workspace to that project"/>

            <Button Content="Send Slice to ERP" HorizontalAlignment="Stretch"
                    Classes="ExportCta"
                    Command="{Binding SendSliceCommand}"
                    ToolTip.Tip="Register this slice on the linked element — preview + stats; heavy files stay on the UNAS and are linked by path"/>

            <Grid ColumnDefinitions="*,6,*">
                <Button Grid.Column="0" Content="Change" HorizontalAlignment="Stretch"
                        Command="{Binding ChangeCommand}"
                        ToolTip.Tip="Pick a different project/lead"/>
                <Button Grid.Column="2" Content="Detach" HorizontalAlignment="Stretch"
                        Command="{Binding DetachCommand}"/>
            </Grid>
        </StackPanel>

        <!-- Saved workspaces in the attached project's folder — open to iterate an element -->
        <StackPanel IsVisible="{Binding HasWorkspaceCandidates}" Spacing="2" Margin="0,4,0,0">
            <TextBlock Text="PROJECT WORKSPACES" FontSize="9" LetterSpacing="1" Opacity="0.6"/>
            <!-- Open command lives on ErpViewModel; do NOT use ((vm:ErpViewModel)DataContext)
                 casts here — Avalonia deferred DataTemplates cannot resolve the vm: xmlns
                 prefix at runtime and throw ArgumentException (app abort) when candidates appear. -->
            <ItemsControl ItemsSource="{Binding WorkspaceCandidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="9" Opacity="0.55"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open" FontSize="10" Padding="8,2" VerticalAlignment="Center"
                                    Command="{Binding $parent[UserControl].DataContext.OpenWorkspaceCandidateCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Open this saved workspace — its elements, toolpaths and ERP link load into the app so you can iterate (the next send registers a new rev)."/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="10" Opacity="0.7"/>
        <TextBlock Text="{Binding PricingSummary}" TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                   IsVisible="{Binding PricingSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   ToolTip.Tip="Rates in effect from the ERP Printing Cost Basis page. The stats panel cost uses these when connected; sendslice returns the authoritative cost for the revision."/>
    </StackPanel>
</UserControl>
