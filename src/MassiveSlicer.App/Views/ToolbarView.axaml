<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MassiveSlicer.ViewModels"
             xmlns:ia="https://github.com/projektanker/icons.avalonia"
             x:Class="MassiveSlicer.App.Views.ToolbarView"
             x:CompileBindings="False">

    <!-- Translucent: the toolbar ghosts over the full-bleed viewport -->
    <Border Background="#E0222222"
            BorderBrush="{DynamicResource Border1}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Send lives here (left of Realtime) so the 309px right strip is not crowded -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: brand + file menu ──────────────────────────────────── -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="MASSIVE"
                           FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="SLICER"
                           FontWeight="Light" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="2,0,12,0"/>

                <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New"
                                  Command="{Binding NewWorkspaceCommand}"
                                  InputGesture="Ctrl+N"/>
                        <Separator/>
                        <MenuItem Header="_Open..."
                                  Command="{Binding OpenWorkspaceCommand}"
                                  InputGesture="Ctrl+O"/>
                        <MenuItem Header="Open _Recent"
                                  ItemsSource="{Binding RecentWorkspaces}"
                                  IsEnabled="{Binding HasRecentWorkspaces}">
                            <MenuItem.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem"
                                              BasedOn="{StaticResource {x:Type MenuItem}}"
                                              x:DataType="vm:RecentWorkspaceItem">
                                    <Setter Property="Header" Value="{Binding Label}"/>
                                    <Setter Property="Command" Value="{Binding OpenCommand}"/>
                                    <Setter Property="(ToolTip.Tip)" Value="{Binding Path}"/>
                                </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                        </MenuItem>
                        <MenuItem Header="_Save"
                                  Command="{Binding SaveWorkspaceCommand}"
                                  InputGesture="Ctrl+S"/>
                        <MenuItem Header="Save _As..."
                                  Command="{Binding SaveWorkspaceAsCommand}"
                                  InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="Import _Model..."
                                  Command="{Binding OpenModelCommand}"/>
                        <MenuItem Header="Import _KRL..."
                                  Command="{Binding ImportKrlCommand}"/>
                        <Separator/>
                        <MenuItem Header="_Preferences..."
                                  Command="{Binding OpenPreferencesCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo"
                                  Command="{Binding UndoCommand}"
                                  InputGesture="Ctrl+Z"/>
                        <MenuItem Header="_Redo"
                                  Command="{Binding RedoCommand}"
                                  InputGesture="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="_Cut Tool..."
                                  Command="{Binding Viewport.CutToolCommand}"
                                  ToolTip.Tip="Split selected model into two parts with Formbound tabs and bolt lugs"/>
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- ── Send (left of Realtime): destination + send + save .src ───── -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                <ComboBox MinWidth="140" MaxWidth="190" Height="28"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,2,0"
                          ItemsSource="{Binding $parent[Window].DataContext.Viewport.SendTargets}"
                          SelectedItem="{Binding $parent[Window].DataContext.Viewport.SelectedSendTarget}"
                          ToolTip.Tip="Where Send delivers the active toolpath: robot share (KRL) or MassiveDRIVE (path + extruder)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="ExportCta" Padding="10,4"
                        CornerRadius="4,0,0,4"
                        Command="{Binding $parent[Window].DataContext.Viewport.SendToRobotCommand}"
                        ToolTip.Tip="{Binding $parent[Window].DataContext.Viewport.SendActionTip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ia:Icon Value="mdi-robot-industrial" FontSize="12" Foreground="#242424"/>
                        <TextBlock Text="{Binding $parent[Window].DataContext.Viewport.SendActionLabel}"
                                   FontWeight="SemiBold" FontSize="11" Foreground="#242424"/>
                    </StackPanel>
                </Button>
                <Button Classes="ExportCta" Padding="5,4"
                        CornerRadius="0,4,4,0"
                        Command="{Binding $parent[Window].DataContext.Viewport.ExportKrlCommand}"
                        ToolTip.Tip="Download the KRL program (.src) to a file instead">
                    <ia:Icon Value="mdi-content-save" FontSize="12" Foreground="#242424"/>
                </Button>
            </StackPanel>

            <!-- ── Right strip: Realtime + console + settings (aligned to sidebar) ─ -->
            <!-- Width matches the right sidebar host (309 incl. its 9px edge lane) so
                 the Realtime toggle's left edge lines up with the floating step cards. -->
            <Grid Grid.Column="2" Width="309"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  ColumnDefinitions="Auto,*,Auto,Auto">

                <ToggleButton Grid.Column="0" Classes="RealtimePause" Width="96" Margin="0,0,8,0"
                              IsChecked="{Binding $parent[Window].DataContext.Viewport.RealtimeSlicingPaused, Mode=TwoWay}"
                              ToolTip.Tip="Pause realtime slicing — batch up changes, then untoggle to re-slice once">
                    <Panel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    IsVisible="{Binding !$parent[ToggleButton].IsChecked}">
                            <ia:Icon Value="mdi-pause" FontSize="12" Foreground="#242424"/>
                            <TextBlock Text="Realtime" FontWeight="SemiBold" FontSize="11" Foreground="#242424"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5"
                                    IsVisible="{Binding $parent[ToggleButton].IsChecked}">
                            <ia:Icon Value="mdi-play" FontSize="12" Foreground="#242424"/>
                            <TextBlock Text="Paused" FontWeight="SemiBold" FontSize="11" Foreground="#242424"/>
                        </StackPanel>
                    </Panel>
                </ToggleButton>

                <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding ToggleConsoleCommand}" ToolTip.Tip="Toggle Console" Margin="0,0,4,0">
                    <ia:Icon Value="mdi-console" FontSize="13"/>
                </Button>
                <Button Grid.Column="3" Classes="ToolbarButton" Command="{Binding ToggleRightPanelCommand}" ToolTip.Tip="Toggle Settings Panel" Margin="0,0,9,0">
                    <ia:Icon Value="mdi-menu" FontSize="13"/>
                </Button>
            </Grid>
        </Grid>
    </Border>

</UserControl>
