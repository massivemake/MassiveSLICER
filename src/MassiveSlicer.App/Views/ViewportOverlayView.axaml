<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ia="https://github.com/projektanker/icons.avalonia"
             xmlns:ctrl="clr-namespace:MassiveSlicer.Controls"
             xmlns:local="clr-namespace:MassiveSlicer.App.Views"
             xmlns:vm="clr-namespace:MassiveSlicer.ViewModels"
             xmlns:ctl="using:MassiveSlicer.Controls"
             xmlns:conv="clr-namespace:MassiveSlicer.Converters;assembly=MassiveSlicer.App"
             x:Class="MassiveSlicer.App.Views.ViewportOverlayView"
             x:DataType="vm:ViewportViewModel"
             x:CompileBindings="True"
             Background="Transparent">

    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatchCvt"/>
        <conv:BoolConverter x:Key="NotCvt" Invert="True"/>
    </UserControl.Resources>

    <!-- Side margins keep overlay chrome clear of the floating panel cards. -->
    <Grid Background="Transparent" Margin="320,52,320,0">

        <!-- View-mode pills — top right -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,0,0" ZIndex="15"
                Background="#B3222222" CornerRadius="6"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="ViewPill" Content="Body"
                        Classes.active="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Body}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Body"/>
                <Button Classes="ViewPill" Content="Toolpath"
                        Classes.active="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Toolpath}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Toolpath"/>
                <Button Classes="ViewPill" Content="Speed"
                        Classes.active="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Speed}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Speed"/>
                <Button Classes="ViewPill" Content="RPM"
                        Classes.active="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=RPM}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="RPM"
                        ToolTip.Tip="Extrusion rate / flowrate demand"/>
                <Button Classes="ViewPill" Content="Thermal"
                        Classes.active="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Thermal}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Thermal"
                        ToolTip.Tip="Thermomechanical simulation — predicted interlayer temperature per layer"/>
                <Button Classes="ViewPill" Content="Preview"
                        Classes.active="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Preview}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Preview"/>
            </StackPanel>
        </Border>

        <!-- 2D Slice Plane Viewer — per-layer statistics (left side of viewport,
             below the frame/focus buttons so it never covers them) -->
        <Border IsVisible="{Binding ShowSlicePlaneStatsOverlay}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8,52,0,0" ZIndex="16"
                Background="#CC1A1A1A" CornerRadius="6"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                Padding="10,8" MinWidth="228" MaxWidth="290"
                IsHitTestVisible="False">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding SlicePlaneStatsHeader}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}"
                           FontFamily="Consolas,Courier New,monospace"/>
                <Border Height="1" Background="{DynamicResource Border1}" Opacity="0.55"/>
                <TextBlock Text="{Binding SlicePlaneStatsBody}"
                           FontSize="11"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="Consolas,Courier New,monospace"
                           LineHeight="16"
                           Opacity="0.92"/>
                <StackPanel IsVisible="{Binding HasSlicePlaneStatsBelow}">
                    <Border Height="1" Background="{DynamicResource Border1}" Opacity="0.4" Margin="0,2,0,3"/>
                    <TextBlock Text="{Binding SlicePlaneStatsBelow}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               FontFamily="Consolas,Courier New,monospace"
                               LineHeight="14"
                               Opacity="0.88"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cut Tool — interactive floating panel (ghost plane + RGB gizmo in viewport) -->
        <Border IsVisible="{Binding ShowCutToolPanel}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,52,0,0" ZIndex="20"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                CornerRadius="8" Padding="12,10"
                Width="280" MaxHeight="520"
                Opacity="0.96">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <StackPanel Spacing="6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ia:Icon Value="mdi-content-cut" FontSize="15" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Cut Tool" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Classes="ToolbarButton" Padding="4,2"
                                Command="{Binding CancelCutToolCommand}"
                                ToolTip.Tip="Cancel cut tool">
                            <ia:Icon Value="mdi-close" FontSize="13"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding CutToolSession.ModelName}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Classes="LabelMuted" FontSize="10" TextWrapping="Wrap"
                               Text="Drag the gizmo to move / rotate the cut plane. Use Move (G) or Rotate (R) tools."/>

                    <TextBlock Text="CUT PLANE" Classes="SectionHeader" Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="*,90">
                        <TextBlock Text="Height (mm)" VerticalAlignment="Center" Classes="LabelMuted" FontSize="11"
                                   ToolTip.Tip="Offset along the plane normal from world origin"/>
                        <TextBox Grid.Column="1" Classes="PanelTextBox" FontSize="11"
                                 Text="{Binding CutToolSession.Height, Mode=TwoWay}"/>
                    </Grid>

                    <TextBlock Text="Normal" Classes="LabelMuted" FontSize="10" Margin="0,2,0,0"/>
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                            <TextBlock Text="X" FontSize="9" Classes="LabelMuted" Foreground="#E05555"/>
                            <TextBox Classes="PanelTextBox" FontSize="11"
                                     Text="{Binding CutToolSession.NormalX, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="1.5,0">
                            <TextBlock Text="Y" FontSize="9" Classes="LabelMuted" Foreground="#55C055"/>
                            <TextBox Classes="PanelTextBox" FontSize="11"
                                     Text="{Binding CutToolSession.NormalY, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                            <TextBlock Text="Z" FontSize="9" Classes="LabelMuted" Foreground="#5580E0"/>
                            <TextBox Classes="PanelTextBox" FontSize="11"
                                     Text="{Binding CutToolSession.NormalZ, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="XY (Z↑)" Classes="ToolbarButton" Padding="6,3" FontSize="10"
                                Command="{Binding CutToolNormalZCommand}"/>
                        <Button Content="XZ (Y↑)" Classes="ToolbarButton" Padding="6,3" FontSize="10"
                                Command="{Binding CutToolNormalYCommand}"/>
                        <Button Content="YZ (X↑)" Classes="ToolbarButton" Padding="6,3" FontSize="10"
                                Command="{Binding CutToolNormalXCommand}"/>
                    </StackPanel>

                    <CheckBox Content="Place both halves on the cut"
                              IsChecked="{Binding CutToolSession.PlaceOnCut, Mode=TwoWay}"
                              FontSize="11" Margin="0,4,0,0"/>

                    <TextBlock Text="CONNECTORS" Classes="SectionHeader" Margin="0,6,0,0"/>
                    <CheckBox Content="Formbound tabs + bolt lugs"
                              IsChecked="{Binding CutToolSession.AddConnectors, Mode=TwoWay}" FontSize="11"/>

                    <StackPanel IsVisible="{Binding CutToolSession.AddConnectors}" Spacing="4" Margin="0,2,0,0">
                        <Grid ColumnDefinitions="*,80">
                            <TextBlock Text="Spacing" VerticalAlignment="Center" Classes="LabelMuted" FontSize="11"/>
                            <TextBox Grid.Column="1" Classes="PanelTextBox" FontSize="11"
                                     Text="{Binding CutToolSession.ConnectorSpacing, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,80">
                            <TextBlock Text="Tab W / D / H" VerticalAlignment="Center" Classes="LabelMuted" FontSize="11"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <TextBox Classes="PanelTextBox" FontSize="10" Width="24"
                                         Text="{Binding CutToolSession.TabWidth, Mode=TwoWay}"/>
                                <TextBox Classes="PanelTextBox" FontSize="10" Width="24"
                                         Text="{Binding CutToolSession.TabDepth, Mode=TwoWay}"/>
                                <TextBox Classes="PanelTextBox" FontSize="10" Width="24"
                                         Text="{Binding CutToolSession.TabHeight, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,80">
                            <TextBlock Text="Bolt / Lug Ø" VerticalAlignment="Center" Classes="LabelMuted" FontSize="11"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <TextBox Classes="PanelTextBox" FontSize="10" Width="36"
                                         Text="{Binding CutToolSession.BoltDiameter, Mode=TwoWay}"/>
                                <TextBox Classes="PanelTextBox" FontSize="10" Width="36"
                                         Text="{Binding CutToolSession.BoltLugDiameter, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,80">
                            <TextBlock Text="Min corner R" VerticalAlignment="Center" Classes="LabelMuted" FontSize="11"/>
                            <TextBox Grid.Column="1" Classes="PanelTextBox" FontSize="11"
                                     Text="{Binding CutToolSession.MinCornerRadius, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,10,0,0">
                        <Button Content="Cancel" Classes="ToolbarButton" Padding="12,5" FontSize="11"
                                Command="{Binding CancelCutToolCommand}"/>
                        <Button Content="Perform cut" Classes="AccentButton" Padding="12,5" FontSize="11"
                                Command="{Binding PerformCutToolCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Toolpath EDIT menu — left edge of the viewport (inside the panel-clearance
             margin), Preview view only. The pencil expands the tool stack; realtime
             slicing PAUSES while the menu is open (edits accumulate) and the deferred
             re-slice fires when it collapses or when the Reslice button is pressed.
             Brushes: left-drag paints, Alt erases, right-drag resizes. Line tools:
             click one bead line to mark the whole contour as supported (bridge) /
             removed; Alt-click unmarks it. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="8,0,0,0" ZIndex="15"
                Background="#B3222222" CornerRadius="6"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                Padding="3"
                IsVisible="{Binding ViewMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Preview}">
            <StackPanel Orientation="Vertical" Spacing="2">
                <ToggleButton Classes="ToolbarButton" Padding="7"
                              IsChecked="{Binding IsPaintEditOpen, Mode=TwoWay}"
                              Classes.active="{Binding IsPaintEditOpen}"
                              ToolTip.Tip="Edit toolpath — slicing pauses while open; collapsing re-slices with your edits">
                    <ia:Icon Value="mdi-pencil" FontSize="15"/>
                </ToggleButton>
                <!-- 2D Slice Plane Viewer — edit mode only, directly under the pencil. -->
                <ToggleButton Classes="ToolbarButton" Padding="7"
                              IsVisible="{Binding IsPaintEditOpen}"
                              IsChecked="{Binding IsSlicePlaneViewerActive, Mode=TwoWay}"
                              Classes.active="{Binding IsSlicePlaneViewerActive}"
                              ToolTip.Tip="2D Slice Plane Viewer — top-down orthographic; current layer (2× thick), three layers below at 60%/30%/17% opacity, dashed layer above. Only current and the three below are pickable.">
                    <ia:Icon Value="mdi-layers-triple" FontSize="15"/>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- View pie menu (Ctrl+Space) — appears around the pointer -->
        <Grid Background="#01000000" ZIndex="60" IsVisible="{Binding IsViewPieOpen}">
            <Grid.GestureRecognizers/>
            <Button Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding CloseViewPieCommand}"/>
            <Canvas>
                <Canvas Canvas.Left="{Binding ViewPieX}" Canvas.Top="{Binding ViewPieY}">
                    <Canvas Canvas.Left="-150" Canvas.Top="-110" Width="300" Height="220">
                        <Ellipse Canvas.Left="134" Canvas.Top="94" Width="32" Height="32"
                                 Fill="#CC2b2b2b" Stroke="{DynamicResource Accent}" StrokeThickness="1"/>
                <Button Canvas.Left="118" Canvas.Top="0" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Top"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Top"/>
                <Button Canvas.Left="28" Canvas.Top="28" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Iso"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Iso"/>
                <Button Canvas.Left="208" Canvas.Top="28" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Frame"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Frame"/>
                <Button Canvas.Left="0" Canvas.Top="95" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Left"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Left"/>
                <Button Canvas.Left="236" Canvas.Top="95" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Right"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Right"/>
                <Button Canvas.Left="48" Canvas.Top="162" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Back"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Back"/>
                <Button Canvas.Left="188" Canvas.Top="162" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Front"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Front"/>
                <Button Canvas.Left="118" Canvas.Top="190" Width="64" Height="30"
                        Classes="PieButton"
                        Content="Bottom"
                        Command="{Binding SelectViewPresetCommand}"
                        CommandParameter="Bottom"/>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Grid>

        <!-- Slice errors / validation alerts render inline in the bottom status bar. -->

        <!-- N-key HUD — hidden until N; no always-visible tab on the viewport edge. -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,8,0,8"
                    Spacing="6"
                    ZIndex="20"
                    IsVisible="{Binding IsSyncHudOpen}">

            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94">
                <StackPanel Spacing="5">
                    <TextBlock Text="ROBOT LIVE" Classes="LabelMuted" FontSize="10" LetterSpacing="1"/>
                    <TextBlock Text="{Binding MountedToolLabel, StringFormat=Tool: {0}}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock IsVisible="{Binding !IsRobotSynced}"
                               Text="Not synced — press Sync Robot"
                               FontSize="11" Opacity="0.55"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto"
                          IsVisible="{Binding IsRobotSynced}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="A1" Classes="LabelMuted" FontSize="10" Margin="0,0,6,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Robot.A1, StringFormat={}{0:F1}°}" FontSize="11"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="A2" Classes="LabelMuted" FontSize="10" Margin="8,0,6,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Robot.A2, StringFormat={}{0:F1}°}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="A3" Classes="LabelMuted" FontSize="10" Margin="0,0,6,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Robot.A3, StringFormat={}{0:F1}°}" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="E1" Classes="LabelMuted" FontSize="10" Margin="8,0,6,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Robot.E1, StringFormat={}{0:F1}°}" FontSize="11"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="TCP" Classes="LabelMuted" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding Robot.TcpX, StringFormat=X {0:F0}}"
                                   FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94">
                <StackPanel Spacing="5">
                    <TextBlock Text="EXTRUDER" Classes="LabelMuted" FontSize="10" LetterSpacing="1"/>
                    <TextBlock IsVisible="{Binding !IsRobotSynced}"
                               Text="Targets shown when slicing"
                               FontSize="11" Opacity="0.55"/>
                    <StackPanel IsVisible="{Binding IsRobotSynced}" Spacing="2">
                        <TextBlock Text="{Binding AdditiveSettings.Temperature1, StringFormat=Zone 1 target {0:F0} °C}"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding AdditiveSettings.Temperature2, StringFormat=Zone 2 target {0:F0} °C}"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding AdditiveSettings.SelectedPreset.Name, StringFormat=Material: {0}}"
                                   FontSize="11" Opacity="0.75"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94"
                    IsVisible="{Binding !IsToolpathSelected}">
                <StackPanel Spacing="6">
                    <TextBlock Text="VIEW" Classes="LabelMuted" FontSize="10" LetterSpacing="1"/>
                    <Button Padding="8,5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Classes="ToolbarButton"
                            Background="{DynamicResource Bg2}"
                            BorderBrush="{DynamicResource Border1}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Command="{Binding SaveViewCommand}"
                            ToolTip.Tip="Save the current camera angle as this cell's default view. Persists to the cell file, so it's restored next time you (or anyone) opens the app.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ia:Icon Value="mdi-camera-marker-outline" FontSize="14"/>
                            <TextBlock Text="Save View" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94">
                <StackPanel Spacing="6">
                    <TextBlock Text="DEV" Classes="LabelMuted" FontSize="10" LetterSpacing="1"/>
                    <ToggleButton IsChecked="{Binding IsDevMode, Mode=TwoWay}"
                                  Padding="8,5"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="ToolbarButton"
                                  Classes.active="{Binding IsDevMode}"
                                  Background="{DynamicResource Bg2}"
                                  BorderBrush="{DynamicResource Border1}"
                                  BorderThickness="1"
                                  CornerRadius="5"
                                  ToolTip.Tip="Edit cell layout: select print bed, rotary bed, tool stands, or docked tools and move/rotate them.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ia:Icon Value="mdi-wrench-outline" FontSize="14"/>
                            <TextBlock Text="Dev Mode" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock IsVisible="{Binding IsDevMode}"
                               Text="Edit cell layout, or click a tool-change waypoint to edit Global_Points.dat."
                               Classes="LabelMuted"
                               FontSize="10"
                               TextWrapping="Wrap"
                               MaxWidth="240"/>
                    <Button Padding="8,5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Classes="ToolbarButton"
                            Background="{DynamicResource Bg2}"
                            BorderBrush="{DynamicResource Border1}"
                            BorderThickness="1"
                            CornerRadius="5"
                            IsVisible="{Binding IsDevMode}"
                            Command="{Binding SaveAllDevTransformsCommand}"
                            ToolTip.Tip="Write every stand, bed, rotary bed, and dock pose to the cell JSON, then reload.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ia:Icon Value="mdi-content-save-all-outline" FontSize="14"/>
                            <TextBlock Text="Save All Transforms" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="8,5"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Classes="ToolbarButton"
                            Background="{DynamicResource Bg2}"
                            BorderBrush="{DynamicResource Border1}"
                            BorderThickness="1"
                            CornerRadius="5"
                            IsVisible="{Binding IsDevObjectSelected}"
                            Command="{Binding SaveDevTransformCommand}"
                            ToolTip.Tip="Write position and rotation to the cell JSON file.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ia:Icon Value="mdi-content-save-outline" FontSize="14"/>
                            <TextBlock Text="{Binding DevSelectedLabel, StringFormat=Save {0}}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- PLASTICITY — collapsible live bridge to a Plasticity CAD session -->
            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94">
                <Expander Padding="0" IsExpanded="False" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ia:Icon Value="mdi-cube-outline" FontSize="13"/>
                            <TextBlock Text="PLASTICITY" Classes="LabelMuted" FontSize="10" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7" MaxWidth="240"
                                   Text="Enable Plasticity's server, then Connect. With Live link on, edits in Plasticity update here automatically."/>
                        <TextBox Classes="PanelTextBox" Text="{Binding Plasticity.ServerAddress}"
                                 IsEnabled="{Binding Plasticity.IsDisconnected}" Watermark="localhost:8980"/>
                        <Grid ColumnDefinitions="*,6,*">
                            <Button Grid.Column="0" Content="Connect" HorizontalAlignment="Stretch"
                                    IsVisible="{Binding Plasticity.IsDisconnected}" Command="{Binding Plasticity.ConnectCommand}"/>
                            <Button Grid.Column="0" Content="Disconnect" HorizontalAlignment="Stretch"
                                    IsVisible="{Binding Plasticity.IsConnected}" Command="{Binding Plasticity.DisconnectCommand}"/>
                            <Button Grid.Column="2" Content="Refresh" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding Plasticity.IsConnected}" Command="{Binding Plasticity.RefreshCommand}"
                                    ToolTip.Tip="Re-pull all current geometry from Plasticity"/>
                        </Grid>
                        <CheckBox Content="Live link (auto-update)" FontSize="11" IsChecked="{Binding Plasticity.LiveLink}"/>
                        <CheckBox Content="Auto-slice after update"  FontSize="11" IsChecked="{Binding Plasticity.AutoSlice}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Unit scale (→ mm)" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Classes="PanelTextBox" Width="70" Text="{Binding Plasticity.UnitScaleMm}"
                                     ToolTip.Tip="Plasticity works in metres; the slicer in millimetres (default 1000)."/>
                        </Grid>
                        <Button Content="Slice now" HorizontalAlignment="Stretch" Command="{Binding Plasticity.SliceNowCommand}"/>
                        <TextBlock Text="{Binding Plasticity.Status}" TextWrapping="Wrap" FontSize="10" Opacity="0.75" MaxWidth="240"/>
                        <TextBlock Text="{Binding Plasticity.ObjectCount, StringFormat=Linked objects: {0}}" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- MASSIVEBRAIN — MassiveSLICER-hosted sync server for Blender / Rhino addons -->
            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94">
                <Expander Padding="0" IsExpanded="False" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ia:Icon Value="mdi-brain" FontSize="13"/>
                            <TextBlock Text="MASSIVEBRAIN" Classes="LabelMuted" FontSize="10" LetterSpacing="1" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.7" MaxWidth="240"
                                   Text="Server and bridge settings. Enable, then connect the MassiveBRAIN addon in Blender or Rhino — edits there sync into the scene live."/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Enabled" FontSize="11" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MassiveBrain.Enabled, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" Padding="0"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,6,*">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="HOST" Classes="LabelMuted" FontSize="9" LetterSpacing="1"/>
                                <TextBox Classes="PanelTextBox" Text="{Binding MassiveBrain.Host}"
                                         IsEnabled="{Binding !MassiveBrain.Enabled}" Watermark="localhost"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="PORT" Classes="LabelMuted" FontSize="9" LetterSpacing="1"/>
                                <TextBox Classes="PanelTextBox" Text="{Binding MassiveBrain.Port}"
                                         IsEnabled="{Binding !MassiveBrain.Enabled}" Watermark="4547"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Auto-slice after update" FontSize="11" IsChecked="{Binding MassiveBrain.AutoSlice}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Unit scale (→ mm)" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Classes="PanelTextBox" Width="70" Text="{Binding MassiveBrain.UnitScaleMm}"
                                     ToolTip.Tip="Addons send metres on the wire; the slicer works in millimetres (default 1000)."/>
                        </Grid>
                        <TextBlock Text="{Binding MassiveBrain.Status}" TextWrapping="Wrap" FontSize="10" Opacity="0.75" MaxWidth="240"/>
                        <TextBlock FontSize="10" Opacity="0.55">
                            <Run Text="{Binding MassiveBrain.ClientCount, StringFormat=Clients: {0}}"/>
                            <Run Text="   "/>
                            <Run Text="{Binding MassiveBrain.ObjectCount, StringFormat=Synced objects: {0}}"/>
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Background="#E6303030"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,8"
                    Width="268"
                    Opacity="0.94"
                    IsVisible="{Binding IsPrintBedSelected}">
                <StackPanel Spacing="6">
                    <TextBlock Text="PRINT BED GRID" Classes="LabelMuted" FontSize="10" LetterSpacing="1"/>
                    <TextBlock Text="Overall print-area size (mm). Back-left corner stays fixed; edits apply live and save to the cell."
                               Classes="LabelMuted"
                               FontSize="10"
                               TextWrapping="Wrap"
                               MaxWidth="240"/>
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="W" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center"
                                   ToolTip.Tip="Grid width along +X (mm)"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding BedGridWidth, Mode=TwoWay}"
                                       FormatString="F0"
                                       Minimum="1"
                                       Maximum="20000"
                                       Increment="50"
                                       AllowSpin="False"
                                       ShowButtonSpinner="True"
                                       FontSize="11"
                                       Padding="4,2"
                                       VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="D" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                   ToolTip.Tip="Grid depth along +Y (mm)"/>
                        <NumericUpDown Grid.Column="3"
                                       Value="{Binding BedGridDepth, Mode=TwoWay}"
                                       FormatString="F0"
                                       Minimum="1"
                                       Maximum="20000"
                                       Increment="50"
                                       AllowSpin="False"
                                       ShowButtonSpinner="True"
                                       FontSize="11"
                                       Padding="4,2"
                                       VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ERP project attachment — bottom-left dock (mirror of the Live I/O dock) -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="{Binding BottomDockMargin}"
                Background="#E6303030"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,6"
                ZIndex="27"
                ClipToBounds="False">
            <StackPanel Spacing="6">
                <ScrollViewer MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding Erp.IsExpanded}">
                    <local:ErpDockPanelView DataContext="{Binding Erp}"/>
                </ScrollViewer>
                <Button Classes="Lfam3LiveIoToggleBar"
                        Classes.expanded="{Binding Erp.IsExpanded}"
                        Command="{Binding Erp.ToggleExpandedCommand}"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="ERP project attachment — link this workspace to a Project/Lead">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ia:Icon Value="{Binding Erp.ToggleIcon}" FontSize="14" Foreground="#40b840"/>
                        <TextBlock Text="{Binding Erp.ToggleLabel}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#40b840"
                                   LetterSpacing="0.6"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- LFAM 3 workflow timeline — always visible on LFAM 3; minimize via left chevron in bar -->
        <local:SequenceWaypointEditorView DataContext="{Binding SequenceWaypointEditor}"
                                          ZIndex="30"/>

        <!-- Live I/O monitor for LFAM 1/2 (LFAM 3 has it inside the workflow bar).
             Same LiveIo view model — the extruder/milling bridge config is set on
             every cell swap, so the monitor works on any cell. -->
        <Border x:Name="LiveIoDock"
                IsVisible="{Binding ShowStandaloneLiveIo}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="{Binding BottomDockMargin}"
                Background="#E6303030"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,6"
                ZIndex="27"
                ClipToBounds="False">
            <StackPanel Spacing="6">
                <ScrollViewer MaxHeight="620"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding LiveIo.IsExpanded}">
                    <local:Lfam3LiveIoPanelView DataContext="{Binding LiveIo}"/>
                </ScrollViewer>
                <Button Classes="Lfam3LiveIoToggleBar"
                        Classes.expanded="{Binding LiveIo.IsExpanded}"
                        Command="{Binding LiveIo.ToggleExpandedCommand}"
                        HorizontalAlignment="Right"
                        ToolTip.Tip="Live I/O monitor — extruder zones, KUKA I/O, bridge state">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ia:Icon Value="{Binding LiveIo.ToggleIcon}" FontSize="14" Foreground="#40b840"/>
                        <TextBlock Text="{Binding LiveIo.ToggleLabel}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#40b840"
                                   LetterSpacing="0.6"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <local:Lfam3WorkflowTimelineView x:Name="Lfam3WorkflowBar"
                                         IsVisible="{Binding ShowLfam3ToolPicker}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Bottom"
                                         Margin="{Binding Lfam3WorkflowMargin}"
                                         ClipToBounds="False"
                                         ZIndex="26"/>

        <!-- Transform toolbar — top-center: icon tab above the axis-value row -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    ZIndex="14">

            <!-- Icon tab (notch) -->
            <Border HorizontalAlignment="Center"
                    Background="#F2262626"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="ToolbarButton" ToolTip.Tip="Move" Padding="12,4"
                            Classes.active="{Binding IsMoveActive}"
                            Command="{Binding GizmoMoveCommand}">
                        <ia:Icon Value="mdi-cursor-move" FontSize="14"/>
                    </Button>
                    <Button Classes="ToolbarButton" ToolTip.Tip="Rotate" Padding="12,4"
                            Classes.active="{Binding IsRotateActive}"
                            Command="{Binding GizmoRotateCommand}">
                        <ia:Icon Value="mdi-rotate-3d-variant" FontSize="14"/>
                    </Button>
                    <Button Classes="ToolbarButton" ToolTip.Tip="Scale" Padding="12,4"
                            Classes.active="{Binding IsScaleActive}"
                            Command="{Binding GizmoScaleCommand}">
                        <ia:Icon Value="mdi-arrow-expand-all" FontSize="14"/>
                    </Button>
                    <Border Width="1" Background="#3D3D3D" Margin="4,3"/>
                    <Button x:Name="MoveOriginButton" Classes="ToolbarButton" Padding="12,4"
                            Classes.active="{Binding IsMoveOriginActive}"
                            IsEnabled="{Binding HasMeshSelected}"
                            ToolTip.Tip="Move Origin — show the part's bounding box and click a corner, edge midpoint or face centre to put the handle there. The part does not move. Esc to cancel.">
                        <ia:Icon Value="mdi-vector-point" FontSize="14"/>
                    </Button>
                    <Button Classes="ToolbarButton" Padding="12,4"
                            Command="{Binding RecenterCommand}"
                            IsEnabled="{Binding HasMeshSelected}"
                            ToolTip.Tip="Recenter — put the handle at the centre of the part's footprint, at the height of its lowest point (the face that meets the bed). The part does not move.">
                        <ia:Icon Value="mdi-target-variant" FontSize="14"/>
                    </Button>

                    <!-- Placing the part on the plate. Moved here from the top-left focus overlay:
                         these belong with the transform tools, not with the camera controls. -->
                    <Border Width="1" Background="#3D3D3D" Margin="4,3"
                            IsVisible="{Binding !IsToolpathSelected}"/>
                    <Button Classes="ToolbarButton" Padding="12,4"
                            Classes.active="{Binding IsLayFlatMode}"
                            Command="{Binding LayFlatCommand}"
                            IsVisible="{Binding !IsToolpathSelected}"
                            ToolTip.Tip="Lay on Face — click a face to align it flat on the build plate (Esc to cancel)">
                        <ia:Icon Value="mdi-format-vertical-align-bottom" FontSize="14"/>
                    </Button>
                    <Button Classes="ToolbarButton" Padding="12,4"
                            Command="{Binding DropToPlateCommand}"
                            IsVisible="{Binding !IsToolpathSelected}"
                            ToolTip.Tip="Drop to Plate — translate the object down so its lowest point sits on the build plate">
                        <ia:Icon Value="mdi-arrow-collapse-down" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Axis values.
                 x:Name on each row so the code-behind can stop a pointer press reaching the
                 viewport underneath: ViewportView subscribes PointerPressed on itself and calls
                 Focus(), so any press that falls through here steals focus from the field and runs
                 the viewport's own click logic, which deselects on a miss. -->
                <Border x:Name="MoveValuesRow"
                        Background="#F2262626"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,-3,0,0"
                        IsVisible="{Binding IsMoveActive}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X" VerticalAlignment="Center" FontSize="11" Foreground="#E05555" FontWeight="Bold" Margin="0,0,4,0"/>
                        <ctrl:TransformNumberBox Value="{Binding SelectionX}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Position along world X. Accepts maths: 45+90, 90/2, 30x3"/>
                        <TextBlock Text="Y" VerticalAlignment="Center" FontSize="11" Foreground="#44CC55" FontWeight="Bold" Margin="0,0,4,0"/>
                        <ctrl:TransformNumberBox Value="{Binding SelectionY}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Position along world Y. Accepts maths: 45+90, 90/2, 30x3"/>
                        <TextBlock Text="Z" VerticalAlignment="Center" FontSize="11" Foreground="#4477EE" FontWeight="Bold" Margin="0,0,4,0"/>
                        <ctrl:TransformNumberBox Value="{Binding SelectionZ}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0"
                                       ToolTip.Tip="Position along world Z. Accepts maths: 45+90, 90/2, 30x3"/>
                    </StackPanel>
                </Border>
                <Border x:Name="RotateValuesRow"
                        Background="#F2262626"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,-3,0,0"
                        IsVisible="{Binding IsRotateActive}">
                    <StackPanel Orientation="Horizontal">
                        <!-- The axis letters are buttons: click steps a clean additive 90 degrees. -->
                        <Border x:Name="StepAxisX" Tag="0" Background="Transparent" Cursor="Hand"
                                Padding="3,1" Margin="0,0,1,0" CornerRadius="3"
                                ToolTip.Tip="Snap to the next 90° stop about world X — straightens an off-angle part so a flat face sits on the bed. Hold Alt to go the other way.">
                            <TextBlock Text="A" VerticalAlignment="Center" FontSize="11" Foreground="#E05555" FontWeight="Bold"/>
                        </Border>
                        <ctrl:TransformNumberBox Value="{Binding SelectionA}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Rotation about the part's own X axis, in degrees. Accepts maths: 45+90, 90/2, 30x3"/>
                        <Border x:Name="StepAxisY" Tag="1" Background="Transparent" Cursor="Hand"
                                Padding="3,1" Margin="0,0,1,0" CornerRadius="3"
                                ToolTip.Tip="Snap to the next 90° stop about world Y — straightens an off-angle part so a flat face sits on the bed. Hold Alt to go the other way.">
                            <TextBlock Text="B" VerticalAlignment="Center" FontSize="11" Foreground="#44CC55" FontWeight="Bold"/>
                        </Border>
                        <ctrl:TransformNumberBox Value="{Binding SelectionB}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Rotation about the part's own Y axis, in degrees. Accepts maths: 45+90, 90/2, 30x3"/>
                        <Border x:Name="StepAxisZ" Tag="2" Background="Transparent" Cursor="Hand"
                                Padding="3,1" Margin="0,0,1,0" CornerRadius="3"
                                ToolTip.Tip="Snap to the next 90° stop about world Z — straightens an off-angle part so a flat face sits on the bed. Hold Alt to go the other way.">
                            <TextBlock Text="C" VerticalAlignment="Center" FontSize="11" Foreground="#4477EE" FontWeight="Bold"/>
                        </Border>
                        <ctrl:TransformNumberBox Value="{Binding SelectionC}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0"
                                       ToolTip.Tip="Rotation about the part's own Z axis, in degrees. Accepts maths: 45+90, 90/2, 30x3"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ScaleValuesRow"
                        Background="#F2262626"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6"
                        Margin="0,-3,0,0"
                        IsVisible="{Binding IsScaleActive}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Unit toggle: reads as the unit currently in force, click swaps it. -->
                        <Border x:Name="ScaleUnitToggle" Background="#F2161616" Cursor="Hand"
                                BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5"
                                Padding="6,4" Margin="0,0,7,0" MinWidth="34"
                                ToolTip.Tip="Switch between millimetres and percent of the size this part was imported at. In percent, typing 100 puts it back to its original size.">
                            <TextBlock Text="{Binding ScaleUnitLabel}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="11" FontWeight="Bold"
                                       Foreground="#DDDDDD"/>
                        </Border>

                        <TextBlock Text="X" VerticalAlignment="Center" FontSize="11" Foreground="#E05555" FontWeight="Bold" Margin="0,0,4,0"/>
                        <ctrl:TransformNumberBox Value="{Binding ScaleFieldX}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Size along the part's own X. Accepts maths: 1200/2, 300x3"/>
                        <TextBlock Text="Y" VerticalAlignment="Center" FontSize="11" Foreground="#44CC55" FontWeight="Bold" Margin="0,0,4,0"/>
                        <ctrl:TransformNumberBox Value="{Binding ScaleFieldY}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Size along the part's own Y. Accepts maths: 1200/2, 300x3"/>
                        <TextBlock Text="Z" VerticalAlignment="Center" FontSize="11" Foreground="#4477EE" FontWeight="Bold" Margin="0,0,4,0"/>
                        <ctrl:TransformNumberBox Value="{Binding ScaleFieldZ}" FormatString="F2" Width="72" FontSize="11"
                                       Background="#F2161616" BorderBrush="#3D3D3D" CornerRadius="5"
                                       Padding="5,4" VerticalContentAlignment="Center" Margin="0,0,7,0"
                                       ToolTip.Tip="Size along the part's own Z. Accepts maths: 1200/2, 300x3"/>

                        <!-- Chain: on, editing any axis rescales the other two by the same ratio. -->
                        <Border x:Name="ScaleChainToggle" Cursor="Hand"
                                Background="#F2161616" BorderBrush="#3D3D3D" BorderThickness="1"
                                CornerRadius="5" Padding="6,4" Margin="0,0,7,0"
                                ToolTip.Tip="Keep the part in proportion. On, changing one axis rescales the other two by the same ratio — halving 100 to 50 also takes 1300 down to 650. Off, each axis moves on its own.">
                            <Panel>
                                <ia:Icon Value="mdi-link-variant" FontSize="14" Foreground="#4EA8DE"
                                         IsVisible="{Binding IsScaleChained}"/>
                                <ia:Icon Value="mdi-link-variant-off" FontSize="14" Foreground="#777777"
                                         IsVisible="{Binding IsScaleChained, Converter={StaticResource NotCvt}}"/>
                            </Panel>
                        </Border>

                        <Border Width="1" Background="#3D3D3D" Margin="0,2,7,2"/>

                        <!-- Contextual to Scale mode, per the spec: these two live here rather than
                             in the always-visible toolbar, because they mean nothing in Move or Rotate. -->
                        <Border x:Name="FitToCellButton" Cursor="Hand"
                                Background="#F2161616" BorderBrush="#3D3D3D" BorderThickness="1"
                                CornerRadius="5" Padding="8,4" Margin="0,0,7,0"
                                ToolTip.Tip="Scale the part up or down uniformly until it just fits the bed, with room to spare. Stops at whichever axis runs out first.">
                            <TextBlock Text="Fit to Cell" VerticalAlignment="Center" FontSize="11" Foreground="#DDDDDD"/>
                        </Border>
                        <Border x:Name="ResetScaleButton" Cursor="Hand"
                                Background="#F2161616" BorderBrush="#3D3D3D" BorderThickness="1"
                                CornerRadius="5" Padding="8,4" Margin="0"
                                ToolTip.Tip="Put the part back to the size it was imported at.">
                            <TextBlock Text="Reset Scale" VerticalAlignment="Center" FontSize="11" Foreground="#DDDDDD"/>
                        </Border>
                    </StackPanel>
                </Border>
        </StackPanel>

        <!-- Focus overlay — top-left, visible only when an object is selected -->
        <Border IsVisible="{Binding HasSelection}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,8,8,8"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="4">
            <StackPanel Orientation="Horizontal">
                <!-- Lay on Face and Drop to Plate used to live here; they moved into the transform
                     toolbar next to Recenter, which is where the rest of the placing tools are. -->
                <!-- Other tools: camera + mesh structure -->
                <Button Classes="ToolbarButton" Padding="6"
                        Command="{Binding FrameAllCommand}"
                        ToolTip.Tip="Frame All — fit the whole scene in view">
                    <ia:Icon Value="mdi-fit-to-screen-outline" FontSize="14"/>
                </Button>
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        Command="{Binding FocusCommand}"
                        ToolTip.Tip="Focus camera on selected object (F)">
                    <ia:Icon Value="mdi-image-filter-center-focus" FontSize="14"/>
                </Button>
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        Margin="2,0,0,0"
                        Command="{Binding UngroupCommand}"
                        IsVisible="{Binding !IsToolpathSelected}"
                        ToolTip.Tip="Ungroup — split a grouped import into separate top-level objects (e.g. OBJ with multiple parts)">
                    <ia:Icon Value="mdi-ungroup" FontSize="14"/>
                </Button>
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        Margin="2,0,0,0"
                        Command="{Binding ExplodeCommand}"
                        IsVisible="{Binding !IsToolpathSelected}"
                        ToolTip.Tip="Explode — split disconnected mesh shells into separate objects. Use when Ungroup is not enough (e.g. multi-body STL)">
                    <ia:Icon Value="mdi-scatter-plot" FontSize="14"/>
                </Button>
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        Margin="2,0,0,0"
                        Command="{Binding MeshCleanupCommand}"
                        IsVisible="{Binding !IsToolpathSelected}"
                        ToolTip.Tip="Mesh Cleanup — repair common mesh problems (duplicate faces, welded vertices, degenerate polygons) before slicing">
                    <ia:Icon Value="mdi-broom" FontSize="14"/>
                </Button>
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        Margin="2,0,0,0"
                        Command="{Binding CutToolCommand}"
                        IsVisible="{Binding !IsToolpathSelected}"
                        IsEnabled="{Binding CanCutTool}"
                        ToolTip.Tip="Cut Tool — split model into two halves with Formbound alignment tabs and bolt lugs along the cut perimeter">
                    <ia:Icon Value="mdi-content-cut" FontSize="14"/>
                </Button>

                <Border Width="1" Background="{DynamicResource Border1}" Margin="4,2"
                        IsVisible="{Binding !IsToolpathSelected}"/>

                <!-- Data visualizer: toolpath display layers (visible for toolpaths) -->
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        IsVisible="{Binding IsToolpathSelected}"
                        ToolTip.Tip="Data visualizer — toggle toolpath display layers">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ia:Icon Value="mdi-chart-scatter-plot" FontSize="14" VerticalAlignment="Center"/>
                        <ia:Icon Value="mdi-chevron-down" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="200" Spacing="6">
                                <TextBlock Text="DATA VISUALIZER" Classes="LabelMuted" FontSize="10" LetterSpacing="1" Margin="2,0,0,2"/>
                                <CheckBox Content="Extrusion lines" FontSize="11"
                                          IsChecked="{Binding ShowExtrusionMoves, Mode=TwoWay}"
                                          ToolTip.Tip="Print moves as coloured lines (Speed/RPM views recolour them)"/>
                                <CheckBox Content="Travel moves" FontSize="11"
                                          IsChecked="{Binding ShowTravelMoves, Mode=TwoWay}"
                                          ToolTip.Tip="Rapid repositioning moves"/>
                                <CheckBox Content="Wipe moves" FontSize="11"
                                          IsChecked="{Binding ShowWipeMoves, Mode=TwoWay}"
                                          ToolTip.Tip="Pre-travel filament wipe extrusions — separate from the main toolpath lines"/>
                                <CheckBox Content="Formbound bridges" FontSize="11"
                                          IsChecked="{Binding ShowLightningMoves, Mode=TwoWay}"
                                          ToolTip.Tip="Formbound Bridge / Buttress support (orange) — uncheck Extrusion lines to isolate them"/>
                                <CheckBox Content="Seam points" FontSize="11"
                                          IsChecked="{Binding ShowSeam, Mode=TwoWay}"
                                          ToolTip.Tip="Layer seam locations"/>
                                <CheckBox Content="Bead surface" FontSize="11"
                                          IsChecked="{Binding ShowBead, Mode=TwoWay}"
                                          ToolTip.Tip="Solid extruded-bead preview (printed-part look)"/>
                                <CheckBox Content="Bead overhang heatmap" FontSize="11"
                                          IsChecked="{Binding ShowBeadOverhang, Mode=TwoWay}"
                                          ToolTip.Tip="Bead colored by overhang percentage (see legend)"/>
                                <CheckBox Content="Orientation preview" FontSize="11"
                                          IsChecked="{Binding ShowOrientationPreview, Mode=TwoWay}"
                                          ToolTip.Tip="Bead colored by tool orientation change rate"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Material options: view channels + exposure/reflection adjust -->
                <Button Classes="ToolbarButton"
                        Padding="6,4"
                        IsVisible="{Binding !IsToolpathSelected}"
                        ToolTip.Tip="Material — view channels and render adjustments">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ia:Icon Value="mdi-palette" FontSize="14" VerticalAlignment="Center"/>
                        <ia:Icon Value="mdi-chevron-down" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="210" Spacing="3">
                                <TextBlock Text="VIEW CHANNEL" Classes="LabelMuted" FontSize="10" LetterSpacing="1" Margin="2,0,0,2"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Final Render"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Standard}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="Standard"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Base Color"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=BaseColor}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="BaseColor"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Metalness"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Metalness}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="Metalness"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Roughness"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Roughness}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="Roughness"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Normal"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=NormalMap}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="NormalMap"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="AO"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=AO}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="AO"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Emission"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Emission}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="Emission"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="UV Checker"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=UvChecker}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="UvChecker"/>
                                <Button Classes="ToolbarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="Wireframe"
                                        Classes.active="{Binding ActiveShaderMode, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Wireframe}"
                                        Command="{Binding SetShaderModeCommand}" CommandParameter="Wireframe"
                                        ToolTip.Tip="Flat-shaded polygonal mesh with wireframe overlay"/>

                                <Border Height="1" Background="{DynamicResource Border1}" Margin="0,5"/>
                                <TextBlock Text="ADJUST" Classes="LabelMuted" FontSize="10" LetterSpacing="1" Margin="2,0,0,2"/>
                                <TextBlock Text="Exposure" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <Slider Minimum="0.4" Maximum="2.5" Value="{Binding Exposure, Mode=TwoWay}"
                                        ToolTip.Tip="Final-render exposure (pre-tonemap)"/>
                                <TextBlock Text="Reflections" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                <Slider Minimum="0" Maximum="3" Value="{Binding IblIntensity, Mode=TwoWay}"
                                        ToolTip.Tip="Environment reflection / IBL gain"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>

        <!-- Toolpath stats — top-right, below the view pills -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,58,0,8"
                    Spacing="6"
                    ZIndex="32">
            <!-- Toolpath stats -->
            <Border IsVisible="{Binding ShowToolpathStatsOverlay}"
                    Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Opacity="0.88"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Time"     Classes="LabelMuted" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StatsTime}"   Classes="Readout" FontSize="11"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Material" Classes="LabelMuted" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StatsWeight}" Classes="Readout" FontSize="11" Margin="0,4,0,0"/>
            </Grid>
            </Border>

            <!-- Cost — collapsed by default so it never shows on screen shares / client demos -->
            <Border IsVisible="{Binding ShowToolpathStatsOverlay}"
                    Background="{DynamicResource Bg2}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Opacity="0.88"
                    Padding="6,4"
                    HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Name="CostReveal"
                                  Padding="6,2"
                                  Classes="ToolbarButton"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip.Tip="Show/hide the estimated cost. Kept collapsed so pricing never appears on the viewport by default.">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ia:Icon Value="mdi-currency-usd" FontSize="12"/>
                            <TextBlock Text="Cost" FontSize="11" VerticalAlignment="Center" Classes="LabelMuted"/>
                            <ia:Icon Value="mdi-chevron-right" FontSize="12"
                                     IsVisible="{Binding !#CostReveal.IsChecked}"/>
                            <ia:Icon Value="mdi-chevron-down" FontSize="12"
                                     IsVisible="{Binding #CostReveal.IsChecked}"/>
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Text="{Binding StatsCost}" Classes="Readout" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"
                               IsVisible="{Binding #CostReveal.IsChecked}"/>
                </StackPanel>
            </Border>

            <!-- Multi-Planar: show/hide the guide plane quads. Hidden in edit mode —
                 the bottom toolbar already has the same Planes control. -->
            <Border IsVisible="{Binding ShowMultiPlanarPlanesButton, FallbackValue=False}"
                    Background="#B3222222" CornerRadius="6"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                    Padding="3" HorizontalAlignment="Right">
                <ToggleButton Classes="ToolbarButton" Padding="8,4" FontSize="11"
                              IsChecked="{Binding ShowMultiPlanarPlanes, Mode=TwoWay}"
                              Classes.active="{Binding ShowMultiPlanarPlanes}"
                              ToolTip.Tip="Show/hide the Multi-Planar guide planes (the distortion spine stays visible)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ia:Icon Value="mdi-layers-outline" FontSize="13"/>
                        <TextBlock Text="Planes" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </Border>
        </StackPanel>

        <!-- Seam guide point list — left side while editor is open -->
        <Border IsVisible="{Binding IsSeamGuideLayerOpen}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="8,8,8,72"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8,6"
                MaxHeight="220"
                ZIndex="31">
            <StackPanel Spacing="4">
                <TextBlock Text="GUIDE POINTS" Classes="LabelMuted" FontSize="10" LetterSpacing="1"/>
                <TextBlock Text="Click a point to select. Drag in the viewport to move."
                           Classes="LabelMuted" FontSize="10" TextWrapping="Wrap" MaxWidth="200"/>
                <ListBox ItemsSource="{Binding SeamGuideDraft}"
                         SelectedIndex="{Binding SelectedSeamGuideIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="140"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11">
                                <Run Text="Point"/>
                                <Run Text="{Binding X, StringFormat={}{0:F0}}"/><Run Text=","/>
                                <Run Text="{Binding Y, StringFormat={}{0:F0}}"/><Run Text=","/>
                                <Run Text="{Binding Z, StringFormat={}{0:F0}}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Seam guide editor toolbar -->
        <Border IsVisible="{Binding IsSeamEditorActive}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="8"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8,6"
                ZIndex="30">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Select seam locations"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Add point"
                            Classes="ToolbarButton"
                            Classes.active="{Binding IsSeamAddPointActive}"
                            Padding="10,4"
                            Command="{Binding SeamEditorAddPointCommand}"
                            ToolTip.Tip="Click the bed or a model surface to place a guide"/>
                    <Button Content="Select / move"
                            Classes="ToolbarButton"
                            Classes.active="{Binding IsSeamSelectPointActive}"
                            Padding="10,4"
                            Command="{Binding SeamEditorSelectPointCommand}"
                            ToolTip.Tip="Click a guide sphere to select and drag it"/>
                    <Button Classes="ToolbarButton" Padding="8,4"
                            Command="{Binding ToggleSeamGuideLayerCommand}"
                            IsVisible="{Binding HasSeamGuideDraft}"
                            ToolTip.Tip="Show or hide the list of placed guide points">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ia:Icon Value="mdi-layers-triple" FontSize="14"/>
                            <TextBlock Text="{Binding SeamGuideLayerLabel}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Add edge" Classes="ToolbarButton" Padding="10,4" IsEnabled="False"
                            ToolTip.Tip="Coming soon"/>
                    <Button Content="Draw line" Classes="ToolbarButton" Padding="10,4" IsEnabled="False"
                            ToolTip.Tip="Coming soon"/>
                    <Button Classes="ToolbarButton" Padding="8,4"
                            Command="{Binding SeamEditorDeleteCommand}"
                            ToolTip.Tip="Delete the selected guide point (or the last one)">
                        <ia:Icon Value="mdi-delete-outline" FontSize="14"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="Cancel" Classes="ToolbarButton" Padding="12,4"
                            Command="{Binding SeamEditorCancelCommand}"/>
                    <Button Content="Save" Classes="PrimaryButton" Padding="12,4"
                            Command="{Binding SeamEditorSaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Curved boundary editor toolbar -->
        <Border IsVisible="{Binding IsBoundaryEditorActive}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="8"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8,6"
                ZIndex="30">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Curved boundaries (Sweep)"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="LOW ring"
                            Classes="ToolbarButton"
                            Classes.active="{Binding IsBoundaryLowTarget}"
                            Padding="10,4"
                            Command="{Binding BoundaryEditorLowTargetCommand}"
                            ToolTip.Tip="Click mesh to set/grow the LOW (start) boundary ring"/>
                    <Button Content="HIGH ring"
                            Classes="ToolbarButton"
                            Classes.active="{Binding IsBoundaryHighTarget}"
                            Padding="10,4"
                            Command="{Binding BoundaryEditorHighTargetCommand}"
                            ToolTip.Tip="Click mesh to set/grow the HIGH (end) boundary ring"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="Cancel" Classes="ToolbarButton" Padding="12,4"
                            Command="{Binding BoundaryEditorCancelCommand}"/>
                    <Button Content="Save" Classes="PrimaryButton" Padding="12,4"
                            Command="{Binding BoundaryEditorSaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Merge toolpaths — bottom-center, visible when 2+ toolpaths shift-selected -->
        <Button IsVisible="{Binding CanMergeToolpaths}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="8,8,8,90"
                Padding="12,6"
                Classes="PrimaryButton"
                ZIndex="25"
                Command="{Binding MergeToolpathsCommand}"
                ToolTip.Tip="Print the selected objects one after another: each toolpath completes, retracts, and travels to the next (selection order = print order)">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ia:Icon Value="mdi-vector-combine" FontSize="14"/>
                <TextBlock Text="Create Toolpath Sequence" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Speed/RPM value tags — projected beside the toolpath every 6 inches of height -->
        <ItemsControl IsVisible="{Binding ShowViewTags}"
                      ItemsSource="{Binding ViewTags}"
                      IsHitTestVisible="False"
                      ZIndex="18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:ViewportViewModel+ViewTag">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ViewportViewModel+ViewTag">
                    <Border Background="#D0262626"
                            BorderBrush="{DynamicResource Border1}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2">
                        <TextBlock Text="{Binding Text}" FontSize="10"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Simulate timeline — bottom-center, Toolpath view (hidden when the
             full playback card for a selected toolpath is showing) -->
        <Border x:Name="SimTimelineBar"
                IsVisible="{Binding ShowSimTimeline}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"
                Width="440"
                Background="#E6303030"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5"
                ZIndex="24">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                <Button Grid.Column="0" Classes="ToolbarButton" Padding="6,4" Margin="0,0,2,0"
                        Command="{Binding SimResetCommand}"
                        ToolTip.Tip="Reset simulation to 0%">
                    <ia:Icon Value="mdi-restore" FontSize="15"/>
                </Button>
                <Button Grid.Column="1" Classes="ToolbarButton" Padding="6,4" Margin="0,0,8,0"
                        Command="{Binding SimPlayPauseCommand}"
                        ToolTip.Tip="Simulate the full toolpath (6 s)">
                    <Panel>
                        <ia:Icon Value="mdi-play"  FontSize="15" IsVisible="{Binding !SimPlaying}"/>
                        <ia:Icon Value="mdi-pause" FontSize="15" IsVisible="{Binding SimPlaying}"/>
                    </Panel>
                </Button>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Slider x:Name="SimTimelineSlider" Classes="ScrubSlider"
                            Minimum="0" Maximum="100"
                            VerticalAlignment="Center"
                            DoubleTapped="OnSimTimelineSliderDoubleTapped"
                            Value="{Binding SimTimelinePercent, Mode=TwoWay}"/>
                    <!-- Camera keyframe markers — cyan ticks -->
                    <ctrl:ScrubMarkerBar Markers="{Binding SimCameraKeyframeMarkers}"
                                         MarkerBrush="#55C8E8"
                                         Height="10" VerticalAlignment="Center"
                                         IsHitTestVisible="False"/>
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding SimTimelineLabel}"
                           Classes="Readout" FontSize="11" Width="38"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Grid.Column="4" Classes="ToolbarButton" Padding="6,4" Margin="6,0,0,0"
                        Command="{Binding AddSimCameraKeyframeCommand}"
                        ToolTip.Tip="Keyframe the current camera at this timeline position (double-clicking the slider does the same). Play or export flies the view between keyframes.">
                    <ia:Icon Value="mdi-plus" FontSize="15"/>
                </Button>
                <Button Grid.Column="5" Classes="ToolbarButton" Padding="6,4" Margin="2,0,0,0"
                        IsVisible="{Binding HasSimCameraKeyframes}"
                        Command="{Binding ClearSimCameraKeyframesCommand}"
                        ToolTip.Tip="Clear all camera keyframes">
                    <ia:Icon Value="mdi-camera-off-outline" FontSize="15"/>
                </Button>
                <Button Grid.Column="6" Classes="ToolbarButton" Padding="6,4" Margin="6,0,0,0"
                        Command="{Binding SimExportVideoCommand}"
                        IsEnabled="{Binding !SimRecording}"
                        ToolTip.Tip="Download the 6-second simulation as an MP4 video (camera keyframes animate the view)">
                    <ia:Icon Value="mdi-download" FontSize="15"/>
                </Button>
            </Grid>
        </Border>

        <!-- Edit-mode selection toolbar — sits above the timeline. Hand = navigate,
             pointer = click-a-path select (shift accumulates), box = marquee select.
             Filter narrows what is pickable; Support / Remove apply marks to every
             selected path (slicing stays paused until Reslice / collapse). -->
        <Border IsVisible="{Binding IsPaintEditOpen}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,86" ZIndex="16"
                Background="#D9191919" CornerRadius="8"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton Classes="ToolbarButton" Padding="7"
                              IsChecked="{Binding PaintHandActive, Mode=TwoWay}"
                              Classes.active="{Binding PaintHandActive}"
                              ToolTip.Tip="Navigate — clicks do nothing, camera as normal">
                    <ia:Icon Value="mdi-hand-back-right-outline" FontSize="15"/>
                </ToggleButton>
                <Button Classes="ToolbarButton" Padding="7"
                        Command="{Binding SelectPathToolCommand}"
                        Classes.active="{Binding PaintPathSelectActive}"
                        ToolTip.Tip="Select — click to select; Shift adds more">
                    <ia:Icon Value="mdi-cursor-default-outline" FontSize="15"/>
                </Button>
                <!-- Region select: click arms tool; long-press toggles Square ↔ Lasso -->
                <ToggleButton x:Name="RegionSelectButton" Classes="ToolbarButton" Padding="7"
                              IsChecked="{Binding PaintBoxSelectActive, Mode=TwoWay}"
                              Classes.active="{Binding PaintBoxSelectActive}"
                              ToolTip.Tip="{Binding PaintRegionSelectToolTip}">
                    <ia:Icon Value="{Binding PaintRegionSelectIcon}" FontSize="15"/>
                </ToggleButton>

                <Border Width="1" Height="20" Background="{DynamicResource Border1}" Margin="2,0"/>

                <Button Classes="ToolbarButton" Padding="7"
                        Command="{Binding SetPathGranularityCommand}"
                        Classes.active="{Binding PaintPathGranularityActive}"
                        ToolTip.Tip="Lines — select path sections; viewport switches to centre-line only (no beads)">
                    <ia:Icon Value="mdi-chart-timeline-variant" FontSize="15"/>
                </Button>
                <Button Classes="ToolbarButton" Padding="7"
                        Command="{Binding SetPointGranularityCommand}"
                        Classes.active="{Binding PaintPointGranularityActive}"
                        ToolTip.Tip="Points — select a single bead; lines gray out and seam points stand out">
                    <ia:Icon Value="mdi-dots-hexagon" FontSize="15"/>
                </Button>

                <Border Width="1" Height="20" Background="{DynamicResource Border1}" Margin="2,0"/>

                <ia:Icon Value="mdi-filter-variant" FontSize="15" Foreground="White"
                         VerticalAlignment="Center"
                         ToolTip.Tip="Filter selection — what hover / click / box may pick"/>
                <ComboBox ItemsSource="{Binding PaintPickFilterOptions}"
                          SelectedItem="{Binding PaintPickFilter, Mode=TwoWay}"
                          MinWidth="104" FontSize="11" VerticalAlignment="Center"
                          ToolTip.Tip="Filter selection — what hover / click / box may pick"/>

                <Border Width="1" Height="20" Background="{DynamicResource Border1}" Margin="2,0"/>

                <!-- Selection count → popup list of layers/paths with per-item deselect -->
                <Button Classes="ToolbarButton" Padding="10,5" FontSize="11"
                        Content="{Binding PaintSelectionLabel}"
                        MinWidth="108"
                        IsEnabled="{Binding HasPaintSelection}"
                        ToolTip.Tip="Show selected paths / points — remove one from the list">
                    <Button.Flyout>
                        <Flyout Placement="Top" ShowMode="Standard">
                            <Border Background="{DynamicResource Bg2}"
                                    BorderBrush="{DynamicResource Border1}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,8,8,6"
                                    MinWidth="280" MaxWidth="360"
                                    MaxHeight="300">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,8"
                                          ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="Selection"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="ToolbarButton"
                                                Padding="8,3" FontSize="10"
                                                Content="Clear all"
                                                Command="{Binding DeselectPaintCommand}"
                                                ToolTip.Tip="Deselect everything"/>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="240">
                                        <ItemsControl ItemsSource="{Binding PaintSelectionItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PaintSelectionListItem">
                                                    <Border Background="{DynamicResource Bg3}"
                                                            CornerRadius="5"
                                                            Padding="8,5"
                                                            Margin="0,0,0,4"
                                                            BorderBrush="{DynamicResource Border1}"
                                                            BorderThickness="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0"
                                                                        Spacing="1"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding Detail}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           FontFamily="Consolas,Courier New,monospace"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Classes="ToolbarButton"
                                                                    Padding="6"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding RemoveCommand}"
                                                                    ToolTip.Tip="Deselect this item">
                                                                <ia:Icon Value="mdi-close" FontSize="13"
                                                                         Foreground="#ff8a8a"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="ToolbarButton" Padding="10,5" FontSize="11" Content="Deselect"
                        Command="{Binding DeselectPaintCommand}"
                        ToolTip.Tip="Deselect all"/>
                <Button Classes="ToolbarButton" Padding="10,5" FontSize="11" Content="Support"
                        Command="{Binding ApplySupportSelectionCommand}"
                        ToolTip.Tip="Mark every selected path for Formbound support"/>
                <Button Classes="ToolbarButton" Padding="10,5" FontSize="11" Content="Remove"
                        Command="{Binding ApplyRemoveSelectionCommand}"
                        ToolTip.Tip="Delete every selected path from the toolpath"/>

                <Border Width="1" Height="20" Background="{DynamicResource Border1}" Margin="2,0"/>

                <!-- Visibility menu: seams, toolpaths, travel, paint markers, beads… -->
                <Button Classes="ToolbarButton" Padding="7"
                        ToolTip.Tip="Visibility — seams, toolpaths, travel moves, paint markers, bead mesh…">
                    <ia:Icon Value="mdi-eye-outline" FontSize="15"/>
                    <Button.Flyout>
                        <Flyout Placement="Top" ShowMode="Standard">
                            <Border Background="{DynamicResource Bg2}"
                                    BorderBrush="{DynamicResource Border1}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    MinWidth="210">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="VISIBILITY"
                                               Classes="LabelMuted"
                                               FontSize="10"
                                               LetterSpacing="1"
                                               Margin="2,0,0,2"/>
                                    <CheckBox Content="Toolpaths"
                                              FontSize="11"
                                              IsChecked="{Binding ShowExtrusionMoves, Mode=TwoWay}"
                                              ToolTip.Tip="Print / extrusion centre-lines"/>
                                    <CheckBox Content="Travel moves"
                                              FontSize="11"
                                              IsChecked="{Binding ShowTravelMoves, Mode=TwoWay}"
                                              ToolTip.Tip="Rapid repositioning moves"/>
                                    <CheckBox Content="Wipe moves"
                                              FontSize="11"
                                              IsChecked="{Binding ShowWipeMoves, Mode=TwoWay}"
                                              ToolTip.Tip="Pre-travel filament wipe extrusions — separate from the main toolpath lines"/>
                                    <CheckBox Content="Formbound bridges"
                                              FontSize="11"
                                              IsChecked="{Binding ShowLightningMoves, Mode=TwoWay}"
                                              ToolTip.Tip="Formbound Bridge / Buttress support (orange)"/>
                                    <CheckBox Content="Seam points"
                                              FontSize="11"
                                              IsChecked="{Binding ShowSeam, Mode=TwoWay}"
                                              ToolTip.Tip="Layer seam start locations"/>
                                    <CheckBox Content="Paint markers"
                                              FontSize="11"
                                              IsChecked="{Binding ShowPaintMarkers, Mode=TwoWay}"
                                              ToolTip.Tip="Support / Remove paint dabs"/>
                                    <CheckBox Content="Bead mesh"
                                              FontSize="11"
                                              IsChecked="{Binding PaintShowBeads, Mode=TwoWay}"
                                              ToolTip.Tip="Solid extruded-bead preview"/>

                                    <!-- 2D slice ghost layers — separated from the on/off toggles -->
                                    <Border Height="1" Background="{DynamicResource Border1}" Margin="0,4,0,2"/>
                                    <TextBlock Text="2D SLICE GHOST LAYERS"
                                               Classes="LabelMuted" FontSize="10"
                                               LetterSpacing="1" Margin="2,0,0,0"/>
                                    <Grid ColumnDefinitions="*,26">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="10"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding SlicePlaneGhostLayers, Mode=TwoWay}"
                                                Margin="0,0,6,0" VerticalAlignment="Center"
                                                ToolTip.Tip="How many layers below the current slice fade in as ghosts (default 3)"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="11" TextAlignment="Right"
                                                   Text="{Binding SlicePlaneGhostLayers}"/>
                                    </Grid>
                                    <CheckBox Content="All layer lines"
                                              FontSize="11"
                                              IsChecked="{Binding SlicePlaneShowAllGhosts, Mode=TwoWay}"
                                              ToolTip.Tip="Additionally draw EVERY layer below, very faint — the whole part's line history under the ghost band"/>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Border Width="1" Height="20" Background="{DynamicResource Border1}" Margin="2,0"/>

                <Button Classes="ToolbarButton" Padding="7"
                        Command="{Binding AdditiveSettings.ClearPaintMarksCommand}"
                        ToolTip.Tip="Clear all painted marks">
                    <ia:Icon Value="mdi-broom" FontSize="15"/>
                </Button>
                <Button Classes="ToolbarButton" Padding="7"
                        Command="{Binding ReslicePaintCommand}"
                        ToolTip.Tip="Re-slice now with the accumulated edits">
                    <ia:Icon Value="mdi-refresh" FontSize="15"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Edit-mode LAYERS window — dual handle only. Double-click a thumb to type.
             Width is ~55% of the prior 92px panel (45% thinner). -->
        <Border IsVisible="{Binding IsPaintEditOpen}"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Margin="0,64,6,150" ZIndex="16"
                Background="{DynamicResource Bg2}" CornerRadius="10"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                Padding="6,8"
                Opacity="0.96">
            <Grid RowDefinitions="Auto,*" Width="50">
                <TextBlock Grid.Row="0" Text="LAYERS" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" LetterSpacing="0.5" Margin="0,0,0,6"
                           ToolTip.Tip="Drag handles to isolate a layer window (full slice stays 1…N). Double-click a handle to type a layer number."/>
                <ctl:DualRangeSlider Grid.Row="1" MinWidth="48"
                          Minimum="1"
                          Maximum="{Binding ToolpathScrubLayerCount}"
                          HighValue="{Binding ToolpathScrubLayerHigh, Mode=TwoWay}"
                          LowValue="{Binding ToolpathScrubLayerLow, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Square marquee -->
        <Canvas IsVisible="{Binding PaintMarqueeVisible}" ZIndex="40" IsHitTestVisible="False">
            <Border Canvas.Left="{Binding PaintMarqueeX}" Canvas.Top="{Binding PaintMarqueeY}"
                    Width="{Binding PaintMarqueeW}" Height="{Binding PaintMarqueeH}"
                    BorderBrush="#80B7FF" BorderThickness="1" Background="#2280B7FF"/>
        </Canvas>

        <!-- Lasso freehand path (Avalonia 12: StrokeJoin, not StrokeLineJoin) -->
        <Canvas IsVisible="{Binding PaintLassoVisible}" ZIndex="40" IsHitTestVisible="False">
            <Polyline Points="{Binding PaintLassoPoints}"
                      Stroke="#80B7FF" StrokeThickness="1.5"
                      Fill="#2280B7FF"
                      StrokeJoin="Round" StrokeLineCap="Round"/>
        </Canvas>

        <!-- Horizontal timeline — Preview view only, while a scrub session is live
             (stays up when the TCP is selected for keyframe adjustments) -->
        <Border x:Name="PlaybackTimelineBar"
                IsVisible="{Binding ShowPlaybackTimeline}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Margin="8"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="6,4">
            <StackPanel Spacing="4">

                <!-- Scrubber row: play controls | track | counter -->
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Play / pause + speed -->
                    <StackPanel x:Name="ScrubPlayControls" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Classes="ToolbarButton"
                                IsEnabled="{Binding !IsValidating}"
                                Command="{Binding TogglePlaybackCommand}"
                                ToolTip.Tip="Play / pause simulation (Space)"
                                Padding="6,4">
                            <Panel>
                                <ia:Icon Value="mdi-play"  FontSize="16" IsVisible="{Binding !IsPlaying}"/>
                                <ia:Icon Value="mdi-pause" FontSize="16" IsVisible="{Binding IsPlaying}"/>
                            </Panel>
                        </Button>
                        <ComboBox ItemsSource="{Binding PlaybackSpeedOptions}"
                                  SelectedItem="{Binding PlaybackSpeedOption, Mode=TwoWay}"
                                  FontSize="11"
                                  Width="64"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Playback speed"/>
                        <Button Classes="ToolbarButton" Padding="6,4"
                                Command="{Binding AddTcpKeyframeCommand}"
                                ToolTip.Tip="Add a TCP keyframe at this moment — drag the TCP first (or click to pin the nominal position). The offset eases in/out over nearby moves.">
                            <ia:Icon Value="mdi-key-plus" FontSize="15"/>
                        </Button>
                        <Button Classes="ToolbarButton" Padding="6,4"
                                IsVisible="{Binding HasTcpKeyframes}"
                                Command="{Binding ClearTcpKeyframesCommand}"
                                ToolTip.Tip="Clear all TCP keyframes and restore the original toolpath">
                            <ia:Icon Value="mdi-key-remove" FontSize="15"/>
                        </Button>
                        <TextBlock Text="{Binding ToolpathScrubSpeedRpmLabel}"
                                   Classes="Readout"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   MinWidth="110"
                                   IsVisible="{Binding ToolpathScrubSpeedRpmLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   ToolTip.Tip="Linear speed and extruder RPM of the current move — the same $VEL.CP and $ANOUT[4] values the KRL export writes"/>
                    </StackPanel>

                    <!-- Horizontal scrubber track -->
                    <Grid Grid.Column="1" x:Name="ScrubTrackGrid" VerticalAlignment="Center">
                        <Slider Classes="ScrubSlider"
                                Orientation="Horizontal"
                                Minimum="0"
                                Maximum="{Binding ToolpathScrubMax}"
                                Value="{Binding ToolpathScrubIndex}"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"/>
                        <!-- Unreachable move markers — red ticks, single draw call -->
                        <ctrl:ScrubMarkerBar Markers="{Binding ScrubUnreachableMarkers}"
                                             MarkerBrush="#CC3030"
                                             Height="6" VerticalAlignment="Center"
                                             IsHitTestVisible="False"/>
                        <!-- Singularity markers — purple ticks, single draw call -->
                        <ctrl:ScrubMarkerBar Markers="{Binding ScrubSingularityMarkers}"
                                             MarkerBrush="#9955DD"
                                             Height="6" VerticalAlignment="Center"
                                             IsHitTestVisible="False"/>
                        <!-- Digital-twin collision markers — orange ticks -->
                        <ctrl:ScrubMarkerBar Markers="{Binding ScrubCollisionMarkers}"
                                             MarkerBrush="#E8901A"
                                             Height="6" VerticalAlignment="Center"
                                             IsHitTestVisible="False"/>
                        <!-- TCP keyframe markers — lime ticks -->
                        <ctrl:ScrubMarkerBar Markers="{Binding ScrubKeyframeMarkers}"
                                             MarkerBrush="#7ed87e"
                                             Height="10" VerticalAlignment="Center"
                                             IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Move counter + analysing indicator + video export -->
                    <StackPanel x:Name="ScrubRightControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="6">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock IsVisible="{Binding IsValidating}"
                                   Text="Analysing…"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="9"
                                   HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBox Text="{Binding ToolpathScrubText}"
                                     Classes="ScrubInput"
                                     ToolTip.Tip="Type a move number and press Enter"/>
                            <TextBlock Text="{Binding ToolpathScrubMaxLabel}"
                                       Classes="Readout"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ToolpathScrubLayerLabel}"
                                   Classes="Readout"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   Opacity="0.85"
                                   ToolTip.Tip="Current layer / total layers"/>
                    </StackPanel>
                    <Button Classes="ToolbarButton" Padding="6,4" VerticalAlignment="Center"
                            Command="{Binding SimExportVideoCommand}"
                            IsEnabled="{Binding !SimRecording}"
                            ToolTip.Tip="Download a 6-second MP4 simulation of the viewport">
                        <ia:Icon Value="mdi-download" FontSize="15"/>
                    </Button>
                    </StackPanel>

                </Grid>

                <!-- Validation-tick legend — appears when the timeline carries markers -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,2,0,0"
                            IsVisible="{Binding ShowScrubLegend}">
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding HasUnreachableMarkers}">
                        <Border Width="3" Height="10" Background="#CC3030" VerticalAlignment="Center"/>
                        <TextBlock Text="Unreachable" FontSize="10" Classes="LabelMuted" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding HasSingularityMarkers}">
                        <Border Width="3" Height="10" Background="#9955DD" VerticalAlignment="Center"/>
                        <TextBlock Text="Singularity risk" FontSize="10" Classes="LabelMuted" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding HasCollisionMarkers}">
                        <Border Width="3" Height="10" Background="#E8901A" VerticalAlignment="Center"/>
                        <TextBlock Text="Collision" FontSize="10" Classes="LabelMuted" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Alt-click or double-click a tick to inspect"
                               FontSize="10" Opacity="0.55" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Keyframe lane — slides open once the first TCP keyframe exists.
                     Diamonds are clickable (jump + select); the small side ticks drag
                     to resize each key's ease-in / ease-out influence window. -->
                <Grid Height="24" Margin="0,2,0,0"
                      IsVisible="{Binding HasTcpKeyframes}"
                      ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Margin="0,0,8,0"
                            Width="{Binding #ScrubPlayControls.Bounds.Width}">
                        <TextBlock Text="KEYFRAMES"
                                   Classes="LabelMuted"
                                   FontSize="9"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="2,0,0,0"/>
                    </Border>
                    <Grid Grid.Column="1">
                        <Border Background="{DynamicResource Border1}"
                                CornerRadius="5"
                                Margin="0,3"
                                Opacity="0.35"/>
                        <ctrl:KeyframeLaneBar x:Name="KeyframeLane"
                                              Items="{Binding KeyframeLaneItems}"
                                              Cursor="Hand"/>
                    </Grid>
                    <Border Grid.Column="2" Margin="8,0,0,0"
                            Width="{Binding #ScrubRightControls.Bounds.Width}"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Bead overhang legend — bottom-right, floats above the Live I/O dock,
             timelines, and anything else parked in that corner -->
        <Border IsVisible="{Binding ShowBeadOverhang}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="{Binding BottomRightLegendMargin}"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Opacity="0.88"
                Padding="8,6">
            <StackPanel>
                <TextBlock Text="BEAD OVERHANG"
                           Classes="LabelMuted"
                           FontSize="9"
                           Margin="0,0,0,5"/>
                <Grid ColumnDefinitions="14,6,Auto,10,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <!-- 0% — White -->
                    <Rectangle Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="#FFFFFF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                    <TextBlock  Grid.Row="0" Grid.Column="2" Text="0%"   FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock  Grid.Row="0" Grid.Column="4" Text="Fully supported"   Classes="LabelMuted" FontSize="10" VerticalAlignment="Center"/>
                    <!-- 25% -->
                    <Rectangle Grid.Row="1" Grid.Column="0" Width="12" Height="12" Fill="#FFBFBF" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="1" Grid.Column="2" Text="25%"  FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="1" Grid.Column="4" Text="Mostly supported"  Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- 50% -->
                    <Rectangle Grid.Row="2" Grid.Column="0" Width="12" Height="12" Fill="#FF8080" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="2" Grid.Column="2" Text="50%"  FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="2" Grid.Column="4" Text="Partial overhang"  Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- 75% -->
                    <Rectangle Grid.Row="3" Grid.Column="0" Width="12" Height="12" Fill="#FF4040" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="3" Grid.Column="2" Text="75%"  FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="3" Grid.Column="4" Text="Significant overhang" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- 100% — Red -->
                    <Rectangle Grid.Row="4" Grid.Column="0" Width="12" Height="12" Fill="#FF0000" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="4" Grid.Column="2" Text="100%" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="4" Grid.Column="4" Text="Unsupported"        Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Orientation rate legend — right-center, visible when orientation preview active -->
        <Border IsVisible="{Binding ShowOrientationPreview}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="8,8,8,78"
                Background="{DynamicResource Bg2}"
                BorderBrush="{DynamicResource Border1}"
                BorderThickness="1"
                CornerRadius="5"
                Opacity="0.88"
                Padding="8,6">
            <StackPanel>
                <TextBlock Text="ORIENTATION RATE"
                           Classes="LabelMuted"
                           FontSize="9"
                           Margin="0,0,0,5"/>
                <Grid ColumnDefinitions="14,6,Auto,10,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!-- Row 0: Dark Blue -->
                    <Rectangle Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="#000080" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                    <TextBlock  Grid.Row="0" Grid.Column="2" Text="0.0 °/mm"  FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock  Grid.Row="0" Grid.Column="4" Text="Excellent"          Classes="LabelMuted" FontSize="10" VerticalAlignment="Center"/>
                    <!-- Row 1: Cyan -->
                    <Rectangle Grid.Row="1" Grid.Column="0" Width="12" Height="12" Fill="#00FFFF" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="1" Grid.Column="2" Text="0.25 °/mm" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="1" Grid.Column="4" Text="Very safe"          Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- Row 2: Green -->
                    <Rectangle Grid.Row="2" Grid.Column="0" Width="12" Height="12" Fill="#00CC00" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="2" Grid.Column="2" Text="0.5 °/mm"  FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="2" Grid.Column="4" Text="Safe"               Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- Row 3: Yellow -->
                    <Rectangle Grid.Row="3" Grid.Column="0" Width="12" Height="12" Fill="#FFFF00" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="3" Grid.Column="2" Text="0.75 °/mm" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="3" Grid.Column="4" Text="Approaching limits" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- Row 4: Orange -->
                    <Rectangle Grid.Row="4" Grid.Column="0" Width="12" Height="12" Fill="#FF8000" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="4" Grid.Column="2" Text="1.0 °/mm"  FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="4" Grid.Column="4" Text="Warning"            Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- Row 5: Red -->
                    <Rectangle Grid.Row="5" Grid.Column="0" Width="12" Height="12" Fill="#FF0000" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="5" Grid.Column="2" Text="1.5 °/mm"  FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="5" Grid.Column="4" Text="Significant slowdown" Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- Row 6: Magenta -->
                    <Rectangle Grid.Row="6" Grid.Column="0" Width="12" Height="12" Fill="#FF00FF" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="6" Grid.Column="2" Text="2.0+ °/mm" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="6" Grid.Column="4" Text="Severe"             Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <!-- Row 7: Purple -->
                    <Rectangle Grid.Row="7" Grid.Column="0" Width="12" Height="12" Fill="#8000CC" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="7" Grid.Column="2" Text="3.0+ °/mm" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                    <TextBlock  Grid.Row="7" Grid.Column="4" Text="Extreme"            Classes="LabelMuted" FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tool-change sequence waypoint labels (projected from 3D scene) -->
        <ItemsControl IsVisible="{Binding HasSequenceWaypointTags}"
                      ItemsSource="{Binding SequenceWaypointTags}"
                      ZIndex="18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:SequenceWaypointTag">
                    <Setter Property="Canvas.Left" Value="{Binding ScreenX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding ScreenY}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SequenceWaypointTag">
                    <Border Background="#D8081220"
                            BorderBrush="#4ade80"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,3"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding Label}"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#e5e7eb"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>

</UserControl>
