<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MassiveSlicer.Converters;assembly=MassiveSlicer.App"
             xmlns:ia="https://github.com/projektanker/icons.avalonia"
             xmlns:views="clr-namespace:MassiveSlicer.App.Views"
             x:Class="MassiveSlicer.App.Views.OutlinerItemView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <converters:BoolToEyeIconConverter x:Key="BoolToEyeIcon"/>
        <converters:BoolToThemedBrushConverter x:Key="OutlinerRowBackground"
                                               TrueResourceKey="AccentMuted"
                                               FalseResourceKey="Transparent"/>
        <converters:BoolToThemedBrushConverter x:Key="OutlinerRowBorder"
                                               TrueResourceKey="Accent"
                                               FalseResourceKey="Transparent"/>
        <converters:BoolToThemedBrushConverter x:Key="OutlinerRowText"
                                               TrueResourceKey="TextPrimary"
                                               FalseResourceKey="TextSecondary"/>
    </UserControl.Resources>

    <StackPanel>
        <Border Margin="0,0,4,0"
                Padding="0"
                CornerRadius="5"
                BorderThickness="1"
                Background="{Binding IsRowHighlighted, Converter={StaticResource OutlinerRowBackground}}"
                BorderBrush="{Binding IsRowHighlighted, Converter={StaticResource OutlinerRowBorder}}">
            <Grid PointerPressed="OnRowPressed"
                  PointerReleased="OnRowReleased">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="RowContextMenu">
                        <MenuItem Header="Rename" Click="OnRenameClick"/>
                        <Separator/>
                        <MenuItem Header="Merge as Point Cloud"
                                  Click="OnMergePointCloudClick"/>
                        <MenuItem Header="Merge as Mesh"
                                  Click="OnMergeMeshClick"/>
                        <MenuItem x:Name="ExportPointCloudItem"
                                  Header="Export Point Cloud..."
                                  Click="OnExportPointCloudClick"/>
                        <MenuItem x:Name="ExportMeshItem"
                                  Header="Export Mesh..."
                                  Click="OnExportScanMeshClick"/>
                        <Separator/>
                        <MenuItem x:Name="CreateToolpathItem"
                                  Header="Create New Toolpath"
                                  Click="OnCreateToolpathClick"/>
                        <MenuItem x:Name="CreateSequenceItem"
                                  Header="Create Toolpath Sequence"
                                  Click="OnCreateSequenceClick"/>
                        <MenuItem Header="Reload Model"
                                  Command="{Binding ReloadModelCommand}"/>
                        <MenuItem Header="Replace Model"
                                  Command="{Binding ReplaceModelCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <!-- Fixed width reserves the expander slot even when hidden, so
                         child rows indent consistently instead of drifting left. -->
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        IsVisible="{Binding HasChildren}"
                        Command="{Binding ToggleExpandCommand}"
                        Classes="ToolbarButton"
                        Padding="1,2"
                        Margin="0,2,0,2"
                        Foreground="{DynamicResource TextMuted}"
                        ToolTip.Tip="Expand / collapse">
                    <ia:Icon Value="{Binding ExpandGlyph}" FontSize="14"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ia:Icon Value="{Binding TypeIcon}" FontSize="13"
                             Margin="4,0,0,0" VerticalAlignment="Center"
                             Foreground="{Binding TypeColor}"
                             ToolTip.Tip="{Binding TypeTip}"/>
                    <TextBlock Text="{Binding Name}"
                               IsVisible="{Binding !IsRenaming}"
                               VerticalAlignment="Center"
                               Padding="4,4"
                               Opacity="{Binding NameOpacity}"
                               TextTrimming="CharacterEllipsis"
                               DoubleTapped="OnNameDoubleTapped"
                               Background="Transparent"
                               Foreground="{Binding IsRowHighlighted, Converter={StaticResource OutlinerRowText}}"/>
                    <TextBox x:Name="RenameBox"
                             IsVisible="{Binding IsRenaming}"
                             Text="{Binding EditName, Mode=TwoWay}"
                             MinWidth="130" Padding="4,2" FontSize="12"
                             VerticalAlignment="Center"
                             KeyDown="OnRenameKeyDown"
                             LostFocus="OnRenameLostFocus"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding ToggleLockCommand}"
                        Classes="ToolbarButton"
                        Padding="5,2"
                        Margin="2,2,0,2"
                        Foreground="{DynamicResource TextSecondary}"
                        ToolTip.Tip="Lock — prevents selecting this item">
                    <ia:Icon Value="{Binding LockIcon}" FontSize="13"/>
                </Button>
                <Button Grid.Column="3"
                        IsVisible="{Binding ShowVisibilityToggle}"
                        Command="{Binding ToggleVisibleCommand}"
                        Classes="ToolbarButton"
                        Padding="5,2"
                        Margin="2,2,0,2"
                        Foreground="{DynamicResource TextSecondary}"
                        ToolTip.Tip="Toggle visibility">
                    <ia:Icon Value="{Binding Visible, Converter={StaticResource BoolToEyeIcon}}" FontSize="14"/>
                </Button>
                <Button Grid.Column="4"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding CanDelete}"
                        Classes="ToolbarButton"
                        Padding="5,2"
                        Margin="2,2,0,2"
                        Foreground="{DynamicResource TextSecondary}"
                        ToolTip.Tip="Remove from scene">
                    <ia:Icon Value="mdi-trash-can-outline" FontSize="14"/>
                </Button>
            </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Children}"
                      IsVisible="{Binding ShowChildren}"
                      Margin="14,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:OutlinerItemView/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>