<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MassiveSlicer.App.Views"
             x:Class="MassiveSlicer.App.Views.BottomLeftDockView"
             x:CompileBindings="False"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Bottom">

    <Border Background="{DynamicResource Bg2}"
            BorderBrush="{DynamicResource Border2}"
            BorderThickness="0,1,0,0"
            CornerRadius="0"
            ClipToBounds="True"
            HorizontalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Drag handle — resize console height upward -->
            <Border Grid.Row="0"
                    x:Name="ResizeGrip"
                    Height="6"
                    Background="{DynamicResource Border1}"
                    BorderBrush="{DynamicResource Border2}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeNorthSouth"
                    IsVisible="{Binding Toolbar.IsConsoleVisible}"
                    ToolTip.Tip="Drag to resize console height">
                <Border Height="2"
                        Width="36"
                        Background="{DynamicResource TextMuted}"
                        Opacity="0.45"
                        CornerRadius="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Border>

            <!-- Console body -->
            <Border Grid.Row="1"
                    Height="{Binding Toolbar.DockedConsoleHeight}"
                    IsVisible="{Binding Toolbar.IsConsoleVisible}"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,0,0,1">
                <local:ConsoleView DataContext="{Binding Console}"/>
            </Border>

            <!-- Status footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Inline busy progress (project open / slicing) — no popup -->
                    <Grid Margin="8,3,8,3" IsVisible="{Binding BusyOverlayVisible}" ColumnDefinitions="Auto,180,Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding BusyTitle}" Classes="LabelMuted" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="6"
                                     Value="{Binding BusyProgress}"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource Border1}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BusyProgress, StringFormat={}{0:F0}%}"
                                   Classes="LabelMuted" VerticalAlignment="Center" Margin="8,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding BusyDetail}" Classes="LabelMuted"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Robot validation alert — inline, with jump action -->
                    <Grid Margin="8,3,8,3" IsVisible="{Binding Viewport.ShowSliceStatus}" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="⚠" Foreground="#FFFF7070" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Viewport.SliceStatusMessage}"
                                   Foreground="#FFFF7070" FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Go to issue" Padding="10,2" Margin="8,0,0,0"
                                IsVisible="{Binding Viewport.HasValidationIssueJump}"
                                Click="OnGoToValidationIssue"/>
                    </Grid>

                    <Grid Height="24" Margin="8,0">
                        <TextBlock Text="{Binding StatusBar.FileStatus}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Classes="LabelMuted"/>
                        <TextBlock Text="{Binding StatusBar.BuildLabel}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Classes="LabelMuted"
                                   Opacity="0.45"/>
                        <TextBlock Text="{Binding StatusBar.OperationFeedback}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Classes="LabelMuted"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>