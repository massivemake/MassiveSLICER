<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MassiveSlicer.App.Views"
             x:Class="MassiveSlicer.App.Views.BottomLeftDockView"
             x:CompileBindings="False"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Bottom">

    <UserControl.Styles>
        <!-- Faint by default. Same faint weight when a background check finds origin/main
             has moved past this build's baked-in baseline — just recolored to the theme's
             warning yellow, not also brightened, so it reads as a subtle recoloring rather
             than a jarring jump in intensity. -->
        <Style Selector="TextBlock.LabelMuted.BuildLabel">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.LabelMuted.BuildLabel.Stale">
            <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Bg2}"
            BorderBrush="{DynamicResource Border2}"
            BorderThickness="0,1,0,0"
            CornerRadius="0"
            ClipToBounds="True"
            HorizontalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Drag handle — resize console height upward -->
            <Border Grid.Row="0"
                    x:Name="ResizeGrip"
                    Height="6"
                    Background="{DynamicResource Border1}"
                    BorderBrush="{DynamicResource Border2}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeNorthSouth"
                    IsVisible="{Binding Toolbar.IsConsoleVisible}"
                    ToolTip.Tip="Drag to resize console height">
                <Border Height="2"
                        Width="36"
                        Background="{DynamicResource TextMuted}"
                        Opacity="0.45"
                        CornerRadius="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Border>

            <!-- Console body -->
            <Border Grid.Row="1"
                    Height="{Binding Toolbar.DockedConsoleHeight}"
                    IsVisible="{Binding Toolbar.IsConsoleVisible}"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,0,0,1">
                <local:ConsoleView DataContext="{Binding Console}"/>
            </Border>

            <!-- Status footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Inline busy progress (project open / slicing) — no popup -->
                    <Grid Margin="8,4,8,4" IsVisible="{Binding BusyOverlayVisible}" ColumnDefinitions="Auto,190,Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding BusyTitle}" Classes="LabelMuted" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="8"
                                     Value="{Binding BusyProgress}"
                                     Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource Border1}"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BusyProgress, StringFormat={}{0:F0}%}"
                                   Classes="LabelMuted" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding BusyDetail}" Classes="LabelMuted"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Robot validation alert — inline, with jump action -->
                    <Grid Margin="8,3,8,3" IsVisible="{Binding Viewport.ShowSliceStatus}" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="⚠" Foreground="#FFFF7070" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Viewport.SliceStatusMessage}"
                                   Foreground="#FFFF7070" FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                            <!-- Auto-slice is skipped above the triangle limit, and the message
                                 said "Press Slice" when nothing in the UI was bound to
                                 SliceCommand — it was reachable only from the console. -->
                            <Button Content="Slice now" Padding="10,2"
                                    IsVisible="{Binding Viewport.ShowSliceNowButton}"
                                    Command="{Binding Viewport.SliceCommand}"/>
                            <Button Content="Go to issue" Padding="10,2"
                                    IsVisible="{Binding Viewport.HasValidationIssueJump}"
                                    Click="OnGoToValidationIssue"/>
                        </StackPanel>
                    </Grid>

                    <Grid Height="24" Margin="8,0">
                        <TextBlock Text="{Binding StatusBar.FileStatus}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Classes="LabelMuted"/>
                        <!-- Padded Border is the hover/click target — see StatusBarView.axaml. -->
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Padding="14,0"
                                Cursor="Hand"
                                ToolTip.Tip="{Binding StatusBar.BuildLabelTooltip}"
                                ToolTip.Placement="Top"
                                ToolTip.VerticalOffset="-6"
                                Tapped="OnBuildLabelTapped">
                            <TextBlock Text="{Binding StatusBar.BuildLabel}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Classes="LabelMuted BuildLabel"
                                       Classes.Stale="{Binding StatusBar.IsBuildStale}"/>
                        </Border>
                        <TextBlock Text="{Binding StatusBar.OperationFeedback}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Classes="LabelMuted"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>