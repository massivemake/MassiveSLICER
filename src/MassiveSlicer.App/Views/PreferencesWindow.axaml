<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:MassiveSlicer.Converters"
        x:Class="MassiveSlicer.App.Views.PreferencesWindow"
        x:CompileBindings="False"
        Title="Preferences"
        Width="992" Height="700"
        MinWidth="832" MinHeight="420" MaxHeight="1100"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        CanResize="True"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Window.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.NavBtn">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="2,0,0,0"/>
            <Setter Property="BorderBrush"                Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="14,9"/>
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource Bg4}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.NavBtn.Active">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Accent}"/>
            <Setter Property="Background"  Value="{DynamicResource Bg3}"/>
        </Style>
        <Style Selector="Border.PrefCard">
            <Setter Property="Background"     Value="{DynamicResource Bg3}"/>
            <Setter Property="CornerRadius"   Value="8"/>
            <Setter Property="Padding"        Value="16,14"/>
            <Setter Property="Margin"         Value="0,0,0,14"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource Border1}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
    </Window.Styles>

    <Border Classes="DialogChrome"
            Background="{DynamicResource Bg0}"
            BorderBrush="{DynamicResource Border2}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Border Grid.Row="0" x:Name="TitleBar"
                    Background="{DynamicResource Bg1}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll">
                <Grid Margin="14,0">
                    <TextBlock Text="Preferences"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Classes="ToolbarButton"
                            Padding="6,2"
                            Click="OnClose"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nav -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Bg1}"
                        BorderBrush="{DynamicResource Border1}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0">
                    <StackPanel Margin="8,12,8,8" Spacing="2">
                        <Button x:Name="BtnNavigation"  Content="Navigation"  Classes="NavBtn Active" Click="NavNavigation_Click"/>
                        <Button x:Name="BtnPerformance" Content="Performance" Classes="NavBtn"        Click="NavPerformance_Click"/>
                        <Button x:Name="BtnAppearance"  Content="Appearance"  Classes="NavBtn"        Click="NavAppearance_Click"/>
                        <Button x:Name="BtnConnections" Content="Connections" Classes="NavBtn"        Click="NavConnections_Click"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <ScrollViewer x:Name="PrefsScroller"
                              Grid.Column="1"
                              Classes="Floating"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource Bg2}"
                              Padding="28,22,28,40">
                    <StackPanel>

                        <!-- KEEP ON BED section -->
                        <StackPanel x:Name="SectionKeepOnBed">
                            <TextBlock Text="KEEP ON BED"
                                       Classes="SectionHeader"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="A part already sitting on the plate stays on it through an edit, instead of being left hanging in the air. Parts you have deliberately parked above the plate are never pulled down. Going through the plate is always corrected, whatever these say."
                                       TextWrapping="Wrap"
                                       Classes="LabelMuted"
                                       FontSize="11"
                                       Margin="0,0,0,12"/>
                            <CheckBox Content="When rotating"
                                      IsChecked="{Binding KeepOnBedWhenRotating}"
                                      Margin="0,0,0,10"/>
                            <CheckBox Content="When scaling"
                                      IsChecked="{Binding KeepOnBedWhenScaling}"
                                      Margin="0,0,0,10"/>
                            <CheckBox Content="When moving  —  off by default: dragging upward is how you lift a part off the plate, and this pulls it straight back"
                                      IsChecked="{Binding KeepOnBedWhenMoving}"
                                      Margin="0,0,0,10"/>

                            <Border Height="1" Background="{DynamicResource Border1}" Margin="0,6,0,16"/>
                        </StackPanel>

                        <!-- NAVIGATION section -->
                        <StackPanel x:Name="SectionNavigation">
                            <TextBlock Text="NAVIGATION SETTINGS"
                                       Classes="SectionHeader"
                                       Margin="0,0,0,12"/>
                            <CheckBox Content="Auto Depth  —  orbit pivot follows geometry under cursor"
                                      IsChecked="{Binding AutoDepth}"
                                      Margin="0,0,0,10"/>
                            <CheckBox Content="Orbit around selection"
                                      IsChecked="{Binding OrbitAroundSelection}"
                                      Margin="0,0,0,10"/>

                            <Border Height="1" Background="{DynamicResource Border1}" Margin="0,6,0,16"/>

                            <!-- Touchpad gesture tuning; only meaningful on the Touchpad preset. -->
                            <StackPanel IsVisible="{Binding IsTouchpadPreset}">
                                <TextBlock Text="TOUCHPAD GESTURES"
                                           Classes="SectionHeader"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Two-finger drag = reposition · Shift = zoom · Cmd = rotate"
                                           Opacity="0.65" FontSize="11" Margin="0,0,0,12"/>

                                <Grid ColumnDefinitions="150,*,52" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="Reposition speed" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="1" Maximum="30"
                                            Value="{Binding TouchpadPanSpeed}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TouchpadPanSpeed, StringFormat={}{0:0.#}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8"/>
                                </Grid>

                                <Grid ColumnDefinitions="150,*,52" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="Rotate speed" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="8"
                                            Value="{Binding TouchpadOrbitSpeed}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TouchpadOrbitSpeed, StringFormat={}{0:0.#}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8"/>
                                </Grid>

                                <Grid ColumnDefinitions="150,*,52" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="Zoom speed" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="4"
                                            Value="{Binding TouchpadZoomSpeed}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TouchpadZoomSpeed, StringFormat={}{0:0.#}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8"/>
                                </Grid>

                                <CheckBox Content="Invert vertical reposition  —  up/down only; left/right always follows your fingers"
                                          IsChecked="{Binding TouchpadInvertPan}"
                                          Margin="0,2,0,10"/>

                                <Border Height="1" Background="{DynamicResource Border1}" Margin="0,6,0,16"/>
                            </StackPanel>

                            <TextBlock Text="NAVIGATION PRESET"
                                       Classes="SectionHeader"
                                       Margin="0,0,0,12"/>

                            <ItemsControl x:Name="PresetList" ItemsSource="{Binding NavigationPresets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="NavPresetBtn"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Margin="0,0,0,2"
                                                Command="{Binding DataContext.SelectPresetCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding Id}">
                                            <Panel>
                                                <!-- Active state: green rounded border + lighter bg -->
                                                <Border BorderBrush="{DynamicResource Accent}"
                                                        Background="{DynamicResource Bg4}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        IsHitTestVisible="False">
                                                    <Border.IsVisible>
                                                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                            <Binding Path="Id"/>
                                                            <Binding Path="DataContext.ActivePreset"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}"/>
                                                        </MultiBinding>
                                                    </Border.IsVisible>
                                                </Border>
                                                <!-- Content -->
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="10,7">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontSize="12"
                                                               MinWidth="110"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Orbit: " Classes="LabelMuted" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding OrbitBinding}" Classes="LabelMuted" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Pan: "   Classes="LabelMuted" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PanBinding}"   Classes="LabelMuted" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- PERFORMANCE section -->
                        <StackPanel x:Name="SectionPerformance" IsVisible="False">
                            <TextBlock Text="RENDERING" Classes="SectionHeader" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Anti-aliasing (MSAA)" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                    <TextBlock Text="Requires restart to take effect." Classes="LabelMuted" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding AntiAliasing}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- APPEARANCE section -->
                        <StackPanel x:Name="SectionAppearance" IsVisible="False">
                            <TextBlock Text="APPEARANCE" Classes="SectionHeader" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                                    <TextBlock Text="Changes take effect immediately." Classes="LabelMuted" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding ActiveTheme}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border1}" Margin="0,8,0,14"/>

                            <TextBlock Text="TOOLPATH COLORS" Classes="SectionHeader" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Extrusion moves" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ToolpathExtrudeColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Travel moves" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ToolpathTravelColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wipe moves" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ToolpathWipeColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Retraction (z-hop)" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ToolpathRetractionColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Seam" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ToolpathSeamColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Unselected" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                <ColorPicker Grid.Column="1" Color="{Binding ToolpathUnselectedColor, Mode=TwoWay}" IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                            </Grid>
                        </StackPanel>


                        <!-- CONNECTIONS section -->
                        <StackPanel x:Name="SectionConnections" IsVisible="False" Spacing="0">

                            <Border Classes="PrefCard">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="LAB ERP" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Sign in with your Lab account. A slicer token is fetched automatically and stays on this PC only."
                                                       Classes="LabelMuted" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Border CornerRadius="12" Padding="10,4"
                                                    Background="#3340b840"
                                                    IsVisible="{Binding Erp.IsConnected}">
                                                <TextBlock Text="Connected" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#40b840" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="12" Padding="10,4"
                                                    Background="#333a3a3a"
                                                    IsVisible="{Binding Erp.IsConnecting}">
                                                <TextBlock Text="Signing in" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,12,Auto,12,Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="EMAIL" Classes="FieldLabel"/>
                                            <TextBox Classes="PanelTextBox"
                                                     Watermark="you@massivemake.com"
                                                     Text="{Binding Erp.Email, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="PASSWORD" Classes="FieldLabel"/>
                                            <TextBox Classes="PanelTextBox" PasswordChar="*"
                                                     Watermark="Lab password"
                                                     Text="{Binding Erp.Password, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                            <TextBlock Text="ERP URL" Classes="FieldLabel"/>
                                            <TextBox Classes="PanelTextBox"
                                                     Watermark="https://lab.massivemake.com/api/slicer/v1"
                                                     Text="{Binding Erp.BaseUrl, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                            <TextBlock Text="PROJECTS ROOT" Classes="FieldLabel"/>
                                            <TextBox Classes="PanelTextBox"
                                                     Watermark="/Volumes/MassiveFILES/Projects"
                                                     Text="{Binding UnasProjectsRoot, Mode=TwoWay}"
                                                     ToolTip.Tip="ERP-linked workspaces save into &lt;root&gt;/&lt;project number&gt; - .../06-Production Documents"/>
                                        </StackPanel>
                                    </Grid>

                                    <Expander Margin="0,2,0,0">
                                        <Expander.Header>
                                            <TextBlock Text="Advanced: API token fallback"
                                                       Classes="LabelMuted" FontSize="11"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0" Spacing="4">
                                            <TextBlock Text="Only needed until Lab ships POST /api/slicer/v1/login. Filled automatically after a successful sign-in."
                                                       Classes="LabelMuted" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBox Classes="PanelTextBox" PasswordChar="*"
                                                     Watermark="optional - fetched on sign-in"
                                                     Text="{Binding Erp.ApiToken, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Expander>

                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                        <Button Grid.Column="0" Content="Sign in"
                                                Classes="PrimaryButton"
                                                Padding="18,7"
                                                Command="{Binding Erp.ConnectCommand}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Erp.Status}"
                                                   Classes="LabelMuted" FontSize="11" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ROBOT SMB" Classes="SectionHeader" Margin="2,4,0,4"/>
                            <TextBlock Text="Per-cell credentials for writing .src files onto the controller share. Passwords stay in local preferences only."
                                       Classes="LabelMuted" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding SmbRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="PrefCard" Padding="16,12">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{Binding CellName}" FontWeight="SemiBold"
                                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                                <Grid ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,10,Auto">
                                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                                        <TextBlock Text="ROBOT IP" Classes="FieldLabel"/>
                                                        <TextBox Classes="PanelTextBox" Text="{Binding Host, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                                        <TextBlock Text="SHARE" Classes="FieldLabel"/>
                                                        <TextBox Classes="PanelTextBox" Text="{Binding Share, Mode=TwoWay}" Watermark="d"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                                        <TextBlock Text="FOLDER" Classes="FieldLabel"/>
                                                        <TextBox Classes="PanelTextBox" Text="{Binding Folder, Mode=TwoWay}" Watermark="(share root)"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                                        <TextBlock Text="USERNAME" Classes="FieldLabel"/>
                                                        <TextBox Classes="PanelTextBox" Text="{Binding Username, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                                        <TextBlock Text="PASSWORD" Classes="FieldLabel"/>
                                                        <TextBox Classes="PanelTextBox" PasswordChar="*" Text="{Binding Password, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" Grid.Column="4" VerticalAlignment="Bottom">
                                                        <Button Content="Test connection"
                                                                Classes="SecondaryButton"
                                                                HorizontalAlignment="Stretch"
                                                                Command="{Binding TestCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding Status}" Classes="LabelMuted"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Last card (LFAM 3 user/pass) cannot reach the viewport without pad. -->
                            <Border Height="120" Background="Transparent" IsHitTestVisible="False"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Bg1}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Button Content="Done"
                        Classes="PrimaryButton"
                        Padding="16,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        Click="OnDone"/>
            </Border>
        </Grid>
    </Border>

</Window>
