<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ia="https://github.com/projektanker/icons.avalonia"
             xmlns:conv="clr-namespace:MassiveSlicer.Converters;assembly=MassiveSlicer.App"
             xmlns:behaviors="clr-namespace:MassiveSlicer.App.Behaviors;assembly=MassiveSlicer.App"
             xmlns:local="clr-namespace:MassiveSlicer.App.Views"
             xmlns:vm="clr-namespace:MassiveSlicer.ViewModels"
             x:Class="MassiveSlicer.App.Views.RightPanelView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatchCvt"/>
    </UserControl.Resources>

    <Border Background="Transparent"
            BorderBrush="{DynamicResource Border1}"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- LFAM 3 only: compact Print / Scan / Mill phase switcher (replaces the large
                 viewport-bottom workflow timeline for day-to-day phase switching). -->
            <Border Grid.Row="0"
                    Classes="Lfam3SidebarTimeline"
                    Margin="0,0,0,8"
                    IsVisible="{Binding $parent[Window].DataContext.Viewport.ShowLfam3ToolPicker}">
                <StackPanel Spacing="6">
                    <TextBlock Text="WORKFLOW"
                               Classes="LabelMuted"
                               FontSize="9"
                               LetterSpacing="1.4"
                               Margin="2,0,0,0"/>

                    <!-- 3-phase track (no pre-print scan) -->
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*"
                          IsVisible="{Binding !$parent[Window].DataContext.Viewport.HasPrePrintScanStep}">
                        <Button Grid.Column="0"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsPrintStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsPrintStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsPrintStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectPrintPhaseCommand}"
                                ToolTip.Tip="Print — pellet extruder">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-printer-3d-nozzle" FontSize="12"/>
                                <TextBlock Text="PRINT" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1" Classes="Lfam3SidebarConnector"
                                Classes.done="{Binding $parent[Window].DataContext.Viewport.IsWorkflowSegment0Complete}"/>
                        <Button Grid.Column="2"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsVerifyScanStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsVerifyScanStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsVerifyScanStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectVerifyScanPhaseCommand}"
                                ToolTip.Tip="Scan — verify / collision check">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-camera-control" FontSize="12"/>
                                <TextBlock Text="SCAN" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Classes="Lfam3SidebarConnector"
                                Classes.done="{Binding $parent[Window].DataContext.Viewport.IsWorkflowSegment1Complete}"/>
                        <Button Grid.Column="4"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsMillStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsMillStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsMillStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectMillPhaseCommand}"
                                ToolTip.Tip="Mill — spindle finish">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-screw-lag" FontSize="12"/>
                                <TextBlock Text="MILL" FontSize="10" FontWeight="SemiBold" LetterSpacing="0.8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 4-phase track when pre-print scan is enabled -->
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*"
                          IsVisible="{Binding $parent[Window].DataContext.Viewport.HasPrePrintScanStep}">
                        <Button Grid.Column="0"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsPrePrintScanStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsPrePrintScanStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsPrePrintScanStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectPrePrintScanPhaseCommand}"
                                ToolTip.Tip="Pre-print scene scan">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-camera-control" FontSize="11"/>
                                <TextBlock Text="SCAN" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1" Classes="Lfam3SidebarConnector"
                                Classes.done="{Binding $parent[Window].DataContext.Viewport.IsWorkflowSegment0Complete}"/>
                        <Button Grid.Column="2"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsPrintStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsPrintStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsPrintStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectPrintPhaseCommand}"
                                ToolTip.Tip="Print — pellet extruder">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-printer-3d-nozzle" FontSize="11"/>
                                <TextBlock Text="PRINT" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Classes="Lfam3SidebarConnector"
                                Classes.done="{Binding $parent[Window].DataContext.Viewport.IsWorkflowSegment1Complete}"/>
                        <Button Grid.Column="4"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsVerifyScanStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsVerifyScanStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsVerifyScanStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectVerifyScanPhaseCommand}"
                                ToolTip.Tip="Verify scan">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-camera-control" FontSize="11"/>
                                <TextBlock Text="SCAN" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="5" Classes="Lfam3SidebarConnector"
                                Classes.done="{Binding $parent[Window].DataContext.Viewport.IsWorkflowSegment2Complete}"/>
                        <Button Grid.Column="6"
                                Classes="Lfam3SidebarPhase"
                                Classes.active="{Binding $parent[Window].DataContext.Viewport.IsMillStepActive}"
                                Classes.completed="{Binding $parent[Window].DataContext.Viewport.IsMillStepCompleted}"
                                Classes.pending="{Binding $parent[Window].DataContext.Viewport.IsMillStepPending}"
                                Command="{Binding $parent[Window].DataContext.Viewport.SelectMillPhaseCommand}"
                                ToolTip.Tip="Mill — spindle finish">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <ia:Icon Value="mdi-screw-lag" FontSize="11"/>
                                <TextBlock Text="MILL" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Optional: toggle pre-print scan step (same as bottom timeline + control) -->
                    <Button Classes="ToolbarButton"
                            HorizontalAlignment="Left"
                            Padding="6,2"
                            FontSize="10"
                            Command="{Binding $parent[Window].DataContext.Viewport.TogglePrePrintScanStepCommand}"
                            ToolTip.Tip="{Binding $parent[Window].DataContext.Viewport.PrePrintScanToggleTip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ia:Icon Value="{Binding $parent[Window].DataContext.Viewport.PrePrintScanToggleIcon}" FontSize="11"/>
                            <TextBlock Text="Pre-print scan"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Opacity="0.75"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ADDITIVE tab -->
            <Grid Grid.Row="1" IsVisible="{Binding IsAdditiveTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,8">

                    <!-- Edit mode cards (hidden outside paint edit) -->
                    <Button Classes="StepCard"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="10,10"
                            Margin="0,0,0,6"
                            IsVisible="{Binding $parent[Window].DataContext.Viewport.IsPaintEditOpen}"
                            Command="{Binding $parent[Window].DataContext.Viewport.ExitPaintEditCommand}"
                            ToolTip.Tip="Leave toolpath edit mode and resume the normal workflow cards">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                <ia:Icon Value="mdi-exit-to-app" FontSize="11"
                                         Foreground="{DynamicResource AccentHover}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="EXIT EDIT MODE" FontSize="12" LetterSpacing="2"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Expander Classes="StepCard"
                              IsVisible="{Binding $parent[Window].DataContext.Viewport.IsPaintEditOpen}"
                              IsExpanded="{Binding StepModificationsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                    <ia:Icon Value="mdi-pencil-ruler" FontSize="11"
                                             Foreground="{DynamicResource AccentHover}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="MODIFICATIONS" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="8,0,8,8" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" FontSize="11" Opacity="0.85" VerticalAlignment="Center"
                                           Text="{Binding $parent[Window].DataContext.Viewport.PaintModificationsSummary}"/>
                                <Button Grid.Column="1" Classes="ToolbarButton" Padding="8,3" FontSize="10"
                                        Content="Clear all"
                                        Command="{Binding $parent[Window].DataContext.Viewport.ClearPaintModificationsCommand}"
                                        ToolTip.Tip="Remove every modification and paint mark"/>
                            </Grid>

                            <!-- Type-to-find modifier: applies to the current selection -->
                            <AutoCompleteBox FontSize="11" MinimumPrefixLength="0"
                                             Watermark="Type to add a modifier…"
                                             FilterMode="Contains"
                                             ItemsSource="{Binding $parent[Window].DataContext.Viewport.ModifierQuickAddCatalog}"
                                             SelectedItem="{Binding $parent[Window].DataContext.Viewport.ModifierQuickAddPick, Mode=TwoWay}"
                                             Text="{Binding $parent[Window].DataContext.Viewport.ModifierQuickAddText, Mode=TwoWay}"
                                             ToolTip.Tip="Start typing (e.g. 'struct', 'tree', 'offset') and pick a modifier — it applies to the paths/points selected in the viewport."/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                                       Text="Applies to the current viewport selection. Click a card below to expand its options; Update Slice bakes changes."/>

                            <!-- STRUCTURAL SUPPORT — the one editor for the live support.
                                 Driven by selection (viewport click, a card's cursor icon,
                                 or the ◀ ▶ arrows), so a support with no card left — e.g. one
                                 restored from preferences on a fresh model — is still
                                 reachable, nameable and deletable from inside edit mode. -->
                            <Border IsVisible="{Binding $parent[Window].DataContext.RightPanel.Additive.HasStructuralSupports}"
                                    Background="#1A33D6FF" CornerRadius="6" Padding="8,7"
                                    BorderBrush="#5533D6FF" BorderThickness="1">
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" CornerRadius="3" Padding="5,1" Background="#4433D6FF">
                                            <TextBlock Text="SUPPORT" FontSize="9" FontWeight="Bold"
                                                       Foreground="#99E8FF" LetterSpacing="0.8"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Text="{Binding $parent[Window].DataContext.RightPanel.Additive.StructuralSupportsLabel}"/>
                                        <Button Grid.Column="2" Classes="ToolbarButton" Padding="6,2" Content="◀"
                                                ToolTip.Tip="Previous support"
                                                Command="{Binding $parent[Window].DataContext.RightPanel.Additive.PrevSupportCommand}"/>
                                        <Button Grid.Column="3" Classes="ToolbarButton" Padding="6,2" Content="▶"
                                                Margin="2,0,0,0" ToolTip.Tip="Next support"
                                                Command="{Binding $parent[Window].DataContext.RightPanel.Additive.NextSupportCommand}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" FontSize="11" Padding="6,3"
                                                 Text="{Binding $parent[Window].DataContext.RightPanel.Additive.SelectedSupportName, Mode=TwoWay}"
                                                 ToolTip.Tip="Rename this support."/>
                                        <Button Grid.Column="1" Classes="ToolbarButton" Padding="7,3" Margin="4,0,0,0"
                                                ToolTip.Tip="Delete this support and re-slice without it"
                                                Command="{Binding $parent[Window].DataContext.Viewport.DeleteSelectedStructuralSupportCommand}">
                                            <ia:Icon Value="mdi-delete-outline" FontSize="13" Foreground="#ff8a8a"/>
                                        </Button>
                                    </Grid>

                                    <CheckBox Content="Enabled" FontSize="11"
                                              IsChecked="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportEnabled, Mode=TwoWay}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Shape" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Width="110" FontSize="11"
                                                  ItemsSource="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportShapeOptions}"
                                                  SelectedItem="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportShape, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Center X (mm)" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Increment="5" FormatString="F1"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportCenterX, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Center Y (mm)" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Increment="5" FormatString="F1"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportCenterY, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Width / Ø (mm)" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Rectangle width, or circle diameter. 2×4 actual = 89 × 38 mm."/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Minimum="5" Maximum="2000"
                                                       Increment="1" FormatString="F0"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportWidthMm, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Depth (mm)" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Minimum="5" Maximum="2000"
                                                       Increment="1" FormatString="F0"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportDepthMm, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Rotation (°)" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Increment="5" FormatString="F0"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportRotationDeg, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Layers up" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Layers above the anchor that get the pocket (9999 = to the top)."/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Minimum="0" Maximum="9999"
                                                       Increment="10" FormatString="F0"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportLayersUp, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,80">
                                        <TextBlock Grid.Column="0" Text="Layers down" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1" FontSize="11" Minimum="0" Maximum="9999"
                                                       Increment="10" FormatString="F0"
                                                       Value="{Binding $parent[Window].DataContext.RightPanel.Additive.SupportLayersDown, Mode=TwoWay}"/>
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                                               Text="Click a pocket in the viewport to make it the live support, then drag its gizmo (Move / Rotate in the top toolbar) instead of nudging numbers. The anchor stays fixed on every layer so the neck stacks vertically."/>
                                </StackPanel>
                            </Border>

                            <!-- Offset path settings (shown after picking 'Offset path' above) -->
                            <Border IsVisible="{Binding $parent[Window].DataContext.Viewport.ShowOffsetPathSettings}"
                                    Background="{DynamicResource Bg3}" CornerRadius="6" Padding="8,7"
                                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ia:Icon Value="mdi-vector-polyline" FontSize="14" Opacity="0.85"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="OFFSET PATH" FontSize="11" FontWeight="SemiBold"
                                                   LetterSpacing="0.8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                               Text="Creates parallel copies of the selected toolpaths and inserts them into the same layer."/>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Distance" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right">
                                            <TextBox Width="72" FontSize="11" Padding="6,4"
                                                     Text="{Binding $parent[Window].DataContext.Viewport.OffsetDistanceMm, Mode=TwoWay}"
                                                     HorizontalContentAlignment="Right"/>
                                            <TextBlock Text="mm" FontSize="10" Opacity="0.55" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Join type" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding $parent[Window].DataContext.Viewport.OffsetJoinTypeOptions}"
                                                  SelectedItem="{Binding $parent[Window].DataContext.Viewport.OffsetJoinType, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mode" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding $parent[Window].DataContext.Viewport.OffsetModeOptions}"
                                                  SelectedItem="{Binding $parent[Window].DataContext.Viewport.OffsetMode, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Offset count" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right">
                                            <Button Classes="ToolbarButton" Padding="8,2" Content="−"
                                                    Command="{Binding $parent[Window].DataContext.Viewport.NudgeOffsetCountCommand}"
                                                    CommandParameter="-1"/>
                                            <TextBlock MinWidth="20" TextAlignment="Center" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding $parent[Window].DataContext.Viewport.OffsetCount}"/>
                                            <Button Classes="ToolbarButton" Padding="8,2" Content="+"
                                                    Command="{Binding $parent[Window].DataContext.Viewport.NudgeOffsetCountCommand}"
                                                    CommandParameter="1"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*">
                                        <TextBlock Grid.Column="0" Text="Open-path side" FontSize="11"
                                                   Opacity="0.7" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding $parent[Window].DataContext.Viewport.OffsetSideOptions}"
                                                  SelectedItem="{Binding $parent[Window].DataContext.Viewport.OffsetSide, Mode=TwoWay}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <Button Grid.Column="0" Classes="ToolbarButton" Padding="10,6"
                                                Content="Cancel"
                                                Command="{Binding $parent[Window].DataContext.Viewport.CancelCreateModificationCommand}"/>
                                        <Button Grid.Column="1" Classes="AccentButton" Padding="14,6" Margin="8,0,0,0"
                                                Content="Apply"
                                                Command="{Binding $parent[Window].DataContext.Viewport.ApplyCreateModificationCommand}"
                                                ToolTip.Tip="Insert parallel offset copies of the selected paths"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Active bridge-target pick banner -->
                            <Border IsVisible="{Binding $parent[Window].DataContext.Viewport.IsPaintBridgePicking}"
                                    Background="#3322AABB" CornerRadius="5" Padding="8,6"
                                    BorderBrush="#5533D6FF" BorderThickness="1">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#99E8FF"
                                           Text="{Binding $parent[Window].DataContext.Viewport.PaintBridgePickHint}"/>
                            </Border>

                            <TextBlock FontSize="10" Opacity="0.55"
                                       IsVisible="{Binding !$parent[Window].DataContext.Viewport.HasPaintModifications}"
                                       Text="No modifications yet — select paths and Apply from the SELECTION panel."/>

                            <!-- Fully expanded — the panel's outer ScrollViewer handles overflow -->
                            <ItemsControl IsVisible="{Binding $parent[Window].DataContext.Viewport.HasPaintModifications}"
                                          ItemsSource="{Binding $parent[Window].DataContext.Viewport.PaintModifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Bg3}"
                                                    CornerRadius="6" Padding="8,6" Margin="0,0,0,4"
                                                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <!-- Header row: expand / title / reselect / delete -->
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <Button Grid.Column="0"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="0" HorizontalContentAlignment="Left"
                                                                Command="{Binding ToggleExpandCommand}"
                                                                ToolTip.Tip="Expand options and reselect in the viewport">
                                                            <StackPanel Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <ia:Icon Value="{Binding ExpandChevron}" FontSize="12"
                                                                             Opacity="0.7" VerticalAlignment="Center"/>
                                                                    <Border CornerRadius="3" Padding="5,1"
                                                                            Background="#3322AABB">
                                                                        <TextBlock Text="{Binding KindLabel}"
                                                                                   FontSize="9" FontWeight="Bold"
                                                                                   Foreground="{Binding KindColor}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               VerticalAlignment="Center"
                                                                               TextWrapping="NoWrap"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                           Opacity="0.6"
                                                                           FontFamily="Consolas,Courier New,monospace"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="ToolbarButton" Padding="5"
                                                                Margin="4,0,0,0" VerticalAlignment="Top"
                                                                Command="{Binding SelectCommand}"
                                                                ToolTip.Tip="Reselect anchors in viewport">
                                                            <ia:Icon Value="mdi-cursor-default-click" FontSize="13"/>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="ToolbarButton" Padding="5"
                                                                Margin="2,0,0,0" VerticalAlignment="Top"
                                                                Command="{Binding DeleteCommand}"
                                                                ToolTip.Tip="Delete this modification and its marks">
                                                            <ia:Icon Value="mdi-delete-outline" FontSize="13"
                                                                     Foreground="#ff8a8a"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Expanded options -->
                                                    <StackPanel IsVisible="{Binding IsExpanded}" Spacing="6"
                                                                Margin="4,0,0,2">
                                                        <Border Height="1" Background="{DynamicResource Border1}"/>

                                                        <!-- ANCHOR card -->
                                                        <Border Background="#1A33D6FF" CornerRadius="6" Padding="8,7"
                                                                BorderBrush="#5533D6FF" BorderThickness="1">
                                                            <StackPanel Spacing="3">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border CornerRadius="3" Padding="5,1"
                                                                            Background="#4433D6FF">
                                                                        <TextBlock Text="ANCHOR" FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#99E8FF"
                                                                                   LetterSpacing="0.8"/>
                                                                    </Border>
                                                                    <TextBlock Text="Support selection"
                                                                               FontSize="10" Opacity="0.65"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding AnchorSummary}" FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           FontFamily="Consolas,Courier New,monospace"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Support style (between Anchor and Target) -->
                                                        <StackPanel IsVisible="{Binding IsSupport}" Spacing="4"
                                                                    Margin="0,2,0,2">
                                                            <TextBlock Text="SUPPORT STYLE" FontSize="9" Opacity="0.55"
                                                                       LetterSpacing="0.8" FontWeight="SemiBold"/>
                                                            <ComboBox HorizontalAlignment="Stretch"
                                                                      ItemsSource="{Binding SupportTypeOptions}"
                                                                      SelectedItem="{Binding SupportType, Mode=TwoWay}"
                                                                      ToolTip.Tip="Per-area type: Formbound Buttress / Bridge, or Tree Support (bed-rooted). Reslice to bake."/>
                                                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                                                                       Text="Each area keeps its own type. Changing this only updates this modification."/>
                                                            <!-- Formbound wall side: Inside notch vs Outside fin -->
                                                            <StackPanel IsVisible="{Binding ShowSupportSideUi}" Spacing="4"
                                                                        Margin="0,4,0,0">
                                                                <TextBlock Text="WALL SIDE" FontSize="9" Opacity="0.55"
                                                                           LetterSpacing="0.8" FontWeight="SemiBold"/>
                                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                                                    <RadioButton Grid.Column="0"
                                                                                 Content="Inside"
                                                                                 GroupName="{Binding Id}"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 HorizontalContentAlignment="Center"
                                                                                 Padding="8,5"
                                                                                 IsChecked="{Binding IsSupportSideInside, Mode=TwoWay}"
                                                                                 ToolTip.Tip="Formbound grows into the part (dual-wall notch hidden inside the wall)."/>
                                                                    <RadioButton Grid.Column="1"
                                                                                 Content="Outside"
                                                                                 GroupName="{Binding Id}"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 HorizontalContentAlignment="Center"
                                                                                 Padding="8,5"
                                                                                 IsChecked="{Binding IsSupportSideOutside, Mode=TwoWay}"
                                                                                 ToolTip.Tip="Formbound grows as a sacrificial fin outside the wall (trim after print)."/>
                                                                </Grid>
                                                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                                                                           Text="Inside = notch into the solid. Outside = exterior fin. Reslice to bake."/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- STRUCTURAL SUPPORT: no duplicate field set here on purpose.
                                                             These fields always edited the SELECTED support, not this
                                                             card's own — so with two cards open both edited the same
                                                             pocket. One editor, at panel level, driven by selection. -->
                                                        <StackPanel IsVisible="{Binding IsStructural}" Spacing="4"
                                                                    Margin="0,2,0,2">
                                                            <TextBlock Text="POCKET SHAPE" FontSize="9" Opacity="0.55"
                                                                       LetterSpacing="0.8" FontWeight="SemiBold"/>
                                                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                                                       Text="Edited in the SUPPORT panel above. Click this card's cursor icon (or its pocket in the viewport) to make it the live support, then drag the gizmo."/>
                                                        </StackPanel>

                                                        <!-- BRIDGE TARGET card (Formbound only — Tree roots to bed) -->
                                                        <StackPanel IsVisible="{Binding ShowBridgeTargetUi}" Spacing="4">
                                                            <Border Background="#1A80B7FF" CornerRadius="6" Padding="8,7"
                                                                    BorderBrush="#5580B7FF" BorderThickness="1">
                                                                <StackPanel Spacing="3">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <Border CornerRadius="3" Padding="5,1"
                                                                                Background="#4480B7FF">
                                                                            <TextBlock Text="TARGET" FontSize="9"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#B3D9FF"
                                                                                       LetterSpacing="0.8"/>
                                                                        </Border>
                                                                        <TextBlock Text="Bridge foot / column start"
                                                                                   FontSize="10" Opacity="0.65"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding BridgeTargetLabel}" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               FontFamily="Consolas,Courier New,monospace"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding ScaffoldSummary}" FontSize="10"
                                                                               Opacity="0.7" TextWrapping="Wrap"
                                                                               Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                                <Button Grid.Column="0" Classes="ToolbarButton"
                                                                        Padding="8,5" HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Center"
                                                                        Content="{Binding PickBridgeButtonLabel}"
                                                                        Command="{Binding PickBridgeTargetCommand}"
                                                                        Classes.active="{Binding IsPickingBridgeTarget}"
                                                                        ToolTip.Tip="Click a path or point on another layer for the column foot. One perimeter mouth; T opens at the anchor support line."/>
                                                                <Button Grid.Column="1" Classes="ToolbarButton"
                                                                        Padding="8,5" Margin="6,0,0,0"
                                                                        Content="Clear"
                                                                        IsVisible="{Binding HasBridgeTarget}"
                                                                        Command="{Binding ClearBridgeTargetCommand}"
                                                                        ToolTip.Tip="Remove bridge target"/>
                                                            </Grid>
                                                        </StackPanel>

                                                        <TextBlock IsVisible="{Binding IsOffset}"
                                                                   TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                                                   Text="Offset path copies were inserted into the toolpath geometry. Reselect to highlight the original anchor."/>
                                                        <TextBlock IsVisible="{Binding ShowRemoveHelp}"
                                                                   TextWrapping="Wrap" FontSize="10" Opacity="0.6"
                                                                   Text="Remove marks delete beads under the anchor. Bridge/scaffold is only available on Support modifications."/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <!-- 1 MODEL (Presets nested inside — search/filter/apply/favorites/import-export/persistence).
                         PersistExpander.Key set explicitly because this Expander's Header is a composite
                         StackPanel (badge + text), not a plain string, so the attached behavior's generic
                         Header-based keying can't apply — see PersistExpander.KeyFor(). -->
                    <Expander Classes="StepCard"
                              IsVisible="{Binding !$parent[Window].DataContext.Viewport.IsPaintEditOpen}"
                              IsExpanded="{Binding StepModelExpanded, Mode=TwoWay}"
                              behaviors:PersistExpander.Key="Model">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                    <TextBlock Text="1" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentHover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="MODEL" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="8,0,8,6" Spacing="6">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                       Text="Import a model with the dropzone in the left panel (or File > Import). Position it in the viewport: G move, R rotate, S scale, or use the floating tools when selected."/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55"
                                       Text="Tiny imports that look like metres are auto-scaled x1000."/>

                            <Expander Classes="SectionExpander TightPad" Header="PRESETS" IsExpanded="False">
                        <StackPanel Margin="0,0,0,4" Spacing="6">
                            <!-- Search + filter -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="PanelTextBox"
                                         Text="{Binding Presets.SearchText, Mode=TwoWay}"
                                         Watermark="Search presets…"
                                         KeyDown="OnSearchTextKeyDown"/>
                                <ToggleButton Grid.Column="1" Margin="6,0,0,0" Classes="IconSeg"
                                              IsChecked="{Binding Presets.IsFilterDrawerOpen, Mode=TwoWay}"
                                              ToolTip.Tip="Filters">
                                    <ia:Icon Value="mdi-filter-variant"/>
                                </ToggleButton>
                            </Grid>

                            <!-- Active search tags -->
                            <ItemsControl ItemsSource="{Binding Presets.SearchTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentMuted}" CornerRadius="10"
                                                Padding="8,3" Margin="0,0,4,4">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource AccentHover}"/>
                                                <Button Content="✕" FontSize="9" Padding="0" Width="14" Height="14"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource AccentHover}"
                                                        Command="{Binding $parent[Window].DataContext.RightPanel.Presets.RemoveSearchTagCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Filter drawer: dropdown revealing a list of per-field filters, all
                                 as choice dropdowns over whatever values have actually been saved
                                 (numeric fields included — see PresetsCardViewModel.
                                 MakeNumericChoiceFilter) rather than free-form ranges, so there's
                                 nothing to pick that no preset actually uses. Options recompute as
                                 presets are added. -->
                            <Border IsVisible="{Binding Presets.IsFilterDrawerOpen}"
                                    Background="#1a1a1a" CornerRadius="6" Padding="8"
                                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="FILTERS" Classes="LabelMuted" FontSize="9" LetterSpacing="1" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Clear Seed Data" FontSize="9" Padding="6,2" Margin="0,0,4,0"
                                                Command="{Binding Presets.ClearSeedDataCommand}"
                                                ToolTip.Tip="Removes every seeded sample preset (never touches saved/imported)"/>
                                        <Button Grid.Column="2" Content="Reset" FontSize="9" Padding="6,2"
                                                Command="{Binding Presets.ResetFiltersCommand}"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Presets.ChoiceFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding FieldName}" FontSize="10" Opacity="0.8"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="10"
                                                              ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Sort + Group + Favorites — one compact icon toolbar -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                <!-- Sort -->
                                <Border Grid.Column="0" Classes="IconSegGroup">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button Classes="IconSeg"
                                                Classes.active="{Binding Presets.IsSortName}"
                                                Command="{Binding Presets.SetSortNameCommand}"
                                                ToolTip.Tip="Sort by name">
                                            <ia:Icon Value="mdi-sort-alphabetical-ascending"/>
                                        </Button>
                                        <Button Classes="IconSeg"
                                                Classes.active="{Binding Presets.IsSortLastPrinted}"
                                                Command="{Binding Presets.SetSortLastPrintedCommand}"
                                                ToolTip.Tip="Sort by last printed">
                                            <ia:Icon Value="mdi-printer-outline"/>
                                        </Button>
                                        <Button Classes="IconSeg"
                                                Classes.active="{Binding Presets.IsSortDateCreated}"
                                                Command="{Binding Presets.SetSortDateCreatedCommand}"
                                                ToolTip.Tip="Sort by date created">
                                            <ia:Icon Value="mdi-calendar-plus"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Group -->
                                <Border Grid.Column="1" Classes="IconSegGroup" HorizontalAlignment="Left" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                        <Button Classes="IconSeg"
                                                Classes.active="{Binding Presets.IsGroupByNone}"
                                                Command="{Binding Presets.SetGroupByNoneCommand}"
                                                ToolTip.Tip="Flat list">
                                            <ia:Icon Value="mdi-format-list-bulleted"/>
                                        </Button>
                                        <Button Classes="IconSeg"
                                                Classes.active="{Binding Presets.IsGroupByMethod}"
                                                Command="{Binding Presets.SetGroupByMethodCommand}"
                                                ToolTip.Tip="Group by method">
                                            <ia:Icon Value="mdi-layers-triple-outline"/>
                                        </Button>
                                        <Button Classes="IconSeg"
                                                Classes.active="{Binding Presets.IsGroupByFolder}"
                                                Command="{Binding Presets.SetGroupByFolderCommand}"
                                                ToolTip.Tip="Group by folder">
                                            <ia:Icon Value="mdi-folder-outline"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Favorites only -->
                                <ToggleButton Grid.Column="2" Classes="IconSeg"
                                              IsChecked="{Binding Presets.FavoritesOnly, Mode=TwoWay}"
                                              ToolTip.Tip="Favorites only">
                                    <ia:Icon Value="mdi-star-outline"/>
                                </ToggleButton>
                            </Grid>

                            <!-- Flat list — name + star only (details on tooltip / info flyout) -->
                            <ListBox ItemsSource="{Binding Presets.FilteredPresets}"
                                     SelectedItem="{Binding Presets.SelectedPreset, Mode=TwoWay}"
                                     IsVisible="{Binding !Presets.IsGroupedView}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MaxHeight="300"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     DoubleTapped="OnPresetDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,3">
                                            <Border Grid.Column="0" Background="{DynamicResource AccentMuted}"
                                                    CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SummaryBadge}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentHover}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="8,0"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Name}"/>
                                            <Button Grid.Column="2" Width="18" Height="18" Padding="0" Margin="2,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Favorite">
                                                <Panel>
                                                    <ia:Icon Value="mdi-star" IsVisible="{Binding IsFavorite}"
                                                             Foreground="{DynamicResource Accent}"/>
                                                    <ia:Icon Value="mdi-star-outline" IsVisible="{Binding !IsFavorite}"/>
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="2" Classes="IconSeg" Width="24" Height="24"
                                                    ToolTip.Tip="Preset details">
                                                <Button.Flyout>
                                                    <Flyout Placement="Left">
                                                        <StackPanel Width="260" Spacing="4" Margin="4">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding SummaryBadge}" FontSize="10"
                                                                       Foreground="{DynamicResource Accent}" Opacity="0.9"/>
                                                            <TextBlock Text="{Binding LastPrintedDisplay}" FontSize="10"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                            <Separator Margin="0,2"/>
                                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{Binding InfoLines}" FontSize="10" TextWrapping="Wrap"/>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <ia:Icon Value="mdi-information-outline"/>
                                            </Button>
                                            <Border Grid.Column="4" Width="16" Height="16" CornerRadius="8" Margin="0,0,4,0"
                                                    Background="{DynamicResource ColorSuccess}"
                                                    IsVisible="{Binding HasSiblings}"
                                                    ToolTip.Tip="{Binding SiblingTooltip}" ToolTip.ShowDelay="600"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SiblingCount}" FontSize="9" FontWeight="Bold"
                                                           Foreground="#0A0E14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding LastPrintedDisplay}" FontSize="9"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="6" Width="18" Height="18" Padding="0" Margin="2,0,0,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextMuted}" Content="⋮" FontSize="13"
                                                    ToolTip.Tip="Rename / Update / Delete">
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                        <StackPanel Width="130" Spacing="1">
                                                            <Button Content="Rename" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.BeginRenameCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Update" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.UpdatePresetCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Overwrite this preset with the panel's current settings"/>
                                                            <Separator Margin="0,2"/>
                                                            <Button Content="Delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource ColorError}"
                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.DeletePresetCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Grouped list -->
                            <ItemsControl ItemsSource="{Binding Presets.GroupedPresets}"
                                          IsVisible="{Binding Presets.IsGroupedView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding GroupName}" Classes="LabelMuted" FontSize="9"
                                                       LetterSpacing="1" Margin="2,0,0,2"/>
                                            <ListBox ItemsSource="{Binding Items}"
                                                     SelectedItem="{Binding $parent[Window].DataContext.RightPanel.Presets.SelectedPreset, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     MaxHeight="180"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     DoubleTapped="OnPresetDoubleTapped">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="10,3,0,3">
                                                            <Border Grid.Column="0" Background="{DynamicResource AccentMuted}"
                                                                    CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SummaryBadge}" FontSize="9" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentHover}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="8,0"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding Name}"/>
                                                            <Button Grid.Column="2" Width="18" Height="18" Padding="0" Margin="2,0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.ToggleFavoriteCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Favorite">
                                                                <Panel>
                                                                    <ia:Icon Value="mdi-star" IsVisible="{Binding IsFavorite}"
                                                                             Foreground="{DynamicResource Accent}"/>
                                                                    <ia:Icon Value="mdi-star-outline" IsVisible="{Binding !IsFavorite}"/>
                                                                </Panel>
                                                            </Button>
                                                            <Button Grid.Column="2" Classes="IconSeg" Width="24" Height="24"
                                                                    ToolTip.Tip="Preset details">
                                                                <Button.Flyout>
                                                                    <Flyout Placement="Left">
                                                                        <StackPanel Width="260" Spacing="4" Margin="4">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                                                                            <TextBlock Text="{Binding SummaryBadge}" FontSize="10"
                                                                                       Foreground="{DynamicResource Accent}" Opacity="0.9"/>
                                                                            <TextBlock Text="{Binding LastPrintedDisplay}" FontSize="10"
                                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                                            <Separator Margin="0,2"/>
                                                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding InfoLines}" FontSize="10" TextWrapping="Wrap"/>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                                <ia:Icon Value="mdi-information-outline"/>
                                                            </Button>
                                                            <Border Grid.Column="4" Width="16" Height="16" CornerRadius="8" Margin="0,0,4,0"
                                                                    Background="{DynamicResource ColorSuccess}"
                                                                    IsVisible="{Binding HasSiblings}"
                                                                    ToolTip.Tip="{Binding SiblingTooltip}" ToolTip.ShowDelay="600"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SiblingCount}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="#0A0E14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="5" Text="{Binding LastPrintedDisplay}" FontSize="9"
                                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="6" Width="18" Height="18" Padding="0" Margin="2,0,0,0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="{DynamicResource TextMuted}" Content="⋮" FontSize="13"
                                                                    ToolTip.Tip="Rename / Update / Delete">
                                                                <Button.Flyout>
                                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                                        <StackPanel Width="130" Spacing="1">
                                                                            <Button Content="Rename" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                    Background="Transparent" BorderThickness="0"
                                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.BeginRenameCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                            <Button Content="Update" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                    Background="Transparent" BorderThickness="0"
                                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.UpdatePresetCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip.Tip="Overwrite this preset with the panel's current settings"/>
                                                                            <Separator Margin="0,2"/>
                                                                            <Button Content="Delete" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                    Background="Transparent" BorderThickness="0"
                                                                                    Foreground="{DynamicResource ColorError}"
                                                                                    Command="{Binding $parent[Window].DataContext.RightPanel.Presets.DeletePresetCommand}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Rename (right-click a preset above) -->
                            <Border IsVisible="{Binding Presets.IsRenameDialogOpen}"
                                    Background="#1a1a1a" CornerRadius="6" Padding="8"
                                    BorderBrush="{DynamicResource AccentHover}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="RENAME PRESET" Classes="LabelMuted" FontSize="9" LetterSpacing="1"/>
                                    <TextBox Classes="PanelTextBox" Text="{Binding Presets.RenameNameText, Mode=TwoWay}"
                                             Watermark="Preset name…"/>
                                    <Grid ColumnDefinitions="*,6,*">
                                        <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding Presets.CancelRenameCommand}"/>
                                        <Button Grid.Column="2" Content="Rename" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding Presets.CommitRenameCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Select + apply + share -->
                            <Grid ColumnDefinitions="*,6,*,6,*">
                                <Button Grid.Column="0" Content="Apply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding Presets.CanLoadSelected}"
                                        Command="{Binding Presets.LoadSelectedCommand}"
                                        ToolTip.Tip="Apply selected preset (or double-click a row)"/>
                                <Button Grid.Column="2" Content="Export…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        IsEnabled="{Binding Presets.CanLoadSelected}"
                                        Click="OnExportPresetClicked"
                                        ToolTip.Tip="Export selected preset"/>
                                <Button Grid.Column="4" Content="Import…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Click="OnImportPresetClicked"
                                        ToolTip.Tip="Import a preset file"/>
                            </Grid>
                            <TextBlock Text="{Binding Presets.StatusMessage}" FontSize="9" Opacity="0.7"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Presets.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Save as preset -->
                            <Button Content="+ Save as Preset…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding Presets.ToggleSaveDialogCommand}"/>

                            <Border IsVisible="{Binding Presets.IsSaveDialogOpen}"
                                    Background="#1a1a1a" CornerRadius="6" Padding="8"
                                    BorderBrush="{DynamicResource ColorSuccess}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="SAVE AS PRESET" Classes="LabelMuted" FontSize="9" LetterSpacing="1"/>
                                    <TextBox Classes="PanelTextBox" Text="{Binding Presets.SaveNameText, Mode=TwoWay}"
                                             Watermark="Preset name…"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="Include:" Classes="LabelMuted" FontSize="9" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <Button Grid.Column="1" Content="All" FontSize="9" Padding="6,2" Margin="0,0,4,0"
                                                Command="{Binding Presets.SelectAllFieldGroupsCommand}"
                                                ToolTip.Tip="Check every group (only affects these checkboxes, never the underlying values)"/>
                                        <Button Grid.Column="2" Content="Clear" FontSize="9" Padding="6,2"
                                                Command="{Binding Presets.ClearFieldGroupsCommand}"
                                                ToolTip.Tip="Uncheck every group (only affects these checkboxes, never the underlying values)"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Presets.SaveFieldGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                          FontSize="10" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,6,*">
                                        <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding Presets.ToggleSaveDialogCommand}"/>
                                        <Button Grid.Column="2" Content="Save" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding Presets.SaveNewPresetCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                            </Expander>

                            <!-- Selected-model quick edits (effector import panel) -->
                            <StackPanel IsVisible="{Binding $parent[Window].DataContext.Viewport.HasMeshSelected}"
                                        Margin="0,10,0,0" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Scale" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold"
                                               Text="{Binding $parent[Window].DataContext.Viewport.ModelScale, StringFormat={}{0:0.00}}"/>
                                </Grid>
                                <Slider Minimum="0.05" Maximum="5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding $parent[Window].DataContext.Viewport.ModelScale, Mode=TwoWay}"/>

                                <Grid ColumnDefinitions="*,6,*,6,*" Margin="0,8,0,0">
                                    <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.Viewport.RotateModelXCommand}"
                                            ToolTip.Tip="Rotate 90° about X, then drop to the plate">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ia:Icon Value="mdi-restore" FontSize="12"/>
                                            <TextBlock Text="X" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.Viewport.RotateModelYCommand}"
                                            ToolTip.Tip="Rotate 90° about Y, then drop to the plate">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ia:Icon Value="mdi-restore" FontSize="12"/>
                                            <TextBlock Text="Y" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Content="Clear" FontSize="11"
                                            Command="{Binding $parent[Window].DataContext.Viewport.ClearModelCommand}"
                                            ToolTip.Tip="Remove the selected model from the scene"/>
                                </Grid>

                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55" Margin="0,8,0,0"
                                           Text="Models must be oriented Z-up (Z is vertical). Rotations re-drop the bottom onto the build plate."/>

                                <CheckBox Content="Show back faces" Margin="0,8,0,0"
                                          IsChecked="{Binding $parent[Window].DataContext.Viewport.ShowBackFaces, Mode=TwoWay}"
                                          ToolTip.Tip="See the inside of this model from either side — useful for checking a Cut plane's placement without rotating around it."/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 2 SLICE -->
                    <Expander Classes="StepCard"
                              IsVisible="{Binding !$parent[Window].DataContext.Viewport.IsPaintEditOpen}"
                              IsExpanded="{Binding StepSliceExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                    <TextBlock Text="2" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentHover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="SLICE" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,0,0,6">
                    <Expander Classes="SectionExpander" Header="MATERIAL" IsExpanded="False">
                        <StackPanel Margin="0,0,0,6">
                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,4,0"
                                          PlaceholderText="No preset selected"
                                          ItemsSource="{Binding Additive.MaterialPresets}"
                                          SelectedIndex="{Binding Additive.SelectedPresetIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Classes="ToolbarButton"
                                        Padding="8,2"
                                        Margin="0,0,2,0"
                                        Click="OnEditMaterialClicked"
                                        IsEnabled="{Binding Additive.HasSelectedPreset}"
                                        ToolTip.Tip="Edit selected material preset">
                                    <ia:Icon Value="mdi-pencil" FontSize="14"/>
                                </Button>
                                <Button Grid.Column="2"
                                        Classes="ToolbarButton"
                                        Padding="8,2"
                                        Click="OnAddMaterialClicked"
                                        ToolTip.Tip="Add new material preset">
                                    <ia:Icon Value="mdi-plus" FontSize="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <!-- SLICING METHOD: strategy + mode (collapsible like the other groups) -->
                    <Expander Classes="SectionExpander" Header="SLICING METHOD" IsExpanded="False">
                        <StackPanel Margin="0,0,0,4">
                <!-- Method + slicing mode -->
                <StackPanel Margin="8,8,8,4" Spacing="4">
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Additive.AvailableMethodNames}"
                              SelectedItem="{Binding Additive.MethodDisplayName, Mode=TwoWay}"/>

                    <!-- Geodesic / Curved (Sweep) TCP orientation: vertical ↔ stacking-normal tween + tilt cap -->
                    <StackPanel Spacing="4" IsVisible="{Binding Additive.ShowOrientationFollow}" Margin="0,2,0,0">
                        <Grid ColumnDefinitions="*,*,56">
                            <TextBlock Grid.Column="0" Text="Surface follow (%)"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Tweens the TCP between upright (0 = vertical, like Planar) and the full surface-following orientation (100). E.g. 10 keeps the tool nearly upright with 10% of the geodesic tilt."/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="{Binding Additive.OrientationFollowPercent, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Grid.Column="2" Classes="PanelTextBox"
                                     Text="{Binding Additive.OrientationFollowPercent, Mode=TwoWay, StringFormat={}{0:F0}}"
                                     TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,56">
                            <TextBlock Grid.Column="0" Text="Max tilt (°)"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Hard cap on TCP tilt from vertical, applied after the surface-follow blend. Never exceeded regardless of the percentage — guards flange clearance on steep shells. 90 = no cap."/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="90"
                                    Value="{Binding Additive.OrientationMaxTiltDeg, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Grid.Column="2" Classes="PanelTextBox"
                                     Text="{Binding Additive.OrientationMaxTiltDeg, Mode=TwoWay, StringFormat={}{0:F0}}"
                                     TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>
                        <CheckBox Content="First layer zero tilt"
                                  IsChecked="{Binding Additive.FirstLayerZeroTilt, Mode=TwoWay}"
                                  Margin="0,2,0,0"
                                  ToolTip.Tip="Force the first layer's TCP fully vertical regardless of the surface-follow blend — flat-bed adhesion and no flange dig-in on layer 1."/>
                    </StackPanel>

                    <!-- Layer lean: planar "poor man's non-planar" — tilt toward the previous layer -->
                    <StackPanel Spacing="4" IsVisible="{Binding Additive.ShowLayerLean}" Margin="0,2,0,0">
                        <Grid ColumnDefinitions="*,*,56">
                            <TextBlock Grid.Column="0" Text="Layer lean (%)"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Poor man's non-planar: leans the extruder toward the nearest deposited material on the PREVIOUS layer, so stepped walls print with the TCP following the local wall lean. 0 = off (vertical), 100 = full lean toward the layer below. First layer always stays vertical."/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="{Binding Additive.LayerLeanPercent, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Grid.Column="2" Classes="PanelTextBox"
                                     Text="{Binding Additive.LayerLeanPercent, Mode=TwoWay, StringFormat={}{0:F0}}"
                                     TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,56">
                            <TextBlock Grid.Column="0" Text="Max lean (°)"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Hard cap on the lean tilt from vertical — never exceeded regardless of the percentage. Keeps the flange clear of the part on tall stepped walls."/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="90"
                                    Value="{Binding Additive.LayerLeanMaxTiltDeg, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox Grid.Column="2" Classes="PanelTextBox"
                                     Text="{Binding Additive.LayerLeanMaxTiltDeg, Mode=TwoWay, StringFormat={}{0:F0}}"
                                     TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding Additive.ShowSlicingMode}">
                        <TextBlock Grid.Column="0" Text="Slicing mode" VerticalAlignment="Center" Classes="LabelMuted"/>
                        <ComboBox  Grid.Column="1"
                                   ItemsSource="{Binding Additive.SlicingModeOptions}"
                                   SelectedItem="{Binding Additive.SlicingMode, Mode=TwoWay}"
                                   Width="100" FontSize="11"
                                   ToolTip.Tip="Normal: solid volume with shells and infill. Surface: cladding/boundary paths on mesh intersections; tool stays vertical unless Overhang orientation is enabled."/>
                    </Grid>

                    <!-- Curved (Sweep) boundary controls -->
                    <StackPanel Spacing="4" IsVisible="{Binding Additive.ShowCurvedControls}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Boundary source" VerticalAlignment="Center" Classes="LabelMuted"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Additive.CurvedBoundarySourceOptions}"
                                      SelectedItem="{Binding Additive.CurvedBoundarySourceDisplay, Mode=TwoWay}"
                                      Width="120" FontSize="11"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,80">
                            <TextBlock Grid.Column="0" Text="Auto-detect band (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                            <TextBox Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.CurvedAutoDetectBandMm}"/>
                        </Grid>
                        <TextBlock Text="{Binding Additive.CurvedBoundarySummary}" FontSize="10" Opacity="0.75" Margin="0,2,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Content="Edit boundaries"
                                    Classes="ToolbarButton"
                                    Padding="10,4"
                                    Margin="0,0,4,0"
                                    Command="{Binding Additive.OpenCurvedBoundaryEditorCommand}"
                                    ToolTip.Tip="Pick LOW/HIGH edge loops on the mesh (or preview auto-detected rings)."/>
                            <Button Grid.Column="1"
                                    Content="Import JSON"
                                    Classes="ToolbarButton"
                                    Padding="10,4"
                                    Command="{Binding Additive.ImportCurvedBoundariesCommand}"
                                    ToolTip.Tip="Load compas_slicer boundaryLOW.json / boundaryHIGH.json vertex indices."/>
                        </Grid>
                        <CheckBox Content="Region split for branching (Y-shapes)"
                                  IsChecked="{Binding Additive.CurvedEnableRegionSplit, Mode=TwoWay}"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="STRUCTURAL SUPPORTS" IsExpanded="False"
                              IsVisible="{Binding Additive.HasStructuralSupports}">
                        <StackPanel Margin="8,4,8,6" Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Button Grid.Column="0" Classes="ToolbarButton" Padding="6,2" Content="◀"
                                        Command="{Binding Additive.PrevSupportCommand}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Additive.StructuralSupportsLabel}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <Button Grid.Column="2" Classes="ToolbarButton" Padding="6,2" Content="▶"
                                        Command="{Binding Additive.NextSupportCommand}"/>
                                <Button Grid.Column="3" Classes="ToolbarButton" Padding="6,2" Margin="6,0,0,0"
                                        Content="✕" ToolTip.Tip="Remove this support"
                                        Command="{Binding Additive.RemoveSelectedSupportCommand}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <TextBox Grid.Column="1" Width="140" FontSize="11" Padding="6,3"
                                         Text="{Binding Additive.SelectedSupportName, Mode=TwoWay}"
                                         ToolTip.Tip="Rename this support — the name is what the arrows, the console and the MODIFICATIONS card all report."/>
                            </Grid>
                            <CheckBox Content="Enabled" IsChecked="{Binding Additive.SupportEnabled, Mode=TwoWay}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Shape" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <ComboBox Grid.Column="1" Width="110" FontSize="11"
                                          ItemsSource="{Binding Additive.SupportShapeOptions}"
                                          SelectedItem="{Binding Additive.SupportShape, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Center X (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportCenterX, Mode=TwoWay}"
                                               Increment="5" FormatString="F1" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Center Y (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportCenterY, Mode=TwoWay}"
                                               Increment="5" FormatString="F1" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Width / Ø (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Rectangle width, or circle diameter. 2×4 actual = 89 × 38 mm."/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportWidthMm, Mode=TwoWay}"
                                               Minimum="5" Maximum="2000" Increment="1" FormatString="F0" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Depth (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportDepthMm, Mode=TwoWay}"
                                               Minimum="5" Maximum="2000" Increment="1" FormatString="F0" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Rotation (°)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportRotationDeg, Mode=TwoWay}"
                                               Increment="5" FormatString="F0" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Layers up" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="How many layers above the anchor layer get the pocket (9999 = to the top)."/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportLayersUp, Mode=TwoWay}"
                                               Minimum="0" Maximum="9999" Increment="10" FormatString="F0" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Text="Layers down" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.SupportLayersDown, Mode=TwoWay}"
                                               Minimum="0" Maximum="9999" Increment="10" FormatString="F0" FontSize="11"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Classes="LabelMuted" FontSize="10" Margin="0,4,0,0"
                                       Text="The anchor (surface break) stays fixed on every layer so the neck stacks vertically. Press Update Slice to apply changes."/>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="GEOMETRY" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">
                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Layer height (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="In adaptive mode this becomes the maximum layer height"/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.LayerHeight}"/>
                            </Grid>

                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bead width (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.BeadWidth}"/>
                            </Grid>

                            <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowTiltAngle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Y tilt (°)" Classes="LabelMuted" VerticalAlignment="Center"/>
                                <Slider    Grid.Column="1" Minimum="-89" Maximum="89"
                                           Value="{Binding Additive.TiltAngle, Mode=TwoWay}"
                                           VerticalAlignment="Center"/>
                                <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                           Text="{Binding Additive.TiltAngle, Mode=TwoWay, StringFormat={}{0:F1}}"
                                           TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowTiltAngle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X tilt (°)" Classes="LabelMuted" VerticalAlignment="Center"/>
                                <Slider    Grid.Column="1" Minimum="-89" Maximum="89"
                                           Value="{Binding Additive.TiltAngleX, Mode=TwoWay}"
                                           VerticalAlignment="Center"/>
                                <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                           Text="{Binding Additive.TiltAngleX, Mode=TwoWay, StringFormat={}{0:F1}}"
                                           TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- Multi-Planar: guide-plane stack -->
                            <StackPanel IsVisible="{Binding Additive.ShowMultiPlanarControls}" Spacing="2" Margin="0,2,0,2">
                                <TextBlock Margin="8,0,8,2" TextWrapping="Wrap" Classes="LabelMuted" FontSize="10"
                                           Text="The slicing plane's tilt interpolates through the guide planes below as the print climbs. The first and last angles keep projecting past those guides until the whole mesh is sliced — guides shape tilt, they do not start or stop the cut. Layers become wedges — extrusion RPM follows local thickness. Click a plane in the viewport and drag: horizontal rotates, vertical slides its height."/>
                                <Grid Margin="8,0,8,2" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Tilt axis" Classes="LabelMuted" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Y" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <ToggleSwitch IsChecked="{Binding Additive.MultiPlanarAxisX, Mode=TwoWay}"
                                                      OnContent="" OffContent="" MinWidth="0" Padding="0"
                                                      ToolTip.Tip="Off: tilt about Y (planes lean along X). On: tilt about X (planes lean along Y)."/>
                                        <TextBlock Text="X" Classes="LabelMuted" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="8,2,8,0" ColumnDefinitions="56,*,60,26">
                                    <TextBlock Grid.Column="0" Text="Height %" Classes="LabelMuted" FontSize="9"/>
                                    <TextBlock Grid.Column="1" Text="Tilt (°)" Classes="LabelMuted" FontSize="9"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Additive.MultiPlanarPlanes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,1,8,1" ColumnDefinitions="56,*,60,26">
                                                <TextBox Grid.Column="0" Classes="PanelTextBox" TextAlignment="Right" Padding="4,2"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding HeightPct, Mode=TwoWay, StringFormat={}{0:F0}}"/>
                                                <Slider  Grid.Column="1" Margin="6,0" Minimum="-60" Maximum="60"
                                                         Value="{Binding AngleDeg, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2" Classes="PanelTextBox" TextAlignment="Right" Padding="4,2"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding AngleDeg, Mode=TwoWay, StringFormat={}{0:F1}}"/>
                                                <Button  Grid.Column="3" Content="✕" FontSize="10" Padding="4,2" Margin="4,0,0,0"
                                                         Command="{Binding RemoveCommand}"
                                                         ToolTip.Tip="Remove this guide plane (minimum two)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="8,4,8,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="+ Add plane" FontSize="11"
                                        Command="{Binding Additive.AddMultiPlanarPlaneCommand}"/>
                            </StackPanel>

                            <SplitButton Margin="8,4,8,2" HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Content="Auto Calculate Tilt"
                                         IsVisible="{Binding Additive.ShowTiltAngle}"
                                         IsEnabled="{Binding !Additive.IsAutoTiltRunning}"
                                         Command="{Binding Additive.AutoTiltCommand}"
                                         ToolTip.Tip="Find the X/Y tilt with the least overhangs and lowest print-failure risk (mesh stays in place). Use the dropdown to also auto-rotate the mesh.">
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Auto rotate mesh + tilt"
                                                  Command="{Binding Additive.AutoTiltRotateCommand}"
                                                  ToolTip.Tip="Search every lean direction, rotate the mesh on the bed so the best one becomes a clean single-axis Y tilt, and apply it."/>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <Button Grid.Column="0" Margin="8,2,8,2" HorizontalAlignment="Stretch"
                                    Content="Reverse direction"
                                    IsVisible="{Binding Additive.ShowTiltAngle}"
                                    Command="{Binding Additive.ReverseTiltDirectionCommand}"
                                    ToolTip.Tip="Flip the angled-slice direction (negates the X and Y tilt). The perimeter arrow shows the current slice direction."/>

                            <!-- Adaptive layer height (moved out of EFFECTS) -->
                            <Expander Classes="SectionExpander" Header="ADVANCED" IsExpanded="False"
                                      ToolTip.Tip="Adaptive layer height — vary layer thickness with surface slope.">
                                <StackPanel Margin="0,2,0,6">
                                    <!-- Adaptive layer height -->
                                    <CheckBox Margin="8,2,8,4"
                                              Content="Adaptive layer height"
                                              FontSize="11"
                                              IsChecked="{Binding Additive.AdaptiveLayerHeight, Mode=TwoWay}"
                                              IsVisible="{Binding Additive.ShowAdaptiveLayerHeight}"
                                              ToolTip.Tip="Vary layer thickness based on surface slope — thin layers on gentle slopes, thick on steep faces. Enables layer preview shading."/>

                                    <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowAdaptiveControls}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Min layer height (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.MinLayerHeight, Mode=TwoWay}"/>
                                    </Grid>

                                    <Grid Margin="8,2,8,8" IsVisible="{Binding Additive.ShowAdaptiveControls}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fine" Classes="LabelMuted" FontSize="10"
                                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <Slider    Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01"
                                                   Value="{Binding Additive.AdaptiveQuality, Mode=TwoWay}"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="0 = finest detail (thinnest layers on slopes), 1 = fastest (thickest layers allowed)"/>
                                        <TextBlock Grid.Column="2" Text="Coarse" Classes="LabelMuted" FontSize="10"
                                                   VerticalAlignment="Center" Margin="4,0,8,0"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="SEAM" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">
                            <Grid ColumnDefinitions="*,Auto" Margin="8,2,8,4">
                                <TextBlock Grid.Column="0" Text="Mode" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Normal: closed loops. Zig-zag: single-skin open wall (longest face), reverse each layer — works with Planar, Angled, Multi-Planar, Geodesic, and Curved (Sweep). Spiral: vase mode (planar-style)."/>
                                <ComboBox  Grid.Column="1"
                                           ItemsSource="{Binding Additive.SeamModeOptions}"
                                           SelectedItem="{Binding Additive.SeamMode, Mode=TwoWay}"
                                           Width="90" FontSize="11"
                                           ToolTip.Tip="Normal: closed loops. Zig-zag: single-skin open wall (longest face), reverse each layer — works with Planar, Angled, Multi-Planar, Geodesic, and Curved (Sweep). Spiral: vase mode (planar-style)."/>
                            </Grid>

                            <CheckBox Content="Allow same-layer travel"
                                      IsChecked="{Binding Additive.ZigZagAllowSameLayerTravel, Mode=TwoWay}"
                                      IsVisible="{Binding Additive.ShowZigZagTravelOption}"
                                      Margin="8,2,8,2"
                                      ToolTip.Tip="Zig-zag: when a layer has multiple open faces, keep them all and Travel (start/stop) between faces. Off = only the longest face per layer. Use with Digital Start/Stop for clean travels. Recommended for Geodesic / Multi-Planar panels."/>

                            <StackPanel IsVisible="{Binding Additive.ShowPlanarSeamExtras}">
                                <TextBlock Text="LOCATION" Classes="LabelMuted" FontSize="10" Margin="8,6,8,2" LetterSpacing="1"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="8,2,8,4">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Seam position guides" Classes="LabelMuted"/>
                                        <TextBlock Text="{Binding Additive.SeamGuideSummary}" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Edit"
                                            Classes="ToolbarButton"
                                            Padding="10,4"
                                            Command="{Binding Additive.OpenSeamEditorCommand}"
                                            ToolTip.Tip="Place points on the model. Seams start at the contour point closest to each guide."/>
                                </Grid>

                                <CheckBox Content="Overhang orientation"
                                          IsChecked="{Binding Additive.OverhangOrientation, Mode=TwoWay}"
                                          Margin="8,2,8,2"/>

                                <Grid ColumnDefinitions="*,Auto"
                                      Margin="8,2,8,4"
                                      IsVisible="{Binding Additive.ShowOverhangTilt}">
                                    <TextBlock Grid.Column="0" Text="Max tilt (°)" VerticalAlignment="Center" Classes="LabelMuted" FontSize="11"/>
                                    <NumericUpDown Grid.Column="1"
                                                  Value="{Binding Additive.MaxOverhangTiltDeg, Mode=TwoWay}"
                                                  Minimum="0" Maximum="89" Increment="5"
                                                  FormatString="F0" Width="80" FontSize="11"/>
                                </Grid>

                                <CheckBox Content="Disable contour offset"
                                          IsChecked="{Binding Additive.DisableContourOffset, Mode=TwoWay}"
                                          Margin="8,4,8,2"
                                          ToolTip.Tip="Disables offsetting contours by bead width / 2. The print line treats the surface as the center line, adding extra material on the outside. Useful for prints requiring finish milling."/>
                            </StackPanel>

                            <Button Margin="8,8,8,2" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Content="Optimize Toolpath"
                                    Command="{Binding Additive.OptimizeToolpathCommand}"
                                    ToolTip.Tip="Re-order the sliced toolpath so every path starts where the previous one ends (closed loops re-seam to the nearest vertex, open paths may reverse), then weld paths closer than 3× bead width together with an extruded bridge — one continuous toolpath instead of travels. Runs on the current toolpath; re-run after a reslice."/>
                            <TextBlock Text="{Binding Additive.OptimizeToolpathSummary}"
                                       FontSize="10" Opacity="0.75" Margin="8,0,8,4"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Additive.OptimizeToolpathSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="MOTION" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">
                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Print speed (mm/s)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.PrintSpeed}"/>
                            </Grid>

                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Travel speed (mm/s)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.TravelSpeed}"/>
                            </Grid>
                        <Expander Classes="SectionExpander TightPad" Header="ADVANCED SETTINGS" IsExpanded="False">
                        <Border Margin="0,0,0,2" CornerRadius="8"
                                Background="{DynamicResource Bg3}"
                                BorderBrush="{DynamicResource Border1}"
                                BorderThickness="1"
                                Padding="10,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <CheckBox Content="Adaptive Speed and Flow"
                                          IsChecked="{Binding Additive.LayerSpeedAdaptEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,2"/>
                                <TextBlock TextWrapping="Wrap" Classes="LabelMuted" FontSize="10"
                                           Text="Interpolate robot speed and extrusion RPM per layer. Print feedback uses the live notes and caps long layers at print speed — cut length / layer time still stretch the file from low to high."/>

                                <StackPanel IsVisible="{Binding Additive.LayerSpeedAdaptEnabled}" Spacing="8">
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Scale by" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" MinWidth="120"
                                                  ItemsSource="{Binding Additive.LayerSpeedBasisOptions}"
                                                  SelectedItem="{Binding Additive.LayerSpeedBasisDisplay, Mode=TwoWay}"/>
                                    </Grid>

                                    <Border Height="10" CornerRadius="5" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                <!-- Matches the viewport Speed/RPM/Thermal gradient (ToolpathRenderer.GradientColor): blue = low/slow/cold → red = high/fast/hot. -->
                                                <GradientStop Color="#3373FF" Offset="0"/>
                                                <GradientStop Color="#40D94D" Offset="0.5"/>
                                                <GradientStop Color="#FF4026" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Short layers (low)" Classes="LabelMuted" FontSize="10"/>
                                        <TextBlock Grid.Column="2" Text="Long layers (high)" Classes="LabelMuted" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Low speed (mm/s)" Classes="LabelMuted" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding Additive.LayerSpeedMinMmS, Mode=TwoWay}"
                                                       Minimum="0.1" Maximum="2000" Increment="1"
                                                       FormatString="F0" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="→" Classes="LabelMuted"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="High speed (mm/s)" Classes="LabelMuted" FontSize="10"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <NumericUpDown Grid.Column="4"
                                                       Value="{Binding Additive.LayerSpeedMaxMmS, Mode=TwoWay}"
                                                       Minimum="0.1" Maximum="2000" Increment="1"
                                                       FormatString="F0" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Print notes" Classes="LabelMuted" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="1-based layer:percent from the live print. 63:-20 = layer 63 twenty percent slower than the mapped speed."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                   Text="{Binding Additive.LayerSpeedNotes, Mode=TwoWay}"
                                                   Watermark="63:-20"/>
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Border1}" Margin="0,4,0,2"/>
                                <Button Content="Simulate Thermomechanical"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding Additive.SimulateThermalCommand}"
                                        ToolTip.Tip="Analytical interlayer-cooling simulation: predicts the temperature each layer lands on, derives the safe layer-time window between sag and bonding limits, and sets the Adaptive Speed low/high values. View the result with the Thermal view pill."/>
                                <TextBlock TextWrapping="Wrap" Classes="LabelMuted" FontSize="10"
                                           IsVisible="{Binding Additive.HasThermalSummary}"
                                           Text="{Binding Additive.ThermalSummary}"/>
                            </StackPanel>
                        </Border>
                        </Expander>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="MOVEMENT" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">
                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Z hop (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Vertical lift on travel moves. 0 = no hop."/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.ZHopMm}"/>
                            </Grid>

                            <!-- First layer speed / RPM overrides (KRL export) -->
                            <CheckBox Margin="8,6,8,0" IsChecked="{Binding Additive.FirstLayerAdjustmentsEnabled, Mode=TwoWay}"
                                      ToolTip.Tip="Enable first-layer speed/RPM adjustments. When off, the first layer prints at the normal speed/RPM and the export ignores these fields.">
                                <TextBlock Text="FIRST LAYER" FontSize="9" Opacity="0.7" LetterSpacing="0.8" FontWeight="SemiBold"/>
                            </CheckBox>
                            <StackPanel IsVisible="{Binding Additive.FirstLayerAdjustmentsEnabled}">
                                <Grid Margin="8,2,8,2" ColumnDefinitions="*,Auto,80">
                                    <TextBlock Grid.Column="0" Text="First layer speed (mm/s)" VerticalAlignment="Center" Classes="LabelMuted"
                                               ToolTip.Tip="First-layer print speed for KRL export. Leave 0 to use the calculated (normal print) speed shown at right. Enter a number to override just the first layer."/>
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" Classes="LabelMuted"
                                               Text="{Binding Additive.FirstLayerSpeedCalculated, StringFormat='calc {0:F0}'}"
                                               ToolTip.Tip="Calculated first-layer speed (= normal print speed)."/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding Additive.FirstLayerSpeed, Mode=TwoWay}"
                                                   Minimum="0" Maximum="2000" Increment="5" FormatString="F0" FontSize="11"
                                                   ToolTip.Tip="0 = use calculated"/>
                                </Grid>
                                <Grid Margin="8,2,8,4" ColumnDefinitions="*,Auto,80">
                                    <TextBlock Grid.Column="0" Text="First layer RPM (%)" VerticalAlignment="Center" Classes="LabelMuted"
                                               ToolTip.Tip="First-layer extrusion RPM for KRL export. Leave 0 to use the calculated value at right (from bead width, first-layer height, first-layer speed, material flow). Enter a number to override."/>
                                    <TextBlock Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" Classes="LabelMuted"
                                               Text="{Binding Additive.FirstLayerRpmCalculated, StringFormat='calc {0:F1}'}"
                                               ToolTip.Tip="Calculated first-layer RPM from bead geometry + first-layer height + first-layer speed + flow."/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding Additive.FirstLayerRpm, Mode=TwoWay}"
                                                   Minimum="0" Maximum="100" Increment="1" FormatString="F1" FontSize="11"
                                                   ToolTip.Tip="0 = use calculated"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="WIPE" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">
                            <ComboBox Margin="8,0,8,4" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Additive.WipeModeOptions}"
                                      SelectedItem="{Binding Additive.WipeModeDisplay, Mode=TwoWay}"
                                      ToolTip.Tip="Retrace = wipe back over the last extrusion. Same-Direction = continue forward past the travel point for the wipe length."/>

                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wipe length (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WipeLengthMm}"/>
                            </Grid>

                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wipe ramp (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Shop −1 = dip 1 mm in −Z into the bead with RPM 0, then wipe length (reverse fires on that smash). Positive: last N mm of wipe length ramps RPM to zero. Smash depth is capped at layer height."/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WipeRampMm}"/>
                            </Grid>

                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wipe speed (mm/s)" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Linear speed for wipe extrusion moves. Can differ from travel speed."/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WipeSpeed}"/>
                            </Grid>

                            <CheckBox Content="Ignore wipe on short travels"
                                      Margin="8,4,8,2"
                                      FontSize="11"
                                      IsChecked="{Binding Additive.WipeSkipShortTravels, Mode=TwoWay}"
                                      ToolTip.Tip="Do not insert a wipe when the following travel is shorter than 2x the layer height. Useful for tiny gaps between nearby beads where a full wipe is unnecessary."/>
                            <TextBlock Text="Threshold = 2 x layer height"
                                       Classes="LabelMuted" FontSize="10" Margin="24,0,8,4" Opacity="0.75"/>
                        </StackPanel>
                    </Expander>
                    <Expander Classes="SectionExpander" Header="STOCK FROM MAPS" IsExpanded="False">
                        <StackPanel>
                            <TextBlock Text="Print the displaced surface (low-poly mesh + the MILLING panel's detail map) plus an allowance, so the blank carries the detail for the mill."
                                       Classes="LabelMuted" Margin="8,0,8,6" TextWrapping="Wrap"/>
                            <CheckBox Margin="8,0,8,4" Content="Print detailed stock (use PBR maps)" FontSize="11"
                                      IsChecked="{Binding Additive.UseDisplacedStock, Mode=TwoWay}"/>
                            <Grid Margin="8,0,8,4" ColumnDefinitions="*,80" IsEnabled="{Binding Additive.UseDisplacedStock}">
                                <TextBlock Grid.Column="0" Text="Machining allowance (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding Additive.StockAllowanceMm, Mode=TwoWay}"
                                               Minimum="0" Maximum="50" Increment="0.5" FormatString="F1" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <!-- Realtime slicing: no manual Generate button; the slice status text below reports progress. -->
                    <TextBlock Text="{Binding $parent[Window].DataContext.Viewport.SliceStatusMessage}"
                               Margin="8,0,8,6"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Opacity="0.8"
                               IsVisible="{Binding $parent[Window].DataContext.Viewport.ShowSliceStatus}"/>
                        </StackPanel>
                    </Expander>

                                        

                    <!-- 3 PATTERN AND TEXTURE -->
                    <Expander Classes="StepCard"
                              IsVisible="{Binding !$parent[Window].DataContext.Viewport.IsPaintEditOpen}"
                              IsExpanded="{Binding StepPatternExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                    <TextBlock Text="3" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentHover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="PATTERN AND TEXTURE" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="10,4,10,6"
                                       Text="Decorative wall pattern applied to the toolpath when slicing."/>

                            <Grid Margin="10,8,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Apply to" FontSize="11" VerticalAlignment="Center"
                                           ToolTip.Tip="Everything: every extrusion, including infill and bracing. Walls only: perimeters, leaving the slicer's infill and X-bracing straight. Visible skin (raycast): sweeps horizontal rays across each layer and patterns only what they reach first, so interior walls and modelled braces stay straight too — this is the one to use on scanned or organic parts. Whatever is left out keeps its ends on the wall so it stays bonded."/>
                                <ComboBox Grid.Column="1" MinWidth="150"
                                          ItemsSource="{Binding Additive.PatternScopeOptions}"
                                          SelectedItem="{Binding Additive.PatternScope, Mode=TwoWay}"/>
                            </Grid>


                            <Expander Classes="SectionExpander" Header="PATTERN TOOLS" IsExpanded="False">
                            <StackPanel>

                            <!-- Pattern tiles (effector port) -->
                            <UniformGrid Columns="4" Margin="8,0,8,4">
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Smooth}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Smooth">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-circle-outline" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Smooth" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Sine}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Sine">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-sine-wave" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sine" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Diamond}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Diamond">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-rhombus-outline" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Diamond" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Polygon}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Polygon">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-hexagon-outline" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Polygon" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Ripple}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Ripple">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-waves" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Ripple" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=HWave}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="HWave">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-wave" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="H-Wave" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=VWave}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="VWave">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-waveform" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="V-Wave" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Bumps}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Bumps">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-dots-grid" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Bumps" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Bubbles}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Bubbles">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-chart-bubble" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Bubbles" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Pleats}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Pleats">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-texture" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Pleats" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Voronoi}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Voronoi">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-web" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Voronoi" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Hexagon}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Hexagon">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-hexagon-multiple-outline" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Hexagon" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Triangle}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Triangle">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-triangle-outline" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Triangle" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Guilloche}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Guilloche">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-infinity" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Guilloché" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Hammered}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Hammered">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-blur" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Hammered" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="PatternTile"
                                        Classes.active="{Binding Additive.PatternType, Converter={StaticResource EnumMatchCvt}, ConverterParameter=Sunflower}"
                                        Command="{Binding Additive.SetPatternCommand}"
                                        CommandParameter="Sunflower">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <ia:Icon Value="mdi-flower-outline" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sunflower" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <Grid Margin="10,8,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Distribution" FontSize="11" VerticalAlignment="Center"
                                           ToolTip.Tip="Even: cycles spaced uniformly by distance along the printed path. Radial: classic angular wrap around the part centre (stretches on non-circular shapes)."/>
                                <ComboBox Grid.Column="1" MinWidth="150"
                                          ItemsSource="{Binding Additive.PatternMappingOptions}"
                                          SelectedItem="{Binding Additive.PatternMapping, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="10,6,10,0" ColumnDefinitions="*,80"
                                  IsVisible="{Binding Additive.ShowPatternWavelength}">
                                <TextBlock Grid.Column="0" Text="Wavelength (mm)" FontSize="11" VerticalAlignment="Center"
                                           ToolTip.Tip="Physical size of one pattern cycle along the path — identical on every layer. The leftover fraction of a cycle lands at the seam."/>
                                <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                           Text="{Binding Additive.PatternWavelengthMm, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Amplitude" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{Binding Additive.PatternAmplitude, StringFormat={}{0:0.0}}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="mm" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Slider Margin="10,0,10,2" Minimum="0" Maximum="60" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding Additive.PatternAmplitude, Mode=TwoWay}"/>

                            <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Frequency" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{Binding Additive.PatternFrequency, StringFormat={}{0:0}}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Slider Margin="10,0,10,2" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Additive.PatternFrequency, Mode=TwoWay}"/>

                            <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Twist" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{Binding Additive.PatternTwist, StringFormat={}{0:0.0}}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="°/mm" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Slider Margin="10,0,10,2" Minimum="-5" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Value="{Binding Additive.PatternTwist, Mode=TwoWay}"/>

                            <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Pattern offset" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{Binding Additive.PatternOffset, StringFormat={}{0:0}}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="°" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Slider Margin="10,0,10,2" Minimum="0" Maximum="360" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Additive.PatternOffset, Mode=TwoWay}"/>

                            <Grid Margin="10,6,10,0" ColumnDefinitions="*,8,*">
                                <StackPanel Grid.Column="0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Fade in" FontSize="11"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{Binding Additive.PatternFadeIn, StringFormat={}{0:0}}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="mm" FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="1000" Value="{Binding Additive.PatternFadeIn, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Fade out" FontSize="11"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                            <TextBlock Text="{Binding Additive.PatternFadeOut, StringFormat={}{0:0}}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="mm" FontSize="9" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="1000" Value="{Binding Additive.PatternFadeOut, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            </StackPanel>
                            </Expander>

                            <!-- Live effector: draggable glowing points that locally boost the pattern -->
                            <ToggleButton Classes="ExportCta" Margin="10,12,10,4"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          IsChecked="{Binding Additive.EffectorEnabled, Mode=TwoWay}"
                                          ToolTip.Tip="Enable the live effector: place glowing points in the viewport (select and move them with the gizmo); the pattern amplitude is boosted within their range.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ia:Icon Value="mdi-white-balance-sunny" FontSize="13"/>
                                    <TextBlock Text="Live effector" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ToggleButton>

                            <Grid ColumnDefinitions="*,6,*,6,*" Margin="10,0,10,4"
                                  IsVisible="{Binding Additive.EffectorEnabled}">
                                <Button Grid.Column="0" Content="● 1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Classes="PatternTile"
                                        Classes.active="{Binding $parent[Window].DataContext.Viewport.EffectorPoint1Active}"
                                        Command="{Binding $parent[Window].DataContext.Viewport.ToggleEffectorPointCommand}"
                                        CommandParameter="1" Padding="0,6"/>
                                <Button Grid.Column="2" Content="● 2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Classes="PatternTile"
                                        Classes.active="{Binding $parent[Window].DataContext.Viewport.EffectorPoint2Active}"
                                        Command="{Binding $parent[Window].DataContext.Viewport.ToggleEffectorPointCommand}"
                                        CommandParameter="2" Padding="0,6"/>
                                <Button Grid.Column="4" Content="● 3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Classes="PatternTile"
                                        Classes.active="{Binding $parent[Window].DataContext.Viewport.EffectorPoint3Active}"
                                        Command="{Binding $parent[Window].DataContext.Viewport.ToggleEffectorPointCommand}"
                                        CommandParameter="3" Padding="0,6"/>
                            </Grid>

                            <StackPanel IsVisible="{Binding Additive.EffectorEnabled}">
                                <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Mode" FontSize="11" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" MinWidth="130" FontSize="11"
                                              ItemsSource="{Binding Additive.EffectorModeOptions}"
                                              SelectedItem="{Binding Additive.EffectorMode, Mode=TwoWay}"
                                              ToolTip.Tip="Amplify boosts the pattern inside the influence area; Erase smooths the lines back to a plain wall"/>
                                </Grid>
                                <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Range" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="{Binding Additive.EffectorRange, StringFormat={}{0:0}}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Margin="10,0,10,2" Minimum="10" Maximum="3000" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding Additive.EffectorRange, Mode=TwoWay}"/>
                                <Grid Margin="10,6,10,0" ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding Additive.IsEffectorAmplify}">
                                    <TextBlock Grid.Column="0" Text="Strength" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="{Binding Additive.EffectorStrength, StringFormat={}{0:0.0}}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="mm" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Slider Margin="10,0,10,6" Minimum="0" Maximum="200" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        IsVisible="{Binding Additive.IsEffectorAmplify}"
                                        Value="{Binding Additive.EffectorStrength, Mode=TwoWay}"/>
                            </StackPanel>

                            <Expander Classes="SectionExpander" Header="EFFECTS" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">


                            <!-- X-Bracing Wall (collapsible group under EFFECTS) -->
                            <Expander Classes="SectionExpander" Header="X-BRACING" IsExpanded="False"
                                      ToolTip.Tip="Structural X braces into the wall. Orient the brace plane so hairpins grow perpendicular to it (consistent direction across the surface).">
                                <StackPanel Margin="0,2,0,4">
                                    <CheckBox Margin="8,2,8,4"
                                              Content="Enable X-bracing"
                                              FontSize="11"
                                              IsChecked="{Binding Additive.XBracingEnabled, Mode=TwoWay}"
                                              ToolTip.Tip="Cut dual-wall / single-skin X braces (LFAM-style diagonal channels). Depth is a target ceiling; single-skin grows layer-by-layer with ≥60% support."/>

                                    <StackPanel IsVisible="{Binding Additive.ShowXBracingControls}" Spacing="0">
                                        <Grid Margin="8,4,8,4" ColumnDefinitions="*,140">
                                            <TextBlock Grid.Column="0" Text="Projection type" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Planar: one oriented plane — braces go perpendicular to it. Cylinder: braces radiate outward from a vertical cylinder you place on the bed."/>
                                            <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11"
                                                       ItemsSource="{Binding Additive.XBracingProjectionTypeOptions}"
                                                       SelectedItem="{Binding Additive.XBracingProjectionType, Mode=TwoWay}"/>
                                        </Grid>

                                        <CheckBox Margin="8,2,8,4"
                                                  Content="Show helper in viewport"
                                                  FontSize="11"
                                                  IsChecked="{Binding Additive.XBracingShowHelper, Mode=TwoWay}"
                                                  ToolTip.Tip="Show the brace plane / cylinder guide in the viewport. Saved with the workspace. Visual only — braces still use the projection while hidden."/>

                                        <!-- Planar projection -->
                                        <StackPanel IsVisible="{Binding Additive.ShowXBracingPlanarControls}">
                                            <TextBlock Margin="8,2,8,2" Text="BRACE PLANE" Classes="LabelMuted"
                                                       FontSize="9" LetterSpacing="1"/>
                                            <TextBlock Margin="8,0,8,4" TextWrapping="Wrap" Classes="LabelMuted" FontSize="10"
                                                       Text="Cyan plane in the viewport = brace direction. Tilt until it sits on the face — pins go straight into that face."/>

                                            <Grid Margin="8,2,8,2" ColumnDefinitions="*,80">
                                                <TextBlock Grid.Column="0" Text="Plane tilt Y (°)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                                <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                           Text="{Binding Additive.XBracingPlaneTiltY, Mode=TwoWay}"/>
                                            </Grid>
                                            <Slider Margin="10,0,10,4" Minimum="-90" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Additive.XBracingPlaneTiltY, Mode=TwoWay}"/>

                                            <Grid Margin="8,2,8,2" ColumnDefinitions="*,80">
                                                <TextBlock Grid.Column="0" Text="Plane tilt X (°)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                                <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                           Text="{Binding Additive.XBracingPlaneTiltX, Mode=TwoWay}"/>
                                            </Grid>
                                            <Slider Margin="10,0,10,4" Minimum="-90" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Additive.XBracingPlaneTiltX, Mode=TwoWay}"/>

                                            <Grid Margin="8,2,8,6" ColumnDefinitions="*,6,*">
                                                <Button Grid.Column="0" Content="Flip direction" HorizontalAlignment="Stretch" FontSize="11"
                                                        Command="{Binding Additive.FlipXBracingPlaneCommand}"
                                                        ToolTip.Tip="Reverse brace direction (flip the plane normal)."/>
                                                <Button Grid.Column="2" Content="Reset plane" HorizontalAlignment="Stretch" FontSize="11"
                                                        Command="{Binding Additive.ResetXBracingPlaneCommand}"
                                                        ToolTip.Tip="Horizontal plane (0°/0°) — braces fall back to path left-normal."/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Cylinder projection -->
                                        <StackPanel IsVisible="{Binding Additive.ShowXBracingCylinderControls}">
                                            <TextBlock Margin="8,2,8,2" Text="BRACE CYLINDER" Classes="LabelMuted"
                                                       FontSize="9" LetterSpacing="1"/>
                                            <TextBlock Margin="8,0,8,4" TextWrapping="Wrap" Classes="LabelMuted" FontSize="10"
                                                       Text="By default braces pull toward this vertical cylinder. Height matches the part. Click the cylinder in the viewport and drag on the bed to move it."/>

                                            <Grid Margin="8,2,8,4" ColumnDefinitions="*,80">
                                                <TextBlock Grid.Column="0" Text="Diameter (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                           ToolTip.Tip="Cylinder diameter. Height is automatic from the model bounds."/>
                                                <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                           Text="{Binding Additive.XBracingCylinderDiameterMm, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Margin="8,2,8,2" ColumnDefinitions="*,80">
                                                <TextBlock Grid.Column="0" Text="Center X (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                                <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                           Text="{Binding Additive.XBracingCylinderX, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Margin="8,2,8,2" ColumnDefinitions="*,80">
                                                <TextBlock Grid.Column="0" Text="Center Y (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                                <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                           Text="{Binding Additive.XBracingCylinderY, Mode=TwoWay}"/>
                                            </Grid>
                                            <CheckBox Margin="8,4,8,2"
                                                      Content="Flip direction (radiate outward)"
                                                      FontSize="11"
                                                      IsChecked="{Binding Additive.XBracingCylinderFlipDirection, Mode=TwoWay}"
                                                      ToolTip.Tip="Off (default): braces pull toward the cylinder axis. On: braces radiate outward from the axis."/>
                                            <Button Margin="8,4,8,6" Content="Reset to bed center" HorizontalAlignment="Stretch" FontSize="11"
                                                    Command="{Binding Additive.ResetXBracingCylinderCommand}"
                                                    ToolTip.Tip="Move cylinder axis to the print bed centre (not the robot origin), reset diameter to 200 mm, and restore pull-toward."/>
                                        </StackPanel>

                                        <TextBlock Margin="8,6,8,2" Text="PATTERN" Classes="LabelMuted"
                                                   FontSize="9" LetterSpacing="1"/>
                                        <Grid Margin="8,2,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="Depth top (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="How far each brace goes into the wall at the TOP of the part. Single-skin grows up to this over layers; dual-wall clamps to thickness."/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                       Text="{Binding Additive.XBracingDepthMm, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="8,2,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="Depth bottom (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Brace depth at the BOTTOM of the part. 0 = constant (same as top); set a value to taper depth over height with the ease dropdowns — e.g. a deeper base than tip on a cylinder."/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                       Text="{Binding Additive.XBracingDepthBottomMm, Mode=TwoWay}"/>
                                        </Grid>
                                        <StackPanel IsVisible="{Binding Additive.ShowXBracingDepthEase}">
                                            <Grid Margin="8,2,8,4" ColumnDefinitions="*,140">
                                                <TextBlock Grid.Column="0" Text="Ease bottom" VerticalAlignment="Center" Classes="LabelMuted"
                                                           ToolTip.Tip="How the depth taper behaves near the BOTTOM of the part. Linear = constant rate; Ease-In = slow start (holds bottom depth longer); Ease-Out = fast start; Smooth = flat start/end (smoothstep)."/>
                                                <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11"
                                                           ItemsSource="{Binding Additive.XBracingDepthEaseOptions}"
                                                           SelectedItem="{Binding Additive.XBracingDepthEaseBottom, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Margin="8,2,8,4" ColumnDefinitions="*,140">
                                                <TextBlock Grid.Column="0" Text="Ease top" VerticalAlignment="Center" Classes="LabelMuted"
                                                           ToolTip.Tip="How the depth taper behaves near the TOP of the part. Linear = constant rate; Ease-In = steep finish; Ease-Out = soft settle to top depth; Smooth = flat end (smoothstep)."/>
                                                <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11"
                                                           ItemsSource="{Binding Additive.XBracingDepthEaseOptions}"
                                                           SelectedItem="{Binding Additive.XBracingDepthEaseTop, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>
                                        <Grid Margin="8,2,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="X span (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Horizontal size of one full X cell along the wall."/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                       Text="{Binding Additive.XBracingSpanMm, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="8,2,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="Angle from vertical (°)" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Diagonal lean of the X pattern (not the brace plane). Lower = more printable bottom-up."/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                                       Text="{Binding Additive.XBracingAngleDeg, Mode=TwoWay}"/>
                                        </Grid>
                                        <CheckBox Margin="8,2,8,4"
                                                  Content="Extend side edges"
                                                  FontSize="11"
                                                  IsChecked="{Binding Additive.XBracingExtendEdges, Mode=TwoWay}"
                                                  ToolTip.Tip="Partial X cells at left/right wall ends. Top and bottom of the part are never extended."/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Brim (collapsible group under EFFECTS) -->
                            <Expander Classes="SectionExpander" Header="BRIM" IsExpanded="False"
                                      ToolTip.Tip="Bed-adhesion brim: offset loops around the first layer, outside the footprint and/or inside interior holes. Generated as the last toolpath step, so it wraps X-bracing and any other first-layer additions.">
                                <StackPanel Margin="0,2,0,4">
                                    <CheckBox Margin="8,2,8,4"
                                              Content="Enable brim"
                                              FontSize="11"
                                              IsChecked="{Binding Additive.BrimEnabled, Mode=TwoWay}"
                                              ToolTip.Tip="Print offset loops around the first layer to secure the part to the bed. The footprint comes from the actual first-layer toolpath, so X-bracing and pattern bulges are enclosed."/>

                                    <StackPanel IsVisible="{Binding Additive.ShowBrimControls}">
                                        <Grid Margin="8,2,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Direction" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Which side of the path the loops sit on.&#x0a;&#x0a;Offsetting the footprint produces ONE boundary that runs down BOTH sides of the path — out along one side, round the end, and back along the other. Measured on a real open wall it comes to 2.01x the path length. So this does not offset twice; it picks which stretches of that one boundary to keep.&#x0a;&#x0a;Outside: the outer side only. What brim did before this setting existed.&#x0a;&#x0a;Inside: the other side — the concave side of an open wall, or the bore of a closed one.&#x0a;&#x0a;Both: the whole boundary, outer side first so the run crosses over once rather than per loop.&#x0a;&#x0a;Side is measured against the path&apos;s direction of travel, so a run stays on one side for its whole length even where the wall bends both ways. If it picks the side you did not want, switch it. The inside runs out of room and stops on its own once the loops no longer fit."/>
                                            <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                                       ItemsSource="{Binding Additive.BrimDirectionOptions}"
                                                       SelectedItem="{Binding Additive.BrimDirectionDisplay, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="8,2,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Offset loops" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="How many loops to print around the part. More loops = wider skirt = stronger hold."/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.BrimLoops, Mode=TwoWay}"/>
                                        </Grid>
                                        <TextBlock Margin="10,0,10,4" FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                                   Text="Loops are one bead width apart and print before the part, farthest edge first, so the last loop fuses to its first bead. Inward loops work the same way measured from each hole edge. Brim speed is fixed and independent of Adaptive Speed."/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Wave -->
                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wave" VerticalAlignment="Center" Classes="LabelMuted"/>
                                <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                           ItemsSource="{Binding Additive.WaveEffectOptions}"
                                           SelectedItem="{Binding Additive.WaveEffect, Mode=TwoWay}"/>
                            </Grid>

                            <StackPanel IsVisible="{Binding Additive.ShowWaveControls}">
                                <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowSingleAmplitude}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Amplitude (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                               ToolTip.Tip="Peak displacement — how far the path swings left/right of the original line."/>
                                    <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WaveAmplitude}"/>
                                </Grid>

                                <Grid Margin="8,2,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Frequency" VerticalAlignment="Center" Classes="LabelMuted"
                                               ToolTip.Tip="Wavelength: wave density set by mm per cycle. Cycles: fixed number of waves per layer — adapts to perimeter so vases and tapered forms stay visually consistent."/>
                                    <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                               ItemsSource="{Binding Additive.WaveFrequencyModeOptions}"
                                               SelectedItem="{Binding Additive.WaveFrequencyMode, Mode=TwoWay}"/>
                                </Grid>

                                <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowSingleWavelength}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wavelength (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                               ToolTip.Tip="Length of one complete wave cycle along the toolpath."/>
                                    <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WaveWavelength}"/>
                                </Grid>

                                <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowCyclesInput}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cycles per layer" VerticalAlignment="Center" Classes="LabelMuted"
                                               ToolTip.Tip="Number of complete wave cycles per contour. The wave scales with the perimeter so every layer has exactly this many waves."/>
                                    <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WaveCycles}"/>
                                </Grid>

                                <Grid Margin="8,2,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Shape" Classes="LabelMuted" VerticalAlignment="Center"
                                               ToolTip.Tip="1.0 = full waveform. Lower values clip peaks toward a square/trapezoidal wave."/>
                                    <Slider    Grid.Column="1" Minimum="0.01" Maximum="1.0"
                                               Value="{Binding Additive.WaveShape, Mode=TwoWay}"
                                               VerticalAlignment="Center"/>
                                    <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                               Text="{Binding Additive.WaveShape, Mode=TwoWay, StringFormat={}{0:F2}}"
                                               TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="8,2,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Stagger" Classes="LabelMuted" VerticalAlignment="Center"
                                               ToolTip.Tip="Phase offset per layer as a fraction of one cycle. 0 = all layers identical, 0.5 = consecutive layers alternate peak↔valley."/>
                                    <Slider    Grid.Column="1" Minimum="0.0" Maximum="1.0"
                                               Value="{Binding Additive.WaveStagger, Mode=TwoWay}"
                                               VerticalAlignment="Center"/>
                                    <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                               Text="{Binding Additive.WaveStagger, Mode=TwoWay, StringFormat={}{0:F2}}"
                                               TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="8,2,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Phase" Classes="LabelMuted" VerticalAlignment="Center"
                                               ToolTip.Tip="Fixed: each layer's wave counts from its own start point — alignment between layers can drift as the shape changes with height.&#x0a;Dynamic: each layer continues the wave of the layer directly below plus stagger — consistent layer-to-layer alignment across the whole print."/>
                                    <ComboBox Grid.Column="1"
                                              SelectedIndex="{Binding Additive.WavePhaseMethodIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" FontSize="11">
                                        <ComboBoxItem Content="Fixed"/>
                                        <ComboBoxItem Content="Dynamic"/>
                                    </ComboBox>
                                </Grid>

                                <CheckBox Content="Gradient"
                                          IsChecked="{Binding Additive.WaveGradient, Mode=TwoWay}"
                                          Margin="8,4,8,4"
                                          ToolTip.Tip="Interpolate amplitude and wavelength linearly from bottom to top of the toolpath."/>

                                <StackPanel IsVisible="{Binding Additive.ShowWaveGradientControls}">
                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Amplitude (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Peak displacement at the bottom and top of the toolpath."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WaveAmplitudeBottom, Mode=TwoWay}"
                                                   ToolTip.Tip="Bottom (zMin)"/>
                                        <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="LabelMuted"/>
                                        <TextBox   Grid.Column="3" Classes="PanelTextBox" Text="{Binding Additive.WaveAmplitudeTop, Mode=TwoWay}"
                                                   ToolTip.Tip="Top (zMax)"/>
                                    </Grid>

                                    <Grid Margin="8,2,8,4" IsVisible="{Binding Additive.ShowGradientWavelength}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Wavelength (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Wave cycle length at the bottom and top of the toolpath."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.WaveWavelengthBottom, Mode=TwoWay}"
                                                   ToolTip.Tip="Bottom (zMin)"/>
                                        <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="LabelMuted"/>
                                        <TextBox   Grid.Column="3" Classes="PanelTextBox" Text="{Binding Additive.WaveWavelengthTop, Mode=TwoWay}"
                                                   ToolTip.Tip="Top (zMax)"/>
                                    </Grid>

                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Center" Classes="LabelMuted" VerticalAlignment="Center"
                                                   ToolTip.Tip="Shifts the gradient midpoint along the height axis. 0.5 = linear. Lower values compress the gradient toward the bottom; higher values toward the top."/>
                                        <Slider    Grid.Column="1" Minimum="0.001" Maximum="0.999"
                                                   Value="{Binding Additive.WaveGradientCenter, Mode=TwoWay}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                                   Text="{Binding Additive.WaveGradientCenter, Mode=TwoWay, StringFormat={}{0:F2}}"
                                                   TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Curve" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Easing applied to the gradient. Linear = uniform rate. Smooth = slow at both ends. Ease In = slow start. Ease Out = slow finish."/>
                                        <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                                   ItemsSource="{Binding Additive.WaveGradientCurveOptions}"
                                                   SelectedItem="{Binding Additive.WaveGradientCurve, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                            <Expander Classes="SectionExpander" Header="FILL PATTERN" IsExpanded="False">
                        <StackPanel Margin="0,2,0,6">

                            <Grid Margin="8,2,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pattern" VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Replaces shell contours with a continuous infill pattern. None = emit shells as normal."/>
                                <ComboBox  Grid.Column="1" HorizontalAlignment="Stretch"
                                           ItemsSource="{Binding Additive.InfillPatternOptions}"
                                           SelectedItem="{Binding Additive.InfillPattern, Mode=TwoWay}"/>
                            </Grid>

                            <StackPanel IsVisible="{Binding Additive.ShowInfillControls}">

                                <!-- Line-based fills only (Rectilinear/Grid/Triangle/Ghost Mesh):
                                     Formbound patterns are demand-driven and ignore these. -->
                                <StackPanel IsVisible="{Binding Additive.ShowGridControls}">
                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Grid width (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Centre-to-centre distance between fill lines — the grid cell width for Grid / Ghost Mesh Grid. Leave 0 to use the bead width."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.InfillSpacingMm}"/>
                                    </Grid>

                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Angle (°)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Base angle of fill lines in degrees. 0 = parallel to X axis. Grid and Ghost Mesh rotate +90° every layer; Triangle rotates +60° every layer."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.InfillAngleDeg}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Additive.ShowLightningControls}">
                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Max overhang (°)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="How steeply a support finger may grow per layer. Lower = fingers start earlier and grow more vertically."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.LightningOverhangDeg}"/>
                                    </Grid>
                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Branch spacing (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Spacing between support fingers along unsupported edges. 0 = automatic (4× bead width)."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.LightningBranchSpacingMm}"/>
                                    </Grid>
                                    <Grid Margin="8,2,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tip loop radius (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                   ToolTip.Tip="Radius of the support pad loop at each finger tip. 0 = plain one-bead tip."/>
                                        <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.LightningTipLoopRadiusMm}"/>
                                    </Grid>
                                    <TextBlock Margin="8,6,8,2" Text="SUPPORT DOMAINS" Classes="LabelMuted" FontSize="10"
                                               ToolTip.Tip="Choose where Formbound looks for overhangs. Check one or both — each domain has its own tip budget (fingers are not stolen from the other)."/>
                                    <CheckBox Margin="8,2,8,0" FontSize="11" Content="Affect Interior"
                                              IsChecked="{Binding Additive.LightningAffectInterior, Mode=TwoWay}"
                                              ToolTip.Tip="Support inward overhangs, cavities, and inner walls. Fingers root on interior boundaries (notches hidden inside). Own tip budget along unsupported interior edges."/>
                                    <CheckBox Margin="8,2,8,4" FontSize="11" Content="Affect Exterior"
                                              IsChecked="{Binding Additive.LightningAffectExterior, Mode=TwoWay}"
                                              ToolTip.Tip="Support outward flares / free edges outside the part (sacrificial fins — trim after print). Own tip budget, independent of Interior — both can run at once."/>
                                    <CheckBox Margin="8,2,8,4" FontSize="11" Content="Target Support Selections"
                                              IsChecked="{Binding Additive.LightningTargetSupportSelections, Mode=TwoWay}"
                                              ToolTip.Tip="Formbound only near edit-mode Support selections (Apply). Rest of the toolpath stays normal shells — no auto Formbound, no global wall scarring. Without Support paint, Formbound does not run at all."/>
                                    <StackPanel IsVisible="{Binding Additive.ShowButtressControls}">
                                        <Grid Margin="8,2,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Horizontal bar (mm)" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Formbound Buttress: length of the single-bead horizontal support bar under the overhang. The wall cut morphs into this bar as one continuous line."/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Additive.LightningButtressBarMm}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="8,2,8,4" TextWrapping="Wrap"
                                           Classes="LabelMuted" FontSize="10"
                                           IsVisible="{Binding Additive.SurfaceModeActive}"
                                           Text="In Surface mode the fill runs across closed boundary chains; open chains keep their boundary paths."/>

                            </StackPanel>
                        </StackPanel>
                    </Expander>
                        </StackPanel>
                    </Expander>

                    <!-- 4 TOOLPATH -->
                    <Expander Classes="StepCard"
                              IsVisible="{Binding !$parent[Window].DataContext.Viewport.IsPaintEditOpen}"
                              IsExpanded="{Binding StepToolpathExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                    <TextBlock Text="4" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentHover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TOOLPATH" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="8,0,8,6" Spacing="6">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                       IsVisible="{Binding !$parent[Window].DataContext.Viewport.IsScrubSessionActive}"
                                       Text="Slice a model to unlock seam editing, motion smoothing, statistics, and export options."/>

                    <!-- Toolpath options — live once a toolpath exists (scrub session) -->
                    <StackPanel IsVisible="{Binding $parent[Window].DataContext.Viewport.IsScrubSessionActive}">

                    <StackPanel IsVisible="{Binding $parent[Window].DataContext.Viewport.HasToolpathStats}" Margin="0,0,0,8">
                        <TextBlock Text="SLICE STATISTICS" Classes="SectionHeader"/>
                        <Grid Margin="8,2,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Longest layer length" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Cut path length (extrude + mill) for the busiest layer"/>
                            <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                       Text="{Binding $parent[Window].DataContext.Viewport.StatsLongestLayerLength}"/>
                        </Grid>
                        <Grid Margin="8,2,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Shortest layer length" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Cut path length (extrude + mill) for the lightest layer"/>
                            <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                       Text="{Binding $parent[Window].DataContext.Viewport.StatsShortestLayerLength}"/>
                        </Grid>
                        <Grid Margin="8,2,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Longest layer time" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Estimated print time for the slowest layer (all moves)"/>
                            <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                       Text="{Binding $parent[Window].DataContext.Viewport.StatsLongestLayerTime}"/>
                        </Grid>
                        <Grid Margin="8,2,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Shortest layer time" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Estimated print time for the fastest layer (all moves)"/>
                            <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                       Text="{Binding $parent[Window].DataContext.Viewport.StatsShortestLayerTime}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Border1}" Margin="8,4"/>
                    </StackPanel>


                    <Expander Classes="SectionExpander" Header="GLOBAL"
                              IsExpanded="{Binding GlobalSectionExpanded, Mode=TwoWay}">
                        <StackPanel>

                        <TextBlock Text="HOME POSITION" Classes="SectionHeader"/>

                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,4,0"
                                      ItemsSource="{Binding Additive.AvailableHomePositionNames}"
                                      SelectedItem="{Binding Additive.SelectedHomePositionName, Mode=TwoWay}"/>
                            <Button Grid.Column="1"
                                    Content="GO"
                                    Classes="ToolbarButton"
                                    Margin="0,0,4,0"
                                    Command="{Binding Additive.GoToSelectedHomeCommand}"
                                    ToolTip.Tip="Put the viewport robot on this pose so you can confirm it. Does not move the live arm."/>
                            <Button Grid.Column="2"
                                    Content="Set Default"
                                    Classes="ToolbarButton"
                                    Command="{Binding Additive.SetDefaultHomePositionCommand}"
                                    ToolTip.Tip="Save this position as the default for the active cell"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border1}" Margin="8,4"/>

                        <Border Classes="FlashTarget" Classes.flash="{Binding HighlightToolheadOrientation}">
                        <StackPanel>
                        <TextBlock Text="TOOLHEAD GLOBAL ORIENTATION" Classes="SectionHeader"
                                   ToolTip.Tip="Global-axis rotations: R_global = Rz(Z) × Ry(Y) × Rx(X). Default 0,90,0 = nozzle vertical."/>

                        <!-- Y (global Y-axis rotation — Ry(90°) makes nozzle point down) -->
                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Y (°)" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Rotation around the global Y-axis. 90° tilts the nozzle to point straight down."/>
                            <Slider    Grid.Column="1" Minimum="-180" Maximum="180"
                                       Value="{Binding Additive.ToolheadB, Mode=TwoWay}"
                                       VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                       Text="{Binding Additive.ToolheadB, Mode=TwoWay, StringFormat={}{0:F1}}"
                                       TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- X (global X-axis rotation — tilts nozzle side-to-side) -->
                        <Grid Margin="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X (°)" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Rotation around the global X-axis. Tilts the nozzle side-to-side."/>
                            <Slider    Grid.Column="1" Minimum="-180" Maximum="180"
                                       Value="{Binding Additive.ToolheadC, Mode=TwoWay}"
                                       VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                       Text="{Binding Additive.ToolheadC, Mode=TwoWay, StringFormat={}{0:F1}}"
                                       TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Z (global Z-axis rotation — spins tool around vertical axis) -->
                        <Grid Margin="8,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Z (°)" Classes="LabelMuted" VerticalAlignment="Center"
                                       ToolTip.Tip="Rotation around the global Z-axis. Spins the tool frame around the vertical axis (heading/yaw)."/>
                            <Slider    Grid.Column="1" Minimum="-180" Maximum="180"
                                       Value="{Binding Additive.ToolheadA, Mode=TwoWay}"
                                       VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                       Text="{Binding Additive.ToolheadA, Mode=TwoWay, StringFormat={}{0:F1}}"
                                       TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- LFAM 1 linear rail (E1): path tracking within Y+/Y− of home (export-time). -->
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="E1 RAIL MOTION" Classes="SectionHeader"
                                       ToolTip.Tip="When enabled, Export-to-Robot plans E1 so the carriage tracks the toolpath within the Y+/Y− allowance from the home E1. Keeps the arm closer to its sweet spot with tilted toolheads. Only applies on cells with a linear rail (LFAM 1)."/>
                            <CheckBox Content="Enable E1 movement"
                                      IsChecked="{Binding Additive.E1MotionEnabled, Mode=TwoWay}"
                                      Margin="8,2,8,4"
                                      ToolTip.Tip="Samples E1 across Y+/Y− for each point, picks the best reachable carriage pose, re-runs reachability, and drives the rail in scrub/playback simulation. Export writes the planned E1 on every LIN."/>
                            <StackPanel IsVisible="{Binding Additive.ShowE1AllowanceControls}">
                                <Grid Margin="8,0,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Y+ allowance (mm)" Classes="LabelMuted" VerticalAlignment="Center"
                                               ToolTip.Tip="How far E1 may travel in the positive direction from the home E1 (mm)."/>
                                    <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                               Text="{Binding Additive.E1YPlusMm, Mode=TwoWay, StringFormat={}{0:F0}}"
                                               TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                </Grid>
                                <Grid Margin="8,0,8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Y− allowance (mm)" Classes="LabelMuted" VerticalAlignment="Center"
                                               ToolTip.Tip="How far E1 may travel in the negative direction from the home E1 (mm)."/>
                                    <TextBox   Grid.Column="1" Classes="PanelTextBox"
                                               Text="{Binding Additive.E1YMinusMm, Mode=TwoWay, StringFormat={}{0:F0}}"
                                               TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        </StackPanel>
                        </Border>

                        <Border Height="1" Background="{DynamicResource Border1}" Margin="8,4"/>

                        <StackPanel IsVisible="{Binding $parent[Window].DataContext.Viewport.IsMergedToolpathSelected}">
                            <TextBlock Text="MERGED TOOLPATH" Classes="SectionHeader"
                                       ToolTip.Tip="Connector settings between the original toolpath segments"/>

                            <Grid Margin="8,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Retraction height (mm)"
                                           VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Z-hop lift after each segment finishes before traveling to the next"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding $parent[Window].DataContext.Viewport.MergedRetractionHeightMm, Mode=TwoWay}"
                                               Minimum="0" Maximum="200" Increment="1"
                                               FormatString="F1" FontSize="11"/>
                            </Grid>

                            <Grid Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Travel speed (mm/s)"
                                           VerticalAlignment="Center" Classes="LabelMuted"
                                           ToolTip.Tip="Speed for connector moves between merged segments"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding $parent[Window].DataContext.Viewport.MergedTravelSpeed, Mode=TwoWay}"
                                               Minimum="1" Maximum="2000" Increment="10"
                                               FormatString="F0" FontSize="11"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Border1}" Margin="8,4"/>
                        </StackPanel>

                        <TextBlock Text="VISIBILITY" Classes="SectionHeader"/>

                        <CheckBox Content="Show bead"            Margin="12,2,8,2"
                                  IsChecked="{Binding $parent[Window].DataContext.Viewport.ShowBead, Mode=TwoWay}"/>
                        <Grid Margin="30,0,8,2"
                              IsVisible="{Binding $parent[Window].DataContext.Viewport.ShowBead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bead color" VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Live bead colour — updates instantly, no re-slice needed"/>
                            <ColorPicker Grid.Column="1"
                                         Color="{Binding $parent[Window].DataContext.Viewport.BeadPickerColor, Mode=TwoWay}"
                                         IsAlphaEnabled="False" IsAccentColorsVisible="False"/>
                        </Grid>
                        <CheckBox Content="Show extrusion moves" Margin="12,2,8,2"
                                  IsChecked="{Binding $parent[Window].DataContext.Viewport.ShowExtrusionMoves, Mode=TwoWay}"/>
                        <CheckBox Content="Show travel moves"    Margin="12,2,8,2"
                                  IsChecked="{Binding $parent[Window].DataContext.Viewport.ShowTravelMoves, Mode=TwoWay}"/>
                        <CheckBox Content="Show seam"            Margin="12,2,8,6"
                                  IsChecked="{Binding $parent[Window].DataContext.Viewport.ShowSeam, Mode=TwoWay}"/>

                        </StackPanel>
                    </Expander>

                    <Expander Classes="SectionExpander"
                              Header="PRINT TOOLPATH"
                              IsExpanded="False"
                              IsVisible="{Binding $parent[Window].DataContext.Viewport.Lfam3ToolpathShowPrintOptions}">
                        <StackPanel>

                        <TextBlock Text="Pellet extrusion paths. URM uses Caracol T1/T2/T3/RPM; off uses LFAM $ANOUT."
                                   Classes="LabelMuted" Margin="8,0,8,6" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,8,0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="KRL EXPORT" Classes="SectionHeader"
                                       ToolTip.Tip="Values written to the SRC file. URM: T1/T2/T3/RPM globals. Off: $ANOUT channels."/>
                            <Button Grid.Column="1" Classes="ToolbarButton" Padding="6,2"
                                    Click="OnKrlPostProcessClicked"
                                    ToolTip.Tip="Rules, Header and Footer settings — Digital Start/Stop (URM), plus exactly what is written to the SRC: $ADVANCE, $APO.CVEL, $ACC.CP, $VEL.CP, the MAT (T1/T2/T3/RPM) block, and the CaracolSafety interrupts.">
                                <ia:Icon Value="mdi-cog-outline" FontSize="14"/>
                            </Button>
                        </Grid>

                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,Auto,44">
                            <TextBlock Grid.Column="0" Text="Additional temp all zones (°C)"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="T1/T2/T3 export from the MATERIAL setpoints (shown as T1/T2/T3). The +/- box ADDS to every zone: +10 exports each zone 10°C above its material setpoint."/>
                            <TextBlock Grid.Column="1" Margin="4,0,0,0"
                                       Text="{Binding Additive.ExportTemperaturesLabel}"
                                       VerticalAlignment="Center" TextAlignment="Right" Classes="LabelMuted"
                                       ToolTip.Tip="Material setpoints T1/T2/T3 (°C) — the export base before the offset."/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox" Margin="4,0,0,0"
                                       Text="{Binding Additive.TemperatureOffset, Mode=TwoWay}"
                                       PlaceholderText="+/-"
                                       ToolTip.Tip="Additional °C added to ALL zones on top of the material setpoints. +10 = every zone 10° hotter; -10 = cooler. Empty = material setpoints as-is."/>
                        </Grid>

                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,44,44">
                            <TextBlock Grid.Column="0" Text="Extrusion Speed"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Computed from bead width, layer height, print speed, and material flow. Written to $ANOUT[4] at export."/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Additive.ExtrusionSpeedPercent, StringFormat={}{0:F0}%}"
                                       VerticalAlignment="Center" TextAlignment="Right" Classes="LabelMuted"/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox" Margin="4,0,0,0"
                                       Text="{Binding Additive.ExtrusionSpeedOffset, Mode=TwoWay}"
                                       PlaceholderText="+/-"
                                       ToolTip.Tip="Optional ±% adjustment. +10 exports 10 points higher; -10 exports 10 points lower. Leave empty for no change."/>
                        </Grid>

                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,44,44">
                            <TextBlock Grid.Column="0" Text="First layer print speed"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Print speed on layer 0 only. The number is the current first-layer speed (mm/s). +/- is a percent of that speed — +20 exports 1.20×, -20 is 0.80×. Later layers keep the job print speed."/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Additive.FirstLayerSpeedBase, StringFormat={}{0:F0}}"
                                       VerticalAlignment="Center" TextAlignment="Right" Classes="LabelMuted"
                                       ToolTip.Tip="First-layer print speed (mm/s) before this % increase."/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox" Margin="4,0,0,0"
                                       Text="{Binding Additive.FirstLayerPrintSpeedOffset, Mode=TwoWay}"
                                       PlaceholderText="+/-"
                                       ToolTip.Tip="Optional ±% of first-layer print speed. +20 = 20% faster on layer 0 only. Empty = no change."/>
                        </Grid>

                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,44,44">
                            <TextBlock Grid.Column="0" Text="First layer RPM"
                                       VerticalAlignment="Center" Classes="LabelMuted"
                                       ToolTip.Tip="Extrusion RPM on layer 0 only. Same +/- box as Extrusion Speed — +10 exports 10 points higher on the first layer. Later layers keep Extrusion Speed."/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Additive.FirstLayerRpmBase, StringFormat={}{0:F0}%}"
                                       VerticalAlignment="Center" TextAlignment="Right" Classes="LabelMuted"
                                       ToolTip.Tip="First-layer RPM (%) before this +/-."/>
                            <TextBox   Grid.Column="2" Classes="PanelTextBox" Margin="4,0,0,0"
                                       Text="{Binding Additive.FirstLayerRpmOffset, Mode=TwoWay}"
                                       PlaceholderText="+/-"
                                       ToolTip.Tip="Optional ± RPM points on layer 0 only. +10 = ten points higher; -10 = lower. Empty = no change."/>
                        </Grid>

                        </StackPanel>
                    </Expander>

                    <!-- Scan-phase toolpath options -->
                    <Expander Classes="SectionExpander"
                              Header="SCAN TOOLPATH"
                              IsExpanded="False"
                              IsVisible="{Binding $parent[Window].DataContext.Viewport.Lfam3ToolpathShowScanOptions}">
                        <StackPanel>

                        <TextBlock Text="Scanner bed capture and verification moves."
                                   Classes="LabelMuted" Margin="8,0,8,6" TextWrapping="Wrap"/>

                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOOL data index" VerticalAlignment="Center" Classes="LabelMuted"/>
                            <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Scan.ToolDataIndex, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BASE data index" VerticalAlignment="Center" Classes="LabelMuted"/>
                            <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Scan.BaseDataIndex, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Camera IP" VerticalAlignment="Center" Classes="LabelMuted"/>
                            <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Scan.CameraIp, Mode=TwoWay}"/>
                        </Grid>

                        <Button Margin="8,4,8,4"
                                Content="Test Scan Capture"
                                Classes="SecondaryButton"
                                HorizontalAlignment="Stretch"
                                Command="{Binding Scan.TestScanCommand}"
                                ToolTip.Tip="Run a single Zivid capture using the scan toolpath pose"/>

                        <TextBlock Text="{Binding Scan.ScanStatus}"
                                   Classes="LabelMuted"
                                   FontSize="10"
                                   Margin="8,0,8,4"
                                   TextWrapping="Wrap"/>

                        <Button Margin="8,0,8,4"
                                Content="Export Scan KRL"
                                Classes="PrimaryButton"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="Export scanner motion program (uses global home and orientation above)"
                                Command="{Binding $parent[Window].DataContext.Viewport.ExportKrlCommand}"/>

                        </StackPanel>
                    </Expander>

                    <!-- Mill-phase relief milling lives in the SUBTRACTIVE tab (auto-selected on the Mill phase). -->

                    </StackPanel>


                        <!-- TOOL_DATA / BASE_DATA indices come from the LFAM cell settings. -->
                        </StackPanel>
                    </Expander>

                    <!-- 5 MODIFIERS -->
                    <Expander Classes="StepCard"
                              IsExpanded="{Binding StepModifiersExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                    <TextBlock Text="5" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentHover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="MODIFIERS" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="8,0,8,6" Spacing="6">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                       Text="Select a model, then add modifiers to non-destructively cut it into pieces after slicing. Drag a modifier under a mesh in the outliner to link it — order and grouping live there now."/>

                            <TextBlock Text="ADD MODIFIER" Classes="SectionHeader"/>
                            <UniformGrid Columns="6" HorizontalAlignment="Left" Margin="8,0,0,4">
                                <Button Classes="ToolbarButton"
                                        Width="32" Height="32" Padding="0"
                                        IsEnabled="{Binding Modifiers.HasOwner}"
                                        Command="{Binding Modifiers.AddCutModifierCommand}"
                                        ToolTip.Tip="Cut — add a plane that splits this model when applied">
                                    <Grid Width="24" Height="24">
                                        <ia:Icon Value="mdi-cube-outline" FontSize="22"/>
                                        <Line StartPoint="12,2" EndPoint="12,22"
                                              Stroke="{DynamicResource ColorError}" StrokeThickness="1.5"/>
                                        <Line StartPoint="2,12" EndPoint="22,12"
                                              Stroke="{DynamicResource ColorError}" StrokeThickness="1.5"/>
                                    </Grid>
                                </Button>
                            </UniformGrid>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="8,0,8,4"
                                       IsVisible="{Binding !Modifiers.HasOwner}"
                                       Text="Select a model in the outliner first."/>

                            <!-- Selecting a modifier's own Modifiers group in the outliner shows Apply here instead
                                 of settings — it's the whole stack, arms the gizmo for all of them at once. -->
                            <Button Content="▶  APPLY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,2,0,6"
                                    IsVisible="{Binding Modifiers.IsGroupSelected}"
                                    Command="{Binding Modifiers.ApplyCommand}"/>

                            <!-- Selected modifier's settings -->
                            <StackPanel IsVisible="{Binding Modifiers.SelectedSettings, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Spacing="6" Margin="0,6,0,0">
                                <Border Height="1" Background="{DynamicResource Border1}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Modifiers.SelectedSettings.Name, StringFormat='SETTINGS — {0}'}" Classes="SectionHeader"/>

                                <StackPanel IsVisible="{Binding Modifiers.SelectedSettings.IsCutModifier}" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Cut (uncheck for reference-only)" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Modifiers.SelectedSettings.WillCut}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="Orientation" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="1" Content="Horizontal" Margin="0,0,4,0"
                                                      IsChecked="{Binding Modifiers.SelectedSettings.IsHorizontal}"/>
                                        <ToggleButton Grid.Column="2" Content="Vertical"
                                                      IsChecked="{Binding Modifiers.SelectedSettings.IsVertical}"/>
                                    </Grid>

                                    <!-- Always shown (per feedback: don't collapse dependent settings, just gray them out
                                         until they're relevant) — enabled only when Orientation is Vertical. A vertical
                                         plane can face any direction, not just axis-aligned, and spins in place around
                                         wherever the plane currently sits (not bed center — a mesh won't always be
                                         centered on the bed, so orbiting bed center is more confusing than useful). -->
                                    <Grid ColumnDefinitions="*,*,60" IsEnabled="{Binding Modifiers.SelectedSettings.IsVertical}">
                                        <TextBlock Grid.Column="0" Text="Rotation (deg)" Classes="LabelMuted"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   ToolTip.Tip="Double-click the slider to type an exact value. Spins the plane in place — its position doesn't move."/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="360"
                                                Value="{Binding Modifiers.SelectedSettings.RotationDegrees}"
                                                VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="2" Classes="PanelTextBox NumericCommit"
                                                 Text="{Binding Modifiers.SelectedSettings.RotationDegrees, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                 TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,60">
                                        <TextBlock Grid.Column="0" Text="Offset (mm)" Classes="LabelMuted" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   ToolTip.Tip="Horizontal: height above the bed (Z). Vertical: distance from the plane's own position along its current facing direction — not the same axis, since the two orientations cut along different directions. Double-click the slider to type an exact value."/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="3000"
                                                Value="{Binding Modifiers.SelectedSettings.Offset}"
                                                VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="2" Classes="PanelTextBox NumericCommit"
                                                 Text="{Binding Modifiers.SelectedSettings.Offset, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                 TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <!-- Horizontal only — Vertical's Offset is a distance along the plane's own
                                         rotated facing direction, not a height, so "layer" has no meaning there.
                                         Needs the owner mesh to already be sliced (no toolpath = nothing to snap to). -->
                                    <Grid ColumnDefinitions="*,80" IsEnabled="{Binding Modifiers.SelectedSettings.IsHorizontal}">
                                        <TextBlock Grid.Column="0" Text="Layer" Classes="LabelMuted" VerticalAlignment="Center"
                                                   ToolTip.Tip="Snap the cut to a real toolpath layer instead of typing a height — sets the Offset above to that layer's real Z. Needs the model already sliced."/>
                                        <TextBox Grid.Column="1" Classes="PanelTextBox NumericCommit"
                                                 Text="{Binding Modifiers.SelectedSettings.LayerNumber, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Infinite" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Modifiers.SelectedSettings.Infinite}"/>
                                    </Grid>

                                    <!-- Always shown — enabled only when Infinite is off (rectangular restricted extent). -->
                                    <Grid ColumnDefinitions="*,*,60" IsEnabled="{Binding !Modifiers.SelectedSettings.Infinite}">
                                        <TextBlock Grid.Column="0" Text="Size X (mm)" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="3000"
                                                Value="{Binding Modifiers.SelectedSettings.SizeX}"
                                                VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="2" Classes="PanelTextBox NumericCommit"
                                                 Text="{Binding Modifiers.SelectedSettings.SizeX, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                 TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,60" IsEnabled="{Binding !Modifiers.SelectedSettings.Infinite}">
                                        <TextBlock Grid.Column="0" Text="Size Y (mm)" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="3000"
                                                Value="{Binding Modifiers.SelectedSettings.SizeY}"
                                                VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Grid.Column="2" Classes="PanelTextBox NumericCommit"
                                                 Text="{Binding Modifiers.SelectedSettings.SizeY, UpdateSourceTrigger=LostFocus, StringFormat={}{0:F2}}"
                                                 TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Other workflows (tab bar was removed; steps are the panel home) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,10,0,4"
                                IsVisible="{Binding !$parent[Window].DataContext.Viewport.IsPaintEditOpen}">
                        <TextBlock Text="Other workflows:" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <Button Content="SCAN" FontSize="10" Padding="6,2" Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                                IsVisible="{Binding ShowScanTabButton}" Command="{Binding ShowScanCommand}"/>
                        <Button Content="MILLING" FontSize="10" Padding="6,2" Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}" BorderThickness="0"
                                IsVisible="{Binding ShowSubtractiveTabButton}" Command="{Binding ShowSubtractiveCommand}"/>
                    </StackPanel>

                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SCAN tab — same StepCard chrome as ADDITIVE (Printing) -->
            <Grid Grid.Row="1" IsVisible="{Binding IsScanTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">

                        <!-- 1 CAPTURE -->
                        <Expander Classes="StepCard" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                        <TextBlock Text="1" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="CAPTURE" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="10,4,10,6"
                                           Text="Recall scan poses, capture from the Zivid camera, and choose where scans are written."/>

                                <!-- QUICK POSITIONS hidden until MassiveDRIVE joint recall is reliable (LFAM 3).
                                     Keep markup so we can re-show later; ViewModel still works via console. -->
                                <Expander Classes="SectionExpander" Header="QUICK POSITIONS" IsExpanded="False"
                                          IsVisible="False">
                                    <StackPanel Margin="0,2,0,6">
                                        <TextBlock Classes="LabelMuted" Margin="8,4,8,6" TextWrapping="Wrap"
                                                   Text="Recall saved scan poses. Robot must be synced before moving or saving."/>

                                        <ItemsControl ItemsSource="{Binding Scan.QuickPositions}" Margin="8,0,8,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}"
                                                            Classes="PrimaryButton"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,0,0,4"
                                                            Command="{Binding MoveCommand}"
                                                            ToolTip.Tip="Move the robot to this saved position"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Save current pose" Classes="LabelMuted" Margin="8,4,8,2"
                                                   ToolTip.Tip="Captures the synced robot pose ($POS_ACT / $AXIS_ACT) as a new quick position"/>
                                        <Grid Margin="8,0,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Classes="PanelTextBox"
                                                     Text="{Binding Scan.NewQuickPositionName, Mode=TwoWay}"
                                                     PlaceholderText="Position name"/>
                                            <Button Grid.Column="2"
                                                    Content="Save"
                                                    Classes="ToolbarButton"
                                                    Command="{Binding Scan.SaveQuickPositionCommand}"
                                                    ToolTip.Tip="Save the current synced robot pose as a quick position"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Scan.QuickPositionStatus}"
                                                   Classes="LabelMuted" Margin="8,0,8,4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="CAMERA" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6">
                                        <Grid Margin="8,2,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Camera IP" VerticalAlignment="Center" Classes="LabelMuted"
                                                       ToolTip.Tip="Address of the Zivid camera on the cell network"/>
                                            <TextBox   Grid.Column="1" Classes="PanelTextBox" Text="{Binding Scan.CameraIp}"/>
                                        </Grid>

                                        <Button Content="Test Scan"
                                                Classes="PrimaryButton"
                                                HorizontalAlignment="Stretch"
                                                Margin="8,8,8,2"
                                                Command="{Binding Scan.TestScanCommand}"
                                                ToolTip.Tip="Capture a single frame from the Zivid camera and add it to the scene"/>
                                        <TextBlock Text="{Binding Scan.ScanStatus}"
                                                   Classes="LabelMuted" Margin="8,2,8,4" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="OUTPUT" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6">
                                        <TextBlock Text="Scan output directory" Classes="LabelMuted" Margin="8,2,8,2"
                                                   ToolTip.Tip="Captured scans (.zdf / .ply) are written here. Relative paths resolve against the application directory."/>
                                        <TextBox Classes="PanelTextBox" Margin="8,0,8,4" Text="{Binding Scan.OutputDirectory}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <!-- 2 HAND-EYE CALIBRATION -->
                        <Expander Classes="StepCard" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                        <TextBlock Text="2" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="HAND-EYE CALIBRATION" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Classes="LabelMuted" Margin="10,4,10,8" TextWrapping="Wrap"
                                           Text="Place the calibration board on the print bed. Move the robot to several distinct positions and add a pose at each. Aim for ≥ 10 poses with varied orientations."/>

                                <TextBlock Text="{Binding Scan.Calibration.PoseCountLabel}"
                                           Classes="LabelMuted" Margin="10,4,10,2" FontWeight="SemiBold"/>

                                <Button Content="AUTO-CALIBRATE SCAN TOOL"
                                        Classes="PrimaryButton" HorizontalAlignment="Stretch" Margin="10,2,10,2"
                                        Command="{Binding Scan.Calibration.AutoCalibrateCommand}"
                                        ToolTip.Tip="Hand-eye auto-cal. Wrist moves in joint space via MassiveDRIVE MS_CMD=93 (SPTP MS_AXIS). Needs BulkPTP REL 36+. Pendant: AUT, drives ON, path idle. Saves tool #6."/>
                                <TextBlock Text="MassiveDRIVE movement “Scanner Calibration” (notes=scan). Card on bed, BulkPTP running, path idle. Teach poses on Drive — not in SLICER."
                                           Classes="LabelMuted" Margin="10,0,10,4" TextWrapping="Wrap"/>

                                <Grid Margin="10,4,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Add Pose"
                                            Classes="PrimaryButton" HorizontalAlignment="Stretch"
                                            Command="{Binding Scan.Calibration.AddPoseCommand}"
                                            ToolTip.Tip="Capture the calibration board at the current robot pose"/>
                                    <Button Grid.Column="2" Content="Clear All"
                                            Classes="ToolbarButton"
                                            Command="{Binding Scan.Calibration.ClearPosesCommand}"
                                            ToolTip.Tip="Remove all collected poses and reset"/>
                                </Grid>

                                <TextBlock Text="{Binding Scan.Calibration.CaptureStatus}"
                                           Classes="LabelMuted" Margin="10,0,10,4" TextWrapping="Wrap"/>

                                <Border Height="1" Background="{DynamicResource Border1}" Margin="10,4"/>

                                <Button Content="Run Calibration"
                                        Classes="PrimaryButton" HorizontalAlignment="Stretch"
                                        Margin="10,4,10,2"
                                        Command="{Binding Scan.Calibration.CalibrateCommand}"
                                        ToolTip.Tip="Compute hand-eye calibration from collected poses (requires ≥ 3)"/>
                                <TextBlock Text="{Binding Scan.Calibration.CalibrateStatus}"
                                           Classes="LabelMuted" Margin="10,2,10,4" TextWrapping="Wrap"/>

                                <StackPanel IsVisible="{Binding Scan.Calibration.HasResult}" Margin="0,0,0,4">
                                    <Border Height="1" Background="{DynamicResource Border1}" Margin="10,4"/>
                                    <TextBlock Text="RESULT" Classes="SectionHeader"/>

                                    <Grid Margin="10,2,10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Rot residual" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResidualRot, StringFormat={}{0:F3} °}"/>
                                    </Grid>
                                    <Grid Margin="10,2,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Trans residual" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResidualTrans, StringFormat={}{0:F3} mm}"/>
                                    </Grid>

                                    <TextBlock Text="CAMERA TCP OFFSET" Classes="SectionHeader"/>
                                    <Grid Margin="10,2,10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResultX, StringFormat={}{0:F2} mm}"/>
                                    </Grid>
                                    <Grid Margin="10,2,10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Y" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResultY, StringFormat={}{0:F2} mm}"/>
                                    </Grid>
                                    <Grid Margin="10,2,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Z" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResultZ, StringFormat={}{0:F2} mm}"/>
                                    </Grid>

                                    <Grid Margin="10,2,10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="A" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResultA, StringFormat={}{0:F3} °}"/>
                                    </Grid>
                                    <Grid Margin="10,2,10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="B" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResultB, StringFormat={}{0:F3} °}"/>
                                    </Grid>
                                    <Grid Margin="10,2,10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="C" Classes="LabelMuted" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Classes="LabelMuted" VerticalAlignment="Center"
                                                   Text="{Binding Scan.Calibration.ResultC, StringFormat={}{0:F3} °}"/>
                                    </Grid>

                                    <Button Content="{Binding Scan.Calibration.ApplyButtonLabel}"
                                            Classes="PrimaryButton" HorizontalAlignment="Stretch"
                                            Margin="10,4,10,8"
                                            Command="{Binding Scan.Calibration.ApplyToTcpCommand}"
                                            ToolTip.Tip="Write this result into the TCP OFFSET fields for the active tool"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- SUBTRACTIVE (Mill) tab — same StepCard chrome as ADDITIVE (Printing) -->
            <Grid Grid.Row="1" IsVisible="{Binding IsSubtractiveTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,8">

                        <!-- 1 BITS — spindle bit + cutting params + spindle pick/deposit -->
                        <Expander Classes="StepCard"
                                  IsExpanded="{Binding Subtractive.StepBitsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                        <TextBlock Text="1" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="BITS" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="10,4,10,6"
                                           Text="Pick a cutting tool from the library. Open the library to create, edit, or organize bits and cutting-data presets."/>

                                <!-- Cutting tool dropdown + library (CAM-style) -->
                                <Grid Margin="10,0,10,6" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <StackPanel>
                                        <TextBlock Text="Cutting tool" Classes="LabelMuted" FontSize="10" Margin="0,0,0,3"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Subtractive.BitLibrary}"
                                                  SelectedItem="{Binding Subtractive.SelectedBit, Mode=TwoWay}"
                                                  ToolTip.Tip="Active spindle bit from the tool library">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                        <TextBlock Opacity="0.55" FontSize="10"
                                                                   Text="{Binding DiameterMm, StringFormat={}{0:F1} mm}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ToolbarButton"
                                            VerticalAlignment="Bottom" Padding="8,7"
                                            Command="{Binding Subtractive.OpenBitLibraryCommand}"
                                            ToolTip.Tip="Open tool library — manage all bits">
                                        <ia:Icon Value="mdi-bookshelf" FontSize="16"/>
                                    </Button>
                                </Grid>

                                <Grid Margin="10,0,10,8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <StackPanel>
                                        <TextBlock Text="Preset" Classes="LabelMuted" FontSize="10" Margin="0,0,0,3"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Subtractive.CuttingPresets}"
                                                  SelectedItem="{Binding Subtractive.SelectedCuttingPreset, Mode=TwoWay}"
                                                  ToolTip.Tip="Cutting-data preset on the selected bit">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ToolbarButton"
                                            VerticalAlignment="Bottom" Padding="8,7"
                                            Command="{Binding Subtractive.OpenBitLibraryCommand}"
                                            ToolTip.Tip="Edit cutting data in the tool library">
                                        <ia:Icon Value="mdi-tune-variant" FontSize="16"/>
                                    </Button>
                                </Grid>

                                <!-- Geometry summary from the selected bit (toolpathing is step 3) -->
                                <Border Margin="10,0,10,8" Padding="10,8" CornerRadius="6"
                                        Background="{DynamicResource Bg1}"
                                        BorderBrush="{DynamicResource Border1}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock FontSize="10" Opacity="0.7"
                                                       Text="{Binding Subtractive.ToolDiameterMm, StringFormat={}Ø {0:F1} mm}"/>
                                            <TextBlock FontSize="10" Opacity="0.7"
                                                       Text="{Binding Subtractive.SelectedBit.TypeDisplayName, FallbackValue=—}"/>
                                            <TextBlock FontSize="10" Opacity="0.55"
                                                       Text="{Binding Subtractive.SelectedBit.ToolNumber, StringFormat={}Tool #{0}}"/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,120">
                                            <TextBlock Text="Cylinder length" Classes="LabelMuted" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="Stick-out from the disc centre along the SpindleBit face normal. Does not change cutter diameter."/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <NumericUpDown Value="{Binding Subtractive.PreviewCylinderLengthMm, Mode=TwoWay}"
                                                               Minimum="0.5" Maximum="400" Increment="1"
                                                               FormatString="F1" FontSize="11"
                                                               MinHeight="30"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <!-- Same SpindleRpm as TOOLPATHING → MOVEMENT; either side updates both. -->
                                        <Grid ColumnDefinitions="*,120">
                                            <TextBlock Text="Spindle speed" Classes="LabelMuted" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="Linked to Mill → TOOLPATHING → MOVEMENT. Changing either field updates both."/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <NumericUpDown Value="{Binding Subtractive.SpindleRpm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="60000" Increment="1"
                                                               FormatString="F0" FontSize="11"
                                                               MinHeight="30"/>
                                                <TextBlock Grid.Column="1" Text="rpm" Classes="LabelMuted"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Expander Classes="SectionExpander" Header="SPINDLE TOOL CHANGE" IsExpanded="True">
                                    <StackPanel Margin="8,4,8,6" Spacing="6">
                                        <TextBlock Classes="LabelMuted" FontSize="10" TextWrapping="Wrap"
                                                   Text="Mount or return the spindle only (Pick / Deposit). Extruder and scanner tool change stay on their own phases."/>
                                        <local:Lfam3ToolChangePanelView
                                            DataContext="{Binding $parent[Window].DataContext.Viewport.SpindleToolPanel}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <!-- 2 OPERATION — milling strategy catalog -->
                        <Expander Classes="StepCard"
                                  IsExpanded="{Binding Subtractive.StepOperationExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                        <TextBlock Text="2" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="OPERATION" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="10,4,10,6"
                                           Text="AdaOne milling strategies. Geometry, passes, travel, and engagement follow the selected operation. Cutting data comes from the bit library."/>

                                <Border Margin="10,0,10,8" Padding="10,8" CornerRadius="6"
                                        Background="{DynamicResource Bg1}"
                                        BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ia:Icon Value="{Binding Subtractive.SelectedOperationIcon}" FontSize="16"
                                                 Foreground="{DynamicResource AccentHover}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Subtractive.SelectedOperationDisplayName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="8,0,8,4">
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsMultiAxisFinishing}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="MultiAxisFinishing"
                                            ToolTip.Tip="Surface-following finish; tool axis tracks the normal">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-axis-arrow" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Multi-axis finishing" FontSize="9" TextWrapping="Wrap"
                                                       TextAlignment="Center" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsDrilling}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="Drilling"
                                            ToolTip.Tip="Hole / pocket drilling">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-screw-flat-top" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Drilling" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsPlanarFacing}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="PlanarFacing"
                                            ToolTip.Tip="Face a planar region flat">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-arrow-collapse-down" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Planar facing" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsPlanarClearing}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="PlanarClearing"
                                            ToolTip.Tip="2.5D area clear / pocket roughing">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-arrow-expand-all" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Planar clearing" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsCutout}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="Cutout"
                                            ToolTip.Tip="Profile cutout along a closed boundary">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-content-cut" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Cutout" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsContouring}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="Contouring"
                                            ToolTip.Tip="Contour / waterline finish">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-vector-polyline" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Contouring" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsSwarf}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="Swarf"
                                            ToolTip.Tip="Side-of-tool contact on ruled walls">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-rotate-3d-variant" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Swarf" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="PatternTile"
                                            Classes.active="{Binding Subtractive.IsMorph}"
                                            Command="{Binding Subtractive.SetOperationCommand}"
                                            CommandParameter="Morph"
                                            ToolTip.Tip="AdaOne morph — blend top and bottom rails">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <ia:Icon Value="mdi-set-merge" FontSize="18" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Morph" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <TextBlock Margin="10,4,10,8" FontSize="10" Opacity="0.65" TextWrapping="Wrap"
                                           Text="{Binding Subtractive.SelectedOperationDescription}"/>

                                <!-- SELECT AREA — which part of the model this operation machines -->
                                <Expander Classes="SectionExpander" Header="SELECT AREA" IsExpanded="True">
                                    <StackPanel Margin="0,2,0,6" Spacing="6">
                                        <TextBlock Classes="LabelMuted" FontSize="10" TextWrapping="Wrap" Margin="8,2,8,2"
                                                   Text="Soft-brush the machining region on the model (imports/scans only — not robot/bed/cell). Alt erases. Box and Lasso paint only the front surface — they do not select through. Brush size &amp; falloff are on the bottom bar."/>

                                        <UniformGrid Columns="3" Margin="6,0,6,0">
                                            <Button Classes="PatternTile"
                                                    Classes.active="{Binding Subtractive.IsAreaWholeModel}"
                                                    Command="{Binding Subtractive.SetAreaSelectToolCommand}"
                                                    CommandParameter="WholeModel"
                                                    ToolTip.Tip="Machine the entire selected model / stock">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <ia:Icon Value="mdi-cube-outline" FontSize="16" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Whole" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="PatternTile"
                                                    Classes.active="{Binding Subtractive.IsAreaFace}"
                                                    Command="{Binding Subtractive.SetAreaSelectToolCommand}"
                                                    CommandParameter="Face"
                                                    ToolTip.Tip="Click faces on the model in the viewport">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <ia:Icon Value="mdi-vector-triangle" FontSize="16" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Face" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="PatternTile"
                                                    Classes.active="{Binding Subtractive.IsAreaBox}"
                                                    Command="{Binding Subtractive.SetAreaSelectToolCommand}"
                                                    CommandParameter="Box"
                                                    ToolTip.Tip="Drag a rectangular marquee over the model">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <ia:Icon Value="mdi-selection" FontSize="16" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Box" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="PatternTile"
                                                    Classes.active="{Binding Subtractive.IsAreaLasso}"
                                                    Command="{Binding Subtractive.SetAreaSelectToolCommand}"
                                                    CommandParameter="Lasso"
                                                    ToolTip.Tip="Freehand lasso over the model">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <ia:Icon Value="mdi-lasso" FontSize="16" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Lasso" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="PatternTile"
                                                    Classes.active="{Binding Subtractive.IsAreaBrush}"
                                                    Command="{Binding Subtractive.SetAreaSelectToolCommand}"
                                                    CommandParameter="Brush"
                                                    ToolTip.Tip="Brush-paint faces on the model">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <ia:Icon Value="mdi-brush" FontSize="16" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Brush" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="PatternTile"
                                                    Command="{Binding Subtractive.ClearAreaSelectionCommand}"
                                                    ToolTip.Tip="Clear area selection and use the whole model">
                                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                    <ia:Icon Value="mdi-selection-off" FontSize="16" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Clear" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <Border Margin="8,2,8,4" Padding="8,6" CornerRadius="5"
                                                Background="{DynamicResource Bg1}"
                                                BorderBrush="{DynamicResource Border1}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="10" Opacity="0.8" TextWrapping="Wrap"
                                                       Text="{Binding Subtractive.AreaSelectStatus}"/>
                                        </Border>

                                        <Button Margin="8,4,8,6"
                                                Content="Generate Toolpath"
                                                Classes="PrimaryButton"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Mill only the painted SELECT AREA (Box / Lasso / Brush / Face). Switch to Whole model to mill the entire mesh."
                                                Command="{Binding $parent[Window].DataContext.Viewport.GenerateMillFromSettingsCommand}"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="TOOL AXIS"
                                          IsExpanded="True"
                                          IsVisible="{Binding Subtractive.ShowsPlanarToolAxis}">
                                    <StackPanel Margin="0,2,0,6" Spacing="6">
                                        <TextBlock Classes="LabelMuted" FontSize="10" TextWrapping="Wrap" Margin="8,2,8,0"
                                                   Text="T12 +Z (bit into the work). Raster projects from the opposite direction. Default is world -Z. Use Painted area after Box / Face, or Camera view after orbiting the wall."/>
                                        <Grid Margin="8,0,8,0" ColumnDefinitions="*,160">
                                            <TextBlock Text="Axis" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.PlanarToolAxisOptions}"
                                                      SelectedItem="{Binding Subtractive.PlanarToolAxis, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="8,0,8,0" ColumnDefinitions="*,100">
                                            <TextBlock Text="Tilt" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Tilt T12 +Z off the chosen axis (deg)"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.PlanarTiltDeg, Mode=TwoWay}"
                                                               Minimum="-90" Maximum="90" Increment="1" FormatString="F1" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="°" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,0" ColumnDefinitions="*,100">
                                            <TextBlock Text="Azimuth" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Which way the tilt leans around the tool axis (deg)"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.PlanarAzimuthDeg, Mode=TwoWay}"
                                                               Minimum="-180" Maximum="180" Increment="5" FormatString="F1" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="°" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,2,8,0" ColumnDefinitions="*,56,56,56"
                                              IsVisible="{Binding Subtractive.IsPlanarAxisCustom}">
                                            <TextBlock Text="T12 +Z" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Subtractive.PlanarCustomX, Mode=TwoWay}"
                                                           Increment="0.1" FormatString="F2" FontSize="10"/>
                                            <NumericUpDown Grid.Column="2" Value="{Binding Subtractive.PlanarCustomY, Mode=TwoWay}"
                                                           Increment="0.1" FormatString="F2" FontSize="10" Margin="2,0,0,0"/>
                                            <NumericUpDown Grid.Column="3" Value="{Binding Subtractive.PlanarCustomZ, Mode=TwoWay}"
                                                           Increment="0.1" FormatString="F2" FontSize="10" Margin="2,0,0,0"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,2,8,0">
                                            <Button Content="From painted area"
                                                    Command="{Binding Subtractive.CapturePlanarFromPaintCommand}"
                                                    ToolTip.Tip="Average the painted / boxed face and point T12 into it"/>
                                            <Button Content="From camera"
                                                    Command="{Binding Subtractive.CapturePlanarFromCameraCommand}"
                                                    ToolTip.Tip="Point T12 along the current viewport look"/>
                                        </StackPanel>
                                        <Border Margin="8,2,8,4" Padding="8,6" CornerRadius="5"
                                                Background="{DynamicResource Bg1}"
                                                BorderBrush="{DynamicResource Border1}"
                                                BorderThickness="1">
                                            <TextBlock FontSize="10" Opacity="0.85" TextWrapping="Wrap"
                                                       Text="{Binding Subtractive.PlanarAxisStatus}"/>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>

                        <!-- 3 TOOLPATHING — passes / travel / movement (LFAM 3 mill) -->
                        <Expander Classes="StepCard"
                                  IsExpanded="{Binding Subtractive.StepToolpathingExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentMuted}">
                                        <TextBlock Text="3" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentHover}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="TOOLPATHING" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="10,4,10,6"
                                           Text="AdaOne passes, travel, engagement, and motion for the selected operation. Feeds and RPM seed from the active bit preset."/>

                                <Expander Classes="SectionExpander" Header="PASSES" IsExpanded="True">
                                    <StackPanel Margin="0,2,0,6" Spacing="4">
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Offset Distance" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Push the mill path along the surface normal. + mm = cutter out (shallower / leave stock). − mm = into the work."/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.OffsetDistanceMm, Mode=TwoWay}"
                                                               Minimum="-200" Maximum="200" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Number of depth cuts" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding Subtractive.NumberOfDepthCuts, Mode=TwoWay}"
                                                           Minimum="1" Maximum="200" Increment="1" FormatString="F0" FontSize="11"/>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Stepdown" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.StepdownMm, Mode=TwoWay}"
                                                               Minimum="0.05" Maximum="100" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Stepover" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.StepoverMm, Mode=TwoWay}"
                                                               Minimum="0.05" Maximum="100" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,140">
                                            <TextBlock Text="Strategy" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.PassStrategyOptions}"
                                                      SelectedItem="{Binding Subtractive.PassStrategy, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,140">
                                            <TextBlock Text="Cutting direction" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.CuttingDirectionOptions}"
                                                      SelectedItem="{Binding Subtractive.CuttingDirection, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Pass angle" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.PassAngleDeg, Mode=TwoWay}"
                                                               Minimum="-180" Maximum="180" Increment="1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="°" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Stock to leave" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Finish allowance left on the surface (mm)"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.StockToLeaveMm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="20" Increment="0.05" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <CheckBox Margin="8,4,8,2" Content="Keep tool within surface" FontSize="11"
                                                  IsChecked="{Binding Subtractive.KeepToolWithinSurface, Mode=TwoWay}"/>
                                        <CheckBox Margin="8,0,8,2" Content="Clip path" FontSize="11"
                                                  IsChecked="{Binding Subtractive.ClipPath, Mode=TwoWay}"/>
                                        <CheckBox Margin="8,0,8,4" Content="Enable anti gouging" FontSize="11"
                                                  IsChecked="{Binding Subtractive.EnableAntiGouging, Mode=TwoWay}"
                                                  ToolTip.Tip="Uses cutter diameter for inverse-offset anti-gouge when generating paths"/>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsCutoutCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="CUTOUT — closed outline, then step deeper each pass"/>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,140">
                                                <TextBlock Text="Milling direction" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.MillingDirectionOptions}"
                                                          SelectedItem="{Binding Subtractive.CutoutMillingDirection, Mode=TwoWay}"/>
                                            </Grid>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Cut depth" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.CutoutCutDepthMm, Mode=TwoWay}"
                                                                   Minimum="0.05" Maximum="500" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Layer height" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.CutoutLayerHeightMm, Mode=TwoWay}"
                                                                   Minimum="0.05" Maximum="100" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,140">
                                                <TextBlock Text="Orientation" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.CutoutOrientationOptions}"
                                                          SelectedItem="{Binding Subtractive.CutoutOrientationMode, Mode=TwoWay}"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsClearingCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="PLANAR CLEARING — waterfall / all-around / flick ends"/>
                                            <CheckBox Margin="8,0,8,2" Content="Waterfall mill" FontSize="11"
                                                      IsChecked="{Binding Subtractive.WaterfallMill, Mode=TwoWay}"/>
                                            <CheckBox Margin="8,0,8,2" Content="All-around mill" FontSize="11"
                                                      IsChecked="{Binding Subtractive.AllAroundMill, Mode=TwoWay}"/>
                                            <CheckBox Margin="8,0,8,2" Content="Flick ends" FontSize="11"
                                                      IsChecked="{Binding Subtractive.FlickEnds, Mode=TwoWay}"/>
                                            <CheckBox Margin="8,0,8,2" Content="Infill" FontSize="11"
                                                      IsChecked="{Binding Subtractive.ClearingInfill, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsContouringCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="CONTOURING — waterline loops at each Z"/>
                                            <CheckBox Margin="8,0,8,2" Content="Waterfall mill" FontSize="11"
                                                      IsChecked="{Binding Subtractive.ContouringWaterfall, Mode=TwoWay}"/>
                                            <CheckBox Margin="8,0,8,2" Content="Max depth enabled" FontSize="11"
                                                      IsChecked="{Binding Subtractive.ContouringMaxDepthEnabled, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsDrillingCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="DRILLING — plunge / peck, no raster passes"/>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Breakthrough" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.DrillingBreakthroughMm, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="100" Increment="0.5" FormatString="F2" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <CheckBox Margin="8,0,8,2" Content="Peck cycle" FontSize="11"
                                                      IsChecked="{Binding Subtractive.DrillingPeck, Mode=TwoWay}"/>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100"
                                                  IsEnabled="{Binding Subtractive.DrillingPeck}">
                                                <TextBlock Text="Peck depth" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.DrillingPeckDepthMm, Mode=TwoWay}"
                                                                   Minimum="0.05" Maximum="50" Increment="0.5" FormatString="F2" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsSwarfCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="SWARF — side-of-tool contact, lead / lean"/>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Lead" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.SwarfLeadDeg, Mode=TwoWay}"
                                                                   Minimum="-90" Maximum="90" Increment="1" FormatString="F1" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="°" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Lean" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.SwarfLeanDeg, Mode=TwoWay}"
                                                                   Minimum="-90" Maximum="90" Increment="1" FormatString="F1" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="°" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsFinishingCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="MULTI-AXIS FINISHING"/>
                                            <CheckBox Margin="8,0,8,2" Content="Stabilize head rotation" FontSize="11"
                                                      IsChecked="{Binding Subtractive.StabilizeHeadRotation, Mode=TwoWay}"
                                                      ToolTip.Tip="AdaOne smoothLayerOriTransitions — lerp tool ABC along the path"/>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Cut depth" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                    <NumericUpDown Value="{Binding Subtractive.SurfaceFinishingCutDepthMm, Mode=TwoWay}"
                                                                   Minimum="0" Maximum="200" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Subtractive.ShowsMorphCard}" Margin="0,6,0,0" Spacing="4">
                                            <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10"
                                                       Text="MORPH — blend top rail into bottom rail"/>
                                            <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                                <TextBlock Text="Morph steps" Classes="LabelMuted" VerticalAlignment="Center"/>
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding Subtractive.MorphSteps, Mode=TwoWay}"
                                                               Minimum="2" Maximum="200" Increment="1" FormatString="F0" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="TRAVEL AND DISTANCES" IsExpanded="True">
                                    <StackPanel Margin="0,2,0,6" Spacing="4">
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Approach clearance" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.ApproachClearanceMm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="1000" Increment="1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Feed height" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="AdaOne feed height — drop from clearance to this before the cut"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.FeedHeightMm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="500" Increment="1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Retract height" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Safe rapid / retract Z above the reference plane"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.RetractHeightMm, Mode=TwoWay}"
                                                               Minimum="1" Maximum="500" Increment="1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="MOVEMENT" IsExpanded="True">
                                    <StackPanel Margin="0,2,0,6" Spacing="4">
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,110">
                                            <TextBlock Text="Milling speed" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Robot TCP speed while cutting. Independent of print speed."/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.CuttingFeedMmS, Mode=TwoWay}"
                                                               Minimum="0.01" Maximum="500" Increment="0.01" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm/s" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,110">
                                            <TextBlock Text="Travel speed" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Robot TCP speed on mill rapids / travels. Not the print travel speed."/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.TravelSpeedMmS, Mode=TwoWay}"
                                                               Minimum="0.01" Maximum="500" Increment="1" FormatString="F1" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm/s" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,110">
                                            <TextBlock Text="Skim feed rate" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.SkimFeedMmS, Mode=TwoWay}"
                                                               Minimum="0.01" Maximum="500" Increment="0.1" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm/s" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,110">
                                            <TextBlock Text="Spindle speed" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Linked to Mill → BITS. Changing either field updates both."/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.SpindleRpm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="60000" Increment="1" FormatString="F0" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="rpm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,140">
                                            <TextBlock Text="Spindle direction" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.SpindleDirectionOptions}"
                                                      SelectedItem="{Binding Subtractive.SpindleDirection, Mode=TwoWay}"/>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource Border1}" Margin="8,6,8,4"/>
                                        <TextBlock Text="TOOLHEAD GLOBAL ORIENTATION" Classes="SectionHeader"
                                                   ToolTip.Tip="Same Y/X/Z sliders as print. Applied after mill ABC (T12 +Z into the surface). R = Rz(Z) × Ry(Y) × Rx(X)."/>
                                        <Grid Margin="8,0,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Y (°)" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Rotation around Y (KUKA B). Tilts the cutter."/>
                                            <Slider    Grid.Column="1" Minimum="-180" Maximum="180"
                                                       Value="{Binding Subtractive.ToolheadB, Mode=TwoWay}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                                       Text="{Binding Subtractive.ToolheadB, Mode=TwoWay, StringFormat={}{0:F1}}"
                                                       TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="8,4,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="X (°)" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Rotation around X (KUKA C). Tilts the cutter side-to-side."/>
                                            <Slider    Grid.Column="1" Minimum="-180" Maximum="180"
                                                       Value="{Binding Subtractive.ToolheadC, Mode=TwoWay}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                                       Text="{Binding Subtractive.ToolheadC, Mode=TwoWay, StringFormat={}{0:F1}}"
                                                       TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="8,4,8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Z (°)" Classes="LabelMuted" VerticalAlignment="Center"
                                                       ToolTip.Tip="Rotation around Z (KUKA A). Spins the cutter about its axis."/>
                                            <Slider    Grid.Column="1" Minimum="-180" Maximum="180"
                                                       Value="{Binding Subtractive.ToolheadA, Mode=TwoWay}"
                                                       VerticalAlignment="Center"/>
                                            <TextBox   Grid.Column="2" Classes="PanelTextBox"
                                                       Text="{Binding Subtractive.ToolheadA, Mode=TwoWay, StringFormat={}{0:F1}}"
                                                       TextAlignment="Right" Padding="4,2" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="ENGAGEMENT" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6" Spacing="4">
                                        <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10" TextWrapping="Wrap"
                                                   Text="AdaOne milling engagement — lead-in / lead-out at the start and end of each pass."/>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Lead in" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.LeadInMm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="200" Increment="0.5" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="8,0,8,2" ColumnDefinitions="*,100">
                                            <TextBlock Text="Lead out" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                                <NumericUpDown Value="{Binding Subtractive.LeadOutMm, Mode=TwoWay}"
                                                               Minimum="0" Maximum="200" Increment="0.5" FormatString="F2" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="mm" Classes="LabelMuted" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="TOOL COMPENSATION" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6" Spacing="4">
                                        <TextBlock Margin="8,0,8,2" Classes="LabelMuted" FontSize="10" TextWrapping="Wrap"
                                                   Text="AdaOne cutting-tool compensation — offset the programmed path by the cutter radius."/>
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,140">
                                            <TextBlock Text="Compensation" Classes="LabelMuted" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:SubtractiveSettingsViewModel.ToolCompensationOptions}"
                                                      SelectedItem="{Binding Subtractive.ToolCompensation, Mode=TwoWay}"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Button Margin="10,10,10,8"
                                        Content="Generate Toolpath"
                                        Classes="PrimaryButton"
                                        HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Build an AdaOne mill toolpath from the current bit, operation, area selection, and toolpathing settings."
                                        Command="{Binding $parent[Window].DataContext.Viewport.GenerateMillFromSettingsCommand}"/>
                            </StackPanel>
                        </Expander>

                        <!-- Catch-all: leftover mill panels — reorganize into steps later -->
                        <Expander Classes="StepCard"
                                  IsExpanded="{Binding Subtractive.StepMoreExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#2a2a2a">
                                        <ia:Icon Value="mdi-dots-horizontal" FontSize="12"
                                                 Foreground="{DynamicResource TextSecondary}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="MORE" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"
                                               Opacity="0.85"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.55" Margin="10,4,10,6"
                                           Text="Catch-all for stock, surface, placement, and output controls until they move under BITS / OPERATION."/>

                                <Expander Classes="SectionExpander" Header="RELIEF HEIGHTMAP" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6">
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Classes="PanelTextBox" FontSize="11"
                                                     Watermark="grayscale .png / .jpg"
                                                     Text="{Binding Subtractive.HeightmapPath, Mode=TwoWay}"/>
                                            <Button Grid.Column="1" Content="Browse" Margin="4,0,0,0" FontSize="11"
                                                    Classes="ToolbarButton"
                                                    Command="{Binding Subtractive.BrowseHeightmapCommand}"
                                                    ToolTip.Tip="Pick a grayscale relief image (white = high surface)"/>
                                        </Grid>
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="Height scale (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Subtractive.HeightScaleMm, Mode=TwoWay}"
                                                           Minimum="0" Maximum="200" Increment="0.5" FormatString="F1" FontSize="11"/>
                                        </Grid>
                                        <CheckBox Margin="8,0,8,4" Content="Invert (black = high)" FontSize="11"
                                                  IsChecked="{Binding Subtractive.InvertHeightmap, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="DISPLACED SURFACE" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6">
                                        <TextBlock Classes="LabelMuted" Margin="8,0,8,4" TextWrapping="Wrap"
                                                   Text="Pushes the low-poly mesh along its normals by the map above (or the model's normal map if none). This is the surface the mill follows."/>
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="Displacement distance (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Subtractive.DisplacementDistanceMm, Mode=TwoWay}"
                                                           Minimum="0" Maximum="100" Increment="0.25" FormatString="F2" FontSize="11"/>
                                        </Grid>
                                        <Button Margin="8,2,8,4"
                                                Content="Preview Displaced Surface"
                                                Classes="SecondaryButton"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Build and show the detailed surface from the model's maps (the geometry the mill rides)"
                                                Command="{Binding $parent[Window].DataContext.Viewport.PreviewDisplacedCommand}"/>
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,80">
                                            <TextBlock Grid.Column="0" Text="Analysis tolerance (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Subtractive.AnalysisToleranceMm, Mode=TwoWay}"
                                                           Minimum="0.01" Maximum="5" Increment="0.05" FormatString="F2" FontSize="11"/>
                                        </Grid>
                                        <Button Margin="8,0,8,4"
                                                Content="Generate Multi-Axis Toolpath"
                                                Classes="PrimaryButton"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Surface-following finish pass over the displaced surface (tool axis follows the surface normal)"
                                                Command="{Binding $parent[Window].DataContext.Viewport.GenerateMultiAxisCommand}"/>
                                        <Border Margin="8,0,8,6" Padding="6" CornerRadius="5" Background="{DynamicResource Bg1}"
                                                IsVisible="{Binding Subtractive.MillAnalysisText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Subtractive.MillAnalysisText}" Classes="LabelMuted"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="PLACEMENT" IsExpanded="False">
                                    <StackPanel Margin="0,2,0,6">
                                        <CheckBox Margin="8,0,8,4" Content="Reference Z from part top" FontSize="11"
                                                  IsChecked="{Binding Subtractive.AutoReferenceFromTop, Mode=TwoWay}"/>
                                        <Grid Margin="8,0,8,4" ColumnDefinitions="*,80" IsEnabled="{Binding !Subtractive.AutoReferenceFromTop}">
                                            <TextBlock Grid.Column="0" Text="Reference Z (mm)" VerticalAlignment="Center" Classes="LabelMuted"/>
                                            <NumericUpDown Grid.Column="1" Value="{Binding Subtractive.ReferencePlaneZ, Mode=TwoWay}"
                                                           Increment="1" FormatString="F1" FontSize="11"/>
                                        </Grid>
                                        <CheckBox Margin="8,0,8,8" Content="Footprint from part bounds" FontSize="11"
                                                  IsChecked="{Binding Subtractive.AutoFootprint, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Classes="SectionExpander" Header="OUTPUT" IsExpanded="True">
                                    <StackPanel Margin="0,2,0,6" Spacing="4">
                                        <Button Margin="8,4,8,4"
                                                Content="Generate Mill Toolpath"
                                                Classes="PrimaryButton"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Carve the relief into the selected blank (relief milling)"
                                                Command="{Binding $parent[Window].DataContext.Viewport.MillCommand}"/>

                                        <Button Margin="8,0,8,4"
                                                Content="Export Mill KRL"
                                                Classes="PrimaryButton"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Export spindle finish program (uses global home and orientation above)"
                                                Command="{Binding $parent[Window].DataContext.Viewport.ExportKrlCommand}"/>

                                        <ComboBox Margin="8,0,8,4"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding $parent[Window].DataContext.Viewport.SendTargets}"
                                                  SelectedItem="{Binding $parent[Window].DataContext.Viewport.SelectedSendTarget}"
                                                  ToolTip.Tip="Robot (KRL) or MassiveDRIVE (package)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Margin="8,0,8,8"
                                                Content="{Binding $parent[Window].DataContext.Viewport.SendActionLabel}"
                                                Classes="SecondaryButton"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="{Binding $parent[Window].DataContext.Viewport.SendActionTip}"
                                                Command="{Binding $parent[Window].DataContext.Viewport.SendToRobotCommand}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>


        </Grid>
    </Border>

</UserControl>
