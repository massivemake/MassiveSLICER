<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MassiveSlicer.App.Views.StatusBarView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <!-- Faint by default, same as before. Yellow + full opacity when a background
             check finds origin/main has moved past this build's baked-in baseline —
             opacity has to live in the style (not an inline attribute) so the more
             specific .Stale selector can actually override it. -->
        <Style Selector="TextBlock.LabelMuted.BuildLabel">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.LabelMuted.BuildLabel.Stale">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Bg1}"
            BorderBrush="{DynamicResource Border1}"
            BorderThickness="0,1,0,0">
        <Grid Margin="8,0">
            <!-- Left: save-status dot + filename -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Spacing="6">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding SaveStatusDotBrush}"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding SaveStatusTooltip}"/>
                <TextBlock Text="{Binding FileStatus}"
                           VerticalAlignment="Center"
                           Classes="LabelMuted"/>
            </StackPanel>
            <!-- Click copies the build label; SelectableTextBlock also allows manual select + Cmd+C. -->
            <SelectableTextBlock Text="{Binding BuildLabel}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Cursor="Hand"
                                 Classes="LabelMuted BuildLabel"
                                 Classes.Stale="{Binding IsBuildStale}"
                                 ToolTip.Tip="{Binding BuildLabelTooltip}"
                                 Tapped="OnBuildLabelTapped"/>
            <TextBlock Text="{Binding OperationFeedback}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Classes="LabelMuted"/>
        </Grid>
    </Border>

</UserControl>
