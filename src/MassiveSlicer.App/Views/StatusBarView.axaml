<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MassiveSlicer.App.Views.StatusBarView"
             x:CompileBindings="False">

    <UserControl.Styles>
        <!-- Faint by default, same as before. Yellow + full opacity when a background
             check finds origin/main has moved past this build's baked-in baseline —
             opacity has to live in the style (not an inline attribute) so the more
             specific .Stale selector can actually override it. -->
        <Style Selector="TextBlock.LabelMuted.BuildLabel">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.LabelMuted.BuildLabel.Stale">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorWarning}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Bg1}"
            BorderBrush="{DynamicResource Border1}"
            BorderThickness="0,1,0,0">
        <Grid Margin="8,0">
            <!-- Left: save-status dot + filename -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Spacing="6">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding SaveStatusDotBrush}"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding SaveStatusTooltip}"/>
                <TextBlock Text="{Binding FileStatus}"
                           VerticalAlignment="Center"
                           Classes="LabelMuted"/>
            </StackPanel>
            <!--
                The hover target is this padded Border, not the glyphs: a tooltip attached to
                thin centred text flickers as the pointer crosses in and out of the tight text
                bounds. Background="Transparent" is required for the Border to hit-test at all.
                Placement=Top keeps the tooltip off the cursor — the status bar hugs the bottom
                of the screen, so a below-cursor tooltip gets clamped over the pointer and
                oscillates open/closed.
            -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Padding="14,0"
                    Cursor="Hand"
                    ToolTip.Tip="{Binding BuildLabelTooltip}"
                    ToolTip.Placement="Top"
                    ToolTip.VerticalOffset="-6"
                    Tapped="OnBuildLabelTapped">
                <TextBlock Text="{Binding BuildLabel}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Classes="LabelMuted BuildLabel"
                           Classes.Stale="{Binding IsBuildStale}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding OperationFeedback}"
                           VerticalAlignment="Center"
                           Classes="LabelMuted"/>
                <!-- Sits beside the message that asks for it. Above the auto-slice triangle
                     limit nothing re-slices on its own, and the only other way to run one was
                     the console — easy to read a stale toolpath as "the setting did nothing". -->
                <Button Content="Slice now" Padding="10,2" FontSize="11"
                        ToolTip.Tip="Slice the print object now. Always available — above the auto-slice size limit nothing re-slices on its own, and selecting an effector used to disable the only control that could."
                        Command="{Binding $parent[Window].DataContext.Viewport.SliceNowCommand}"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
