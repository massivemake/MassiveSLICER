<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MassiveSlicer.App.Views.StatusBarView"
             x:CompileBindings="False">

    <Border Background="{DynamicResource Bg1}"
            BorderBrush="{DynamicResource Border1}"
            BorderThickness="0,1,0,0">
        <Grid Margin="8,0">
            <!-- Left: save-status dot + filename -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Spacing="6">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding SaveStatusDotBrush}"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding SaveStatusTooltip}"/>
                <TextBlock Text="{Binding FileStatus}"
                           VerticalAlignment="Center"
                           Classes="LabelMuted"/>
            </StackPanel>
            <TextBlock Text="{Binding BuildLabel}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Classes="LabelMuted"
                       Opacity="0.45"/>
            <TextBlock Text="{Binding OperationFeedback}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Classes="LabelMuted"/>
        </Grid>
    </Border>

</UserControl>
