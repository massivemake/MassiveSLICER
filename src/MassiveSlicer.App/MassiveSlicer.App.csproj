<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows uses the OS-specific TFM (icon, WGL GL host); macOS/Linux use the
         cross-platform net8.0 TFM so the app builds and runs natively (incl. arm64). -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFramework>
    <!-- x64 is only required for the Windows-only Occt.NET native libs; off Windows
         build for the host arch (arm64 on Apple Silicon) so STEP import degrades
         gracefully rather than forcing a missing x64 runtime. -->
    <PlatformTarget Condition="$([MSBuild]::IsOSPlatform('Windows'))">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\Icons\icon.ico</ApplicationIcon>
    <!-- COM interop is required for the Windows WGL P/Invoke GL host. Not needed on
         macOS/Linux, but harmless to leave unconditional for a Windows-only project. -->
    <BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
    <RootNamespace>MassiveSlicer.App</RootNamespace>
  </PropertyGroup>

  <!-- Platform-specific GL host: Windows uses the WGL P/Invoke implementation
       (GlHostControl.Windows.cs) to work around an AMD atio6axx driver crash in
       Avalonia's FBO teardown. macOS / Linux use the cross-platform OpenGlControlBase
       approach (GlHostControl.NonWindows.cs) which is safe on those platforms.
       Both files define the same class GlHostControl in the same namespace; only one
       is compiled per target platform. -->
  <ItemGroup>
    <Compile Remove="Views\GlHostControl.Windows.cs" />
    <Compile Remove="Views\GlHostControl.NonWindows.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Views\GlHostControl.Windows.cs" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Compile Include="Views\GlHostControl.NonWindows.cs" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MassiveSlicer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MassiveSlicer.Core\MassiveSlicer.Core.csproj" />
    <ProjectReference Include="..\MassiveSlicer.Viewport\MassiveSlicer.Viewport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical app icon lives in repo assets/Icons (generated from Square44x44Logo PNGs). -->
    <AvaloniaResource Include="..\..\assets\Icons\icon.ico" Link="Assets\icon.ico" />
    <None Include="..\..\assets\Icons\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- macOS Dock icon set at runtime (MacDockIcon) -->
    <None Include="..\..\assets\Icons\macos-app-icon.png" Link="macos-app-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\Workflow\**\*.*" />
    <AvaloniaResource Include="Assets\Fonts\**\*.otf" />
  </ItemGroup>

  <!-- Bed-calibration KRL deployed to the KRC over SMB during AUTO-CALIBRATE. -->
  <ItemGroup>
    <None Include="..\..\assets\krl\*.src" Link="assets\krl\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Cell definitions + GLB/STL geometry (LFAM2/LFAM3 robots, tools, stands, rotary bed). -->
  <ItemGroup>
    <None Include="..\..\assets\cells\**\*.*" Link="assets\cells\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared preset libraries (git-tracked under repo assets/). -->
  <ItemGroup>
    <None Include="..\..\assets\materials.json" Link="assets\materials.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\krl_postprocess.json" Link="assets\krl_postprocess.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- HDR environment backdrops for the viewport BACKDROP selector. -->
  <ItemGroup>
    <None Include="..\..\assets\Images\*.hdr" Link="assets\Images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\Images\*.png" Link="assets\Images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyIjwhostToAppOutput" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)occt\x64\Ijwhost.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)occt\x64\Ijwhost.dll')" />
  </Target>

  <Target Name="CopyOcctToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_OcctNative Include="$(OutputPath)occt\x64\**\*.*" Condition="Exists('$(OutputPath)occt\x64')" />
    </ItemGroup>
    <Copy SourceFiles="@(_OcctNative)" DestinationFiles="@(_OcctNative -> '$(PublishDir)occt\x64\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@( _OcctNative)' != ''" />
    <Copy SourceFiles="$(OutputPath)Ijwhost.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)Ijwhost.dll')" />
  </Target>

  <!-- macOS: assemble a .app bundle after publish so the app carries icon.icns in the Dock/Finder.
       (macOS uses .icns, not the .ico; the .icns is generated from the same icon artwork.)
       Runs only for osx-* publishes. Produces MassiveSlicer.app next to the publish output. -->
  <Target Name="CreateMacAppBundle" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <!-- A dedicated subfolder avoids a case-insensitive collision with the apphost
         executable "MassiveSlicer.App" that lives beside the publish output on macOS. -->
    <PropertyGroup>
      <MacAppBundle>$([System.IO.Path]::GetFullPath('$(PublishDir)../macos-app'))/MassiveSlicer.app</MacAppBundle>
    </PropertyGroup>
    <RemoveDir Directories="$(MacAppBundle)" />
    <MakeDir Directories="$(MacAppBundle)/Contents/MacOS;$(MacAppBundle)/Contents/Resources" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/macOS/Info.plist" DestinationFiles="$(MacAppBundle)/Contents/Info.plist" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../assets/Icons/icon.icns" DestinationFiles="$(MacAppBundle)/Contents/Resources/icon.icns" />
    <ItemGroup>
      <_PublishedFiles Include="$(PublishDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedFiles)" DestinationFiles="@(_PublishedFiles->'$(MacAppBundle)/Contents/MacOS/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec Command="chmod +x '$(MacAppBundle)/Contents/MacOS/MassiveSlicer.App'" Condition="Exists('$(MacAppBundle)/Contents/MacOS/MassiveSlicer.App')" />
    <Message Importance="high" Text="macOS app bundle created: $(MacAppBundle) (icon: icon.icns)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.0.4" />
    <!-- Occt.NET (Open CASCADE) is Windows-only; STEP import lives in the Viewport project. -->
    <PackageReference Include="Occt.NET" Version="7.9.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="Optris.Icons.Avalonia" Version="12.0.6" />
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.6" />
    <PackageReference Include="SMBLibrary" Version="1.5.7" />
  </ItemGroup>


  <!-- Auto-generated build identity: baseline = origin/main's commit count (same on every
       machine once pushed), delta = commits on HEAD not yet on origin/main (a feature branch's
       save points, or unpushed commits sitting directly on main), branch = current branch name,
       sha = exact code state. On main with nothing unpushed, the label is just the baseline
       number, same as always; anywhere else a suffix count is appended — "b" for a feature
       branch's save points, "c" for local commits waiting on main. Replaces the old hand-edited
       BuildInfo.cs. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBranchName"/>
      <Output TaskParameter="ExitCode" PropertyName="GitBranchExit"/>
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShortSha"/>
      <Output TaskParameter="ExitCode" PropertyName="GitShaExit"/>
    </Exec>
    <Exec Command="git rev-list --count origin/main" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBaselineCount"/>
      <Output TaskParameter="ExitCode" PropertyName="GitBaselineExit"/>
    </Exec>
    <Exec Command="git rev-list --count origin/main..HEAD" ConsoleToMSBuild="true"
          ContinueOnError="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDeltaCount"/>
      <Output TaskParameter="ExitCode" PropertyName="GitDeltaExit"/>
    </Exec>
    <!--
      Defensive, not just "was it empty": when git isn't resolvable at all (e.g. a shortcut/.bat
      launched from Explorer with a stale PATH that doesn't include git — exit 9009, "command not
      recognized"), ConsoleOutput ends up holding cmd's own error text, not an empty string. A
      naive "== ''" check misses that entirely and bakes the error message straight into the
      generated .cs file as a "constant", breaking the build with cascading parser errors instead
      of just falling back to a placeholder build label. Require the actual expected SHAPE of each
      value (all-digits / no whitespace, matching the exact pattern for that field) in addition to
      the exit code and emptiness checks. GitBaselineCount/GitDeltaCount fall back to 0 the same
      way if origin/main isn't resolvable at all (e.g. a fresh clone with no fetch yet).
    -->
    <PropertyGroup>
      <GitBranchName Condition="'$(GitBranchExit)' != '0' or '$(GitBranchName)' == '' or $([System.Text.RegularExpressions.Regex]::IsMatch('$(GitBranchName)', '\s'))">unknown</GitBranchName>
      <GitShortSha Condition="'$(GitShaExit)' != '0' or '$(GitShortSha)' == '' or $([System.Text.RegularExpressions.Regex]::IsMatch('$(GitShortSha)', '\s'))">dev</GitShortSha>
      <GitBaselineCount Condition="'$(GitBaselineExit)' != '0' or '$(GitBaselineCount)' == '' or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(GitBaselineCount)', '^\d+$'))">0</GitBaselineCount>
      <GitDeltaCount Condition="'$(GitDeltaExit)' != '0' or '$(GitDeltaCount)' == '' or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(GitDeltaCount)', '^\d+$'))">0</GitDeltaCount>
      <BuildDateStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd'))</BuildDateStamp>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>

      <GitIsMain>false</GitIsMain>
      <GitIsMain Condition="'$(GitBranchName)' == 'main'">true</GitIsMain>

      <GitSuffixChar>b</GitSuffixChar>
      <GitSuffixChar Condition="'$(GitIsMain)' == 'true'">c</GitSuffixChar>

      <!-- On main with nothing unpushed, the label is just the baseline number — same as
           today. Everywhere else (a branch, or main with local unpushed commits), append
           the suffix count. -->
      <GitShowSuffix>true</GitShowSuffix>
      <GitShowSuffix Condition="'$(GitIsMain)' == 'true' and '$(GitDeltaCount)' == '0'">false</GitShowSuffix>

      <GitLabelCore>$(GitBaselineCount)</GitLabelCore>
      <GitLabelCore Condition="'$(GitShowSuffix)' == 'true'">$(GitBaselineCount)$(GitSuffixChar)$(GitDeltaCount)</GitLabelCore>
    </PropertyGroup>
    <ItemGroup>
      <BuildInfoLine Include="// &lt;auto-generated /&gt; — GenerateBuildInfo target (MassiveSlicer.App.csproj). Do not edit."/>
      <BuildInfoLine Include="namespace MassiveSlicer.App%3B"/>
      <BuildInfoLine Include="public static class BuildInfo"/>
      <BuildInfoLine Include="{"/>
      <BuildInfoLine Include="    /// &lt;summary&gt;origin/main's commit count at build time — the baseline this build sits on.&lt;/summary&gt;"/>
      <BuildInfoLine Include="    public const int Baseline = $(GitBaselineCount)%3B"/>
      <BuildInfoLine Include="    /// &lt;summary&gt;Commits on HEAD not yet on origin/main — save points on a branch, or unpushed commits on main.&lt;/summary&gt;"/>
      <BuildInfoLine Include="    public const int Delta = $(GitDeltaCount)%3B"/>
      <BuildInfoLine Include="    public const string Branch = &quot;$(GitBranchName)&quot;%3B"/>
      <BuildInfoLine Include="    public const bool IsMain = $(GitIsMain)%3B"/>
      <BuildInfoLine Include="    public const string CommitSha = &quot;$(GitShortSha)&quot;%3B"/>
      <BuildInfoLine Include="    public const string BuildDate = &quot;$(BuildDateStamp)&quot;%3B"/>
      <BuildInfoLine Include="    public static readonly string Label = &quot;$(GitLabelCore)  ·  $(BuildDateStamp)  ·  $(GitShortSha)&quot;%3B"/>
      <BuildInfoLine Include="}"/>
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true"/>
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" Condition="'@(Compile->AnyHaveMetadataValue('Identity','$(BuildInfoFile)'))' != 'true'"/>
      <FileWrites Include="$(BuildInfoFile)"/>
    </ItemGroup>
  </Target>

</Project>
