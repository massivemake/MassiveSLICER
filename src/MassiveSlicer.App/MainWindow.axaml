<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MassiveSlicer.ViewModels"
        xmlns:views="clr-namespace:MassiveSlicer.App.Views"
        x:Class="MassiveSlicer.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Title="MassiveSlicer"
        Icon="avares://MassiveSlicer.App/Assets/icon.ico"
        Height="900" Width="1440"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource Bg0}">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding Toolbar.UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding Toolbar.RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding Toolbar.RedoCommand}"/>
    </Window.KeyBindings>

    <!--
        Root layout: full-bleed viewport with floating chrome.
          Row 0 — Work area: the 3D viewport fills the window; the left/right
                  panels float over it as rounded cards; the toolbar is a
                  ghosted overlay that fades in when the pointer nears the top.
          Row 1 — Bottom dock (status + optional console), full width
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="WorkAreaGrid" Grid.Row="0">

            <!-- Viewport — fills the entire work area; floating cards render above it -->
            <views:ViewportView x:Name="Viewport"
                                DataContext="{Binding Viewport}"/>

            <!-- Ghosted sidebar cards: translucent until hovered, then fade to full. -->
            <Grid.Styles>
                <Style Selector="Border.GhostCard">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.GhostCard:pointerover">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Grid.Styles>

            <!-- Left floating panel: cell / import / outliner -->
            <Border x:Name="LeftPanelCard"
                    Classes="GhostCard"
                    HorizontalAlignment="Left"
                    Width="300"
                    Margin="10,56,0,10"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Background="{DynamicResource Bg2}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    ZIndex="5">
                <views:LeftPanelView x:Name="LeftPanelControl" DataContext="{Binding LeftPanel}"/>
            </Border>

            <!-- Right floating panel: numbered workflow steps -->
            <Border x:Name="RightPanelCard"
                    Classes="GhostCard"
                    HorizontalAlignment="Right"
                    Width="300"
                    Margin="0,56,10,10"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Background="{DynamicResource Bg2}"
                    BorderBrush="{DynamicResource Border1}"
                    BorderThickness="1"
                    ZIndex="5">
                <views:RightPanelView x:Name="RightPanel" DataContext="{Binding RightPanel}"/>
            </Border>

            <!-- Toolbar — constant slight translucency (background set in ToolbarView) -->
            <Border x:Name="ToolbarHost"
                    VerticalAlignment="Top"
                    Height="48"
                    ZIndex="10">
                <views:ToolbarView DataContext="{Binding Toolbar}"/>
            </Border>
        </Grid>

        <!-- ── Bottom dock: full width under all panels ─────────────────── -->
        <views:BottomLeftDockView Grid.Row="1"
                                  DataContext="{Binding}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"/>

    </Grid>

</Window>