<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFramework>
    <PlatformTarget Condition="$([MSBuild]::IsOSPlatform('Windows'))">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <!-- Occt.NET (Open CASCADE) is Windows-only; the STEP test self-skips off Windows. -->
    <PackageReference Include="Occt.NET" Version="7.9.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- Drives real pointer input at the transform number boxes. Their click behaviour was
         guessed at twice and fixed neither time, because nothing could actually observe a
         click: the console bridge cannot reach the Avalonia overlay layer. Test-only. -->
    <!-- Deliberately NOT Avalonia.Headless.XUnit: it depends on xunit.v3, which collides with
         this project's xunit 2.5.3 and fails every other test in the suite with CS0433. The
         session is driven by hand instead — see TransformNumberBoxClickTest. -->
    <PackageReference Include="Avalonia.Headless" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="CopyIjwhostToTestOutput" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)occt\x64\Ijwhost.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)occt\x64\Ijwhost.dll')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MassiveSlicer.App\MassiveSlicer.App.csproj" />
    <ProjectReference Include="..\MassiveSlicer.Core\MassiveSlicer.Core.csproj" />
    <ProjectReference Include="..\MassiveSlicer.Viewport\MassiveSlicer.Viewport.csproj" />
  </ItemGroup>

</Project>
